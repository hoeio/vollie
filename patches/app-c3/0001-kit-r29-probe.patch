+  Future<void> c3Probe() async {
+    if (isBusy || optimizing != null || researching) return;
+    if (Research.deepSleep.value == null) {
+      kitNote = 'c3 probe: choose the session label (deep-sleeping list on or off) first.';
+      _kitChanged();
+      return;
+    }
+    if ((await DeviceProfile.battery()).plugged) {
+      kitNote = 'c3 probe: unplug the charger first.';
+      _kitChanged();
+      return;
+    }
+    researching = true;
+    kitNote = null;
+    _stopTest = false;
+    await DeviceProfile.keepScreenOn(true);
+    final started = DateTime.now();
+    final unloaded = _loadedPath?.split('/').last;
+    if (_loadedPath != null) await unload();
+    const ch = MethodChannel('vollie/downloads');
+    final st = Map<String, Object?>.from(await ch.invokeMethod<Map>('kitStorage') ?? const {});
+    final dir = '${st['internal']}/kit-models';
+    try {
+      Directory(dir).createSync(recursive: true);
+    } catch (_) {}
+    final p0 = await DeviceProfile.powerState();
+    final label = Research.powerLabel(p0);
+    final b0 = await DeviceProfile.battery();
+    final blocks = <Map<String, Object?>>[];
+    try {
+      for (final blk in Research.c3Blocks) {
+        if (_stopTest) break;
+        final g0 = DateTime.now();
+        final series = <List<num?>>[];
+        var timeout = true;
+        while (!_stopTest) {
+          final h = (await DeviceProfile.thermal()).headroom;
+          final ms = DateTime.now().difference(g0).inMilliseconds;
+          series.add([ms, h == null ? null : (h * 1000).round() / 1000]);
+          if (h != null && h < Assistant.coolHeadroom) {
+            timeout = false;
+            break;
+          }
+          if (ms >= Research.gateWait.inMilliseconds) break;
+          _researchStatus('${label == 'power-save on' ? 'POWER SAVING IS ON · ' : ''}c3 probe · $blk · cooling: headroom '
+              '${h == null ? '?' : (h * 100).round()}% (gate ${(Assistant.coolHeadroom * 100).round()}%), ${ms ~/ 1000} s');
+          await Future<void>.delayed(Research.gatePoll);
+        }
+        _researchStatus('c3 probe · $blk running (do not touch the phone)');
+        final pw = await DeviceProfile.powerState();
+        final bt = await DeviceProfile.battery();
+        setNativeEnv('VOLLIE_PROBE', '1');
+        final t0 = DateTime.now();
+        final r = await Isolate.run(() => DeviceProfile.c3Probe(blk, dir));
+        unsetNativeEnv('VOLLIE_PROBE');
+        blocks.add({
+          'block': blk, 'gate': {'below': Assistant.coolHeadroom, 'timeout': timeout, 'series': series},
+          'power_before': pw, 'battery_c_before': bt.tempC, 'plugged_before': bt.plugged,
+          'ms': DateTime.now().difference(t0).inMilliseconds, 'battery_c_after': (await DeviceProfile.battery()).tempC, ...r,
+        });
+      }
+    } finally {
+      unsetNativeEnv('VOLLIE_PROBE');
+      final report = <String, Object?>{
+        'kind': 'c3_probe', 'kit': Research.kit, 'app': Research.app, 'started': started.toIso8601String(),
+        'finished': DateTime.now().toIso8601String(), 'stopped_early': _stopTest,
+        'session_label': Research.sessionLabel, 'deep_sleeping_list': Research.deepSleep.value,
+        'power_start': p0, 'label': label, 'power_end': await DeviceProfile.powerState(),
+        'battery_c_start': b0.tempC, 'plugged_start': b0.plugged, 'model_unloaded': unloaded,
+        'kernel_release': DeviceProfile.unameRelease(), 'probe_dir': dir,
+        'free_start': st['internalFree'],
+        'design': 'campaign 3 memo-02 §6 with the lead\'s six fixes: blocks ${Research.c3Blocks.join(' ')}; r16 gate before '
+            'each block; each P2 / X1 / X2 cell 1 s warm-up + 2 s measured; P1 steps 2.7 3.0 3.4 4.2 4.6 GB, 20 passes or '
+            '45 s per arm, PROT_READ then PROT_EXEC',
+        'blocks': blocks,
+      };
+      final js = jsonEncode(report);
+      await _prefs.setString(Research.c3ProbeKey, js);
+      try {
+        File('$dir/c3probe-${Research.kit}-${started.toIso8601String().replaceAll(':', '').substring(0, 15)}.json')
+            .writeAsStringSync(js);
+      } catch (_) {}
+      await DeviceProfile.keepScreenOn(false);
+      researching = false;
+      optimizing = null;
+      kitNote = 'c3 probe done ($label, ${Research.sessionLabel}). Save it to Downloads and send the file.';
+      _kitChanged();
+    }
+  }
