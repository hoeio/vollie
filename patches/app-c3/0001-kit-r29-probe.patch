+  /// Kit r29 (c3 0001-probe): runs one probe block of the runtime (llama_vollie_probe; off unless VOLLIE_PROBE is set) and
+  /// returns rc (bytes, -1 = off, -2 = unknown block), the c3-probe lines, and the call's milliseconds. Blocks for
+  /// seconds to minutes: call it from an isolate.
+  static Map<String, Object?> c3Probe(String block, String dir) {
+    final t0 = DateTime.now();
+    const cap = 1 << 18;
+    Pointer<Uint8> b = nullptr, d = nullptr, out = nullptr;
+    try {
+      final f = DynamicLibrary.open('libllama.so').lookupFunction<Int32 Function(Pointer<Uint8>, Pointer<Uint8>, Pointer<Uint8>, IntPtr),
+          int Function(Pointer<Uint8>, Pointer<Uint8>, Pointer<Uint8>, int)>('llama_vollie_probe');
+      b = _cString(block);
+      d = _cString(dir);
+      out = _malloc!(cap);
+      out.value = 0;
+      final rc = f(b, d, out, cap);
+      final text = rc > 0 ? String.fromCharCodes(out.asTypedList(rc)) : '';
+      return {'rc': rc, 'lines': [for (final l in text.split('\n')) if (l.isNotEmpty) l], 'native_ms': DateTime.now().difference(t0).inMilliseconds};
+    } catch (e) {
+      return {'error': '$e', 'native_ms': DateTime.now().difference(t0).inMilliseconds};
+    } finally {
+      if (b != nullptr) _free!(b);
+      if (d != nullptr) _free!(d);
+      if (out != nullptr) _free!(out);
+    }
+  }
