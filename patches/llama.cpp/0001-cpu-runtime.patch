+    const uintptr_t e = ((uintptr_t) p + n + page - 1) & ~(page - 1);
+    madvise((void *) b, e - b, advice);
+#else
+    GGML_UNUSED(p); GGML_UNUSED(n); GGML_UNUSED(advice);
+#endif
+}
