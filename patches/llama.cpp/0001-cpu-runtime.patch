+// Writes the two "cpu-bench q3k" lines (K 1,536 x 512 rows, K 512 x 1,536 rows) to stderr; 1 thread (the caller's).
+void ggml_cpu_q3k_bench(int cpu) {
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    char line[512];
+    int m0 = ggml_q3k_bench_mhz(cpu);
+    if (ggml_q3k_bench_shape(1536, 512, line, sizeof line)) { int m1 = ggml_q3k_bench_mhz(cpu); fprintf(stderr, "%s cpu=%d mhz=%d/%d\n", line, cpu, m0, m1); m0 = m1; }
+    if (ggml_q3k_bench_shape(512, 1536, line, sizeof line)) fprintf(stderr, "%s cpu=%d mhz=%d/%d\n", line, cpu, m0, ggml_q3k_bench_mhz(cpu));
+#else
+    fprintf(stderr, "cpu-bench q3k unsupported (needs arm64 dotprod) cpu=%d\n", cpu);
+#endif
+    fflush(stderr);
+}
