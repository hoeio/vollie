+    if ((ggml_cpu_expert_io & 4) && ids->ne[1] == 1 && n_as <= 64) {
+        const uint64_t guess = ggml_cpu_pred_take(cgraph->nodes[node_n]->src[0]->data);
+        if (guess) {
+            for (int64_t e = 0; e < n_as; e++) {
