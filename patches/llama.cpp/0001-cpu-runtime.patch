+        for (;; b--) {
+            int64_t n = 0;
+            for (int t = 0; t < nth; t++) {
+                n += hist[t*4096 + b];
+            }
+            if (above + n >= M || b == 0) {
+                break;
+            }
+            above += n;
+        }
+        int64_t ka = 0, kb = 0; // this thread's offsets: rows above b, rows in b, of the threads before it
+        for (int t = 0; t < ith; t++) {
+            for (int64_t i = b + 1; i < 4096; i++) {
+                ka += hist[t*4096 + i];
+            }
+            kb += hist[t*4096 + b];
+        }
+        int32_t * idx = ggml_cpu_head2_idx + c*M;
