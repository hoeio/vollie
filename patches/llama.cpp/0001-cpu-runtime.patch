+// Called by thread 0 at the end of each graph: no job may outlive the weights it reads.
+static void ggml_cpu_pred_drain(void) {
+    while (atomic_load(&ggml_cpu_pred_tail) != atomic_load(&ggml_cpu_pred_head)) {
+        sched_yield();
+    }
