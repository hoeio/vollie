+// At a prompt's start (calling thread): empty the counters, note the knobs.
+static void ggml_c2_thr_reset(void) {
+    memset(ggml_c2_thr, 0, sizeof ggml_c2_thr);
+    memset(ggml_c2_thr_pool, 0, sizeof ggml_c2_thr_pool);
+    const char * m = getenv("VOLLIE_CPUMASK"), * p = getenv("VOLLIE_POOL");
+    snprintf(ggml_c2_thr_mask, sizeof ggml_c2_thr_mask, "%s", m && *m ? m : "-");
+    ggml_c2_thr_on = p && atoi(p) == 1;
+}
+
+// VOLLIE_CPUMASK into ggml_c2_pool_want (parsed again only when the string changes).
+static void ggml_c2_pool_masks(const char * s) {
+    s = s ? s : "";
+    if (strcmp(s, ggml_c2_pool_mask_s) == 0) {
+        return;
+    }
+    snprintf(ggml_c2_pool_mask_s, sizeof ggml_c2_pool_mask_s, "%s", s);
+    unsigned long long last = 0;
+    const char * p = s;
+    for (int i = 0; i < GGML_C2_THR; i++) {
+        if (*p) {
+            char * e;
+            const unsigned long long v = strtoull(p, &e, 16);
+            if (e == p) {
+                p = "";
+            } else {
+                last = v;
+                p = *e == ',' ? e + 1 : e;
+            }
+        }
+        ggml_c2_pool_want[i] = last;
+    }
+}
