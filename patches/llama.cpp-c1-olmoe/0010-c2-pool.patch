+// Vollie c2 (patches/llama.cpp-c1-olmoe/0010-c2-pool.patch, bit-identical: placement only, same nth and chunking).
+// VOLLIE_POOL=1: graphs that bring no threadpool (llama.cpp without llama_attach_threadpool, as in the app) run on one
+// persistent pool (poll 0: the workers sleep between graphs) instead of creating and joining n-1 threads per graph; a
+// larger thread count recreates it; a busy pool (another graph running) falls back to a disposable one.
+// VOLLIE_CPUMASK=<hex>[,<hex>...] (with VOLLIE_POOL=1 only): the CPU mask of thread i (0 = the calling thread); the last
+// entry repeats ("0xf0" = every thread on cpus 4-7). Each thread compares its affinity (sched_getaffinity) with its mask
+// at every graph start and sets it when it differs, so the mask holds whichever thread calls ggml (memo-28 §2.1: the
+// app's Dart thread changes after an idle wait). Linux only; elsewhere the mask is ignored. The calling thread keeps the
+// mask after the graph.
+// With GGML_C2_IO=1, per prompt, one "c2-pool" line (graphs per phase, graphs on the pool, and per thread index: last
+// tid, affinity seen at the last graph start, mask sets and failures, a histogram of sched_getcpu at graph starts as
+// c<cpu>=<graphs>, cpu 15 = 15 and above) and,
+// with VOLLIE_SCHED=1, one "c2-sched" line per phase (per thread index: µs on the CPU and µs waiting in the run queue
+// from /proc/thread-self/schedstat, voluntary and involuntary context switches from getrusage(RUSAGE_THREAD), summed
+// over the phase's graphs, graph start to the last barrier; n = graphs with a schedstat reading).
+#if defined(__linux__)
+#include <fcntl.h>
+#include <sched.h>
+#include <sys/syscall.h>
+#endif
+#define GGML_C2_THR 16
+struct ggml_c2_thr_ph { int graphs, sets, errs, ss; int64_t ex_us, wq_us, nv, ni; int cpu[16]; };
+static struct { int tid; unsigned long long aff; struct ggml_c2_thr_ph ph[2]; } ggml_c2_thr[GGML_C2_THR];
+static int  ggml_c2_thr_pool[2];          // graphs of this prompt on the persistent pool (prefill, decode)
+static int  ggml_c2_thr_n;                // threads of the prompt's last graph
+static char ggml_c2_thr_mask[128] = "-"; // VOLLIE_CPUMASK at the prompt's start
+static int  ggml_c2_thr_on;               // VOLLIE_POOL=1 at the prompt's start
+static unsigned long long ggml_c2_pool_want[GGML_C2_THR]; // parsed VOLLIE_CPUMASK (0 = leave the thread's affinity)
+static char ggml_c2_pool_mask_s[128] = "";
+static struct ggml_threadpool * ggml_c2_pool = NULL;
+static int  ggml_c2_sched = 0;            // VOLLIE_SCHED=1
+struct ggml_c2_thr_t0 { int ph; int64_t ex, wq, nv, ni; };
+
+static void ggml_c2_thr_sample(struct ggml_c2_thr_t0 * t) {
+    t->ex = t->wq = t->nv = t->ni = -1;
+#if defined(__linux__)
+    char b[96];
+    const int fd = open("/proc/thread-self/schedstat", O_RDONLY);
+    if (fd >= 0) {
+        const ssize_t n = read(fd, b, sizeof b - 1);
+        long long a, w;
+        if (n > 0 && (b[n] = 0, sscanf(b, "%lld %lld", &a, &w) == 2)) {
+            t->ex = a / 1000;
+            t->wq = w / 1000;
+        }
+        close(fd);
+    }
+    struct rusage ru;
+    if (getrusage(RUSAGE_THREAD, &ru) == 0) {
+        t->nv = ru.ru_nvcsw;
+        t->ni = ru.ru_nivcsw;
+    }
+#endif
+}
+
+// Every thread at its graph start: the mask (pool graphs) and the counters (GGML_C2_IO=1).
+static void ggml_c2_thr_begin(int ith, bool pool, struct ggml_c2_thr_t0 * t) {
+    t->ph = -1;
+    const int ph = ggml_cpu_c2io.state - 1; // 0 prefill, 1 decode, -1 no prompt open (counters off)
+    if (ith >= GGML_C2_THR || (ph < 0 && !pool)) {
+        return;
+    }
+    int set = 0, err = 0, cpu = -1;
+    unsigned long long aff = 0;
+#if defined(__linux__)
+    cpu_set_t cs;
+    CPU_ZERO(&cs);
+    if (sched_getaffinity(0, sizeof cs, &cs) == 0) {
+        for (int c = 0; c < 64; c++) {
+            if (CPU_ISSET(c, &cs)) aff |= 1ull << c;
+        }
+    }
+    const unsigned long long want = pool ? ggml_c2_pool_want[ith] : 0;
+    if (want && aff != want) {
+        CPU_ZERO(&cs);
+        for (int c = 0; c < 64; c++) {
+            if (want >> c & 1) CPU_SET(c, &cs);
+        }
+        if (sched_setaffinity(0, sizeof cs, &cs) == 0) {
+            aff = want;
+            set = 1;
+        } else {
+            err = 1;
+        }
+    }
+    cpu = sched_getcpu();
+#endif
+    if (ph < 0) {
+        return;
+    }
+#if defined(__linux__)
+    ggml_c2_thr[ith].tid = (int) syscall(SYS_gettid);
+#endif
+    ggml_c2_thr[ith].aff = aff;
+    struct ggml_c2_thr_ph * p = &ggml_c2_thr[ith].ph[ph];
+    p->graphs++;
+    p->sets += set;
+    p->errs += err;
+    if (cpu >= 0) {
+        p->cpu[cpu < 15 ? cpu : 15]++;
+    }
+    if (ggml_c2_sched) {
+        t->ph = ph;
+        ggml_c2_thr_sample(t);
+    }
+}
+
+// Every thread before the graph's last barrier (so thread 0 reads finished counters).
+static void ggml_c2_thr_end(int ith, const struct ggml_c2_thr_t0 * t) {
+    if (t->ph < 0) {
+        return;
+    }
+    struct ggml_c2_thr_t0 e;
+    ggml_c2_thr_sample(&e);
+    struct ggml_c2_thr_ph * p = &ggml_c2_thr[ith].ph[t->ph];
+    if (t->ex >= 0 && e.ex >= 0) {
+        p->ss++;
+        p->ex_us += e.ex - t->ex;
+        p->wq_us += e.wq - t->wq;
+    }
+    if (t->nv >= 0 && e.nv >= 0) {
+        p->nv += e.nv - t->nv;
+        p->ni += e.ni - t->ni;
+    }
+}
