+static void ggml_c2_thr_flush(const char * run) {
+    char line[2048];
+    const int nt = ggml_c2_thr_n < GGML_C2_THR ? ggml_c2_thr_n : GGML_C2_THR;
+    int len = snprintf(line, sizeof line, "c2-pool run=%s pool=%d mask=%s threads=%d graphs=%d/%d pool_graphs=%d/%d", run,
+                       ggml_c2_thr_on, ggml_c2_thr_mask, ggml_c2_thr_n, ggml_c2_thr[0].ph[0].graphs, ggml_c2_thr[0].ph[1].graphs,
+                       ggml_c2_thr_pool[0], ggml_c2_thr_pool[1]);
+    for (int i = 0; i < nt && len < (int) sizeof line - 160; i++) {
+        const struct ggml_c2_thr_ph * a = &ggml_c2_thr[i].ph[0], * b = &ggml_c2_thr[i].ph[1];
+        len += snprintf(line + len, sizeof line - len, " w%d=%d:0x%llx:s%d:e%d:", i, ggml_c2_thr[i].tid, ggml_c2_thr[i].aff,
+                        a->sets + b->sets, a->errs + b->errs);
+        for (int c = 0, k = 0; c < 16 && len < (int) sizeof line - 16; c++) {
+            if (a->cpu[c] + b->cpu[c]) {
+                len += snprintf(line + len, sizeof line - len, "%sc%d=%d", k++ ? "," : "", c, a->cpu[c] + b->cpu[c]);
+            }
+        }
+    }
+    fprintf(stderr, "%s\n", line);
+    for (int ph = 0; ph < 2 && ggml_c2_sched; ph++) {
+        len = snprintf(line, sizeof line, "c2-sched run=%s phase=%s n=%d", run, ph ? "decode" : "prefill", ggml_c2_thr[0].ph[ph].ss);
+        for (int i = 0; i < nt && len < (int) sizeof line - 96; i++) {
+            const struct ggml_c2_thr_ph * p = &ggml_c2_thr[i].ph[ph];
+            len += snprintf(line + len, sizeof line - len, " w%d=%lld:%lld:%lld:%lld", i, (long long) p->ex_us,
+                            (long long) p->wq_us, (long long) p->nv, (long long) p->ni);
+        }
+        fprintf(stderr, "%s\n", line);
+    }
+}
