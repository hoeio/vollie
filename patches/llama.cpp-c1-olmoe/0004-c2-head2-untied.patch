+// One 8-row group of a repacked Q6_K tensor (nb block_q6_Kx8) back into 8 plain rows of nb block_q6_K (the inverse of
+// make_block_q6_Kx8).
+extern "C" void ggml_c2_head2_q6k_unpack8(const void * grp, int64_t nb, int il, void * rows);
+extern "C" void ggml_c2_head2_q6k_unpack8(const void * grp, int64_t nb, int il, void * rows) {
+    const block_q6_Kx8 * g = (const block_q6_Kx8 *) grp;
+    block_q6_K * r = (block_q6_K *) rows;
+    const int end_ls = QK_K * 4 / il;
+    for (int64_t x = 0; x < nb; x++) {
+        for (int i = 0; i < 8; i++) {
+            r[i*nb + x].d = g[x].d[i];
+            for (int j = 0; j < QK_K/16; j++) {
+                r[i*nb + x].scales[j] = g[x].scales[j*8 + i];
+            }
+        }
+        for (int i = 0; i < end_ls; i++) {
+            memcpy(&r[(i % 8)*nb + x].ql[(i / 8)*il], &g[x].ql[i*il], il);
+        }
+        for (int i = 0; i < end_ls/2; i++) {
+            memcpy(&r[(i % 8)*nb + x].qh[(i / 8)*il], &g[x].qh[i*il], il);
+        }
+    }
+}
