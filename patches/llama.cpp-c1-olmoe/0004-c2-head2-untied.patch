+// ---- Vollie c2 (patches/llama.cpp-c1-olmoe/0004, from patches/llama.cpp-c2/0009): Q6_K helpers for ggml_c2_head2 in ggml-cpu.c. Read-only
+// on the weights; nothing here runs unless VOLLIE_HEAD2 is set.
+
+// The layout of a Q6_K head: 0 = plain rows (no extra), 4 / 8 = this module's q6_K_8x4 / q6_K_8x8 repack, -1 = anything
+// else (another extra buffer type): the caller keeps the stock path.
+extern "C" int ggml_c2_head2_q6k_il(const struct ggml_tensor * t);
+extern "C" int ggml_c2_head2_q6k_il(const struct ggml_tensor * t) {
+    if (t->type != GGML_TYPE_Q6_K) {
+        return -1;
+    }
+    if (t->extra == NULL) {
+        return t->buffer && t->buffer->buft == ggml_backend_cpu_repack_buffer_type() ? -1 : 0;
+    }
+    if (!t->buffer || t->buffer->buft != ggml_backend_cpu_repack_buffer_type() || t->extra != ggml_repack_get_optimal_repack_type(t)) {
+        return -1;
+    }
+    // the same choice ggml_repack_get_optimal_repack_type made for Q6_K
+    return ggml_cpu_has_neon() && ggml_cpu_has_matmul_int8() ? 8 : ggml_cpu_has_neon() && ggml_cpu_has_dotprod() ? 4 : -1;
+}
