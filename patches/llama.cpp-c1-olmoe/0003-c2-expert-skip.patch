+// eb: bytes of one expert of this op (a fused gate + up: both weights); nops: 1, or 2 for a fused op (pairs count per op)
+static void ggml_c2_skip_count(const struct ggml_tensor * node, const struct ggml_tensor * ids, double eb, int nops) {
+    const int n_ids = ids->ne[0];
+    const int64_t n_tok = ids->ne[1], n_as = node->src[0]->ne[2];
+    if (n_as > 512) {
+        return;
+    }
+    uint8_t routed[512] = {0}, kept[512] = {0};
+    unsigned long long n_skip = 0;
+    for (int64_t t = 0; t < n_tok; t++) {
+        for (int s = 0; s < n_ids; s++) {
+            const int32_t a = *(const int32_t *) ((const char *) ids->data + t*ids->nb[1] + s*ids->nb[0]);
+            const bool sk = ggml_cpu_skip_mask_tl[t*n_ids + s];
+            n_skip += sk;
+            if (a >= 0 && a < n_as) {
+                routed[a] = 1;
+                kept[a] |= !sk;
+            }
+        }
+    }
+    if (!ggml_c2_st_first) {
+        ggml_c2_st_first = node->src[0];
+    }
+    if (node->src[0] == ggml_c2_st_first) {
+        ggml_c2_st_tok += n_tok; // one such op per layer and token: tokens counted on the first one seen
+    }
+    ggml_c2_st_pairs      += (unsigned long long) nops*n_ids*n_tok;
+    ggml_c2_st_pairs_skip += nops*n_skip;
+    ggml_c2_st_bytes      += eb*n_ids*n_tok;
+    ggml_c2_st_bytes_skip += eb*n_skip;
+    for (int64_t a = 0; a < n_as; a++) {
+        if (routed[a]) {
+            ggml_c2_st_bytes_read += eb;
+            if (!kept[a]) {
+                ggml_c2_st_bytes_unread += eb;
+            }
+        }
+    }
+}
