+// ---- Vollie c2 (patches/llama.cpp-c2/0008): kit interface. Everything here runs on the calling thread before the
+// workers start (ggml_c2_kit_begin) or after they finish (ggml_c2_kit_end), except ggml_c2_prof_add (thread 0, in the
+// loop). Nothing changes a result: knobs keep their meaning, lines and counters are side effects.
+//  - every knob is read per graph (0001's skip knobs included; they were latched once per process);
+//  - prompt boundary: the first graph, a graph of more than one token after a one-token graph, or a change of
+//    VOLLIE_RUN (an id the app may set per run). At a boundary the per-prompt counter lines of the prompt that ended
+//    are printed (c2-skip-run with VOLLIE_SKIP_STATS=1, c2-graph-run with VOLLIE_GRAPH_STATS=1), the prompt number
+//    goes up and the token count restarts; decode graph t = 1, 2, ... of a prompt is a one-token graph;
+//  - VOLLIE_PROF=1: one cpu-prof line per one-token graph;
+//  - VOLLIE_AB=knob:<NAME>:<A>:<B>: one-token graph t runs side A for t <= VOLLIE_AB_WARM (default 16), then blocks of
+//    VOLLIE_AB_BLOCK (default 8) graphs in the order A B B A (VOLLIE_AB_BAAB=1: B A A B); prompt graphs run A;
+//  - lines go through ggml's log callback at INFO level (what llama_log_set installs), VOLLIE_LINES=stderr writes them
+//    to stderr directly. The exit lines of 0001 / 0002 (c2-skip:, c2-graph:) stay on stderr for the host tools.
+static bool    ggml_c2_prof_graph = false;   // this graph is profiled (VOLLIE_PROF=1 and one token)
+static int64_t ggml_c2_pf_comp[GGML_OP_COUNT], ggml_c2_pf_wait[GGML_OP_COUNT], ggml_c2_pf_cnt[GGML_OP_COUNT];
+static int64_t ggml_c2_pf_head, ggml_c2_pf_router, ggml_c2_pf_mm, ggml_c2_pf_mmid, ggml_c2_pf_attn, ggml_c2_pf_other, ggml_c2_pf_waitall;
+static bool    ggml_c2_lines_stderr = false;
+static char    ggml_c2_run[33] = "-";        // VOLLIE_RUN of the prompt being counted
+static int64_t ggml_c2_prompt = 0, ggml_c2_tok = 0;
+static bool    ggml_c2_seen = false, ggml_c2_last_one = false;
+static long    ggml_c2_flt0[2];               // majflt, minflt at this graph's start (profiled graphs)
+static int     ggml_c2_ab_knob = -1;          // index into ggml_c2_ab_names, -1 = no A/B
+static int64_t ggml_c2_ab_val[2];
+static int     ggml_c2_ab_warm = 16, ggml_c2_ab_block = 8, ggml_c2_ab_blk = 0;
+static bool    ggml_c2_ab_baab = false;
+static char    ggml_c2_ab_side = '-';
+static const char * const ggml_c2_ab_names[] = { "TINY_OP", "Q3K_X4", "MMID_NB", "MMID_FUSE", "EXPERT_IO", "SAMPLER_BYPASS",
+                                                 "SKIP_SUM", "SKIP_MAX", "SKIP_MASS", "HEAD2" };
+// snapshots for the per-prompt and per-graph differences
+static unsigned long long ggml_c2_sk0_tok, ggml_c2_sk0_pairs, ggml_c2_sk0_skip, ggml_c2_skg_pairs, ggml_c2_skg_skip;
+static double  ggml_c2_sk0_bytes, ggml_c2_sk0_bskip, ggml_c2_sk0_read, ggml_c2_sk0_unread;
+static int64_t ggml_c2_gs0[6];
+static void ggml_c2_head2_knobs(void); // 0009 hooks (empty below until 0009)
+static void ggml_c2_head2_ab(int64_t v);
+static void ggml_c2_head2_flush(const char * run, int64_t prompt);
+
+static void ggml_c2_line(const char * fmt, ...) {
+    char buf[2048];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof buf, fmt, ap);
+    va_end(ap);
+    if (ggml_c2_lines_stderr) {
+        fprintf(stderr, "%s\n", buf);
+        fflush(stderr);
+    } else {
+        GGML_LOG_INFO("%s\n", buf);
+    }
+}
+
+static void ggml_c2_faults(long f[2]) {
+#if !defined(_WIN32)
+    struct rusage ru;
+    if (getrusage(RUSAGE_SELF, &ru) == 0) {
+        f[0] = ru.ru_majflt;
+        f[1] = ru.ru_minflt;
+        return;
+    }
+#endif
+    f[0] = f[1] = 0;
+}
+
+static int ggml_c2_mhz(int cpu) { // current clock of one core in MHz, 0 where sysfs has none
+#if defined(__linux__)
+    char path[96];
+    snprintf(path, sizeof path, "/sys/devices/system/cpu/cpu%d/cpufreq/scaling_cur_freq", cpu);
+    FILE * f = fopen(path, "r");
+    long khz = 0;
+    if (f) {
+        if (fscanf(f, "%ld", &khz) != 1) {
+            khz = 0;
+        }
+        fclose(f);
+    }
+    return (int) (khz / 1000);
+#else
+    GGML_UNUSED(cpu);
+    return 0;
+#endif
+}
+
+// 0 = A, 1 = B for one-token graph t of a prompt (t <= warm: A, blk 0); the same rule as llama-sampler.cpp's
+static int ggml_c2_ab_side_of(int64_t t, int * blk) {
+    if (t <= ggml_c2_ab_warm) {
+        *blk = 0;
+        return 0;
+    }
+    const int64_t k = (t - ggml_c2_ab_warm - 1) / ggml_c2_ab_block;
+    *blk = (int) k + 1;
+    return (k % 4 == 1 || k % 4 == 2) != ggml_c2_ab_baab;
+}
+
+static void ggml_c2_flush(void) { // the counters of the prompt that just ended
+    if (ggml_c2_st_tok > ggml_c2_sk0_tok && getenv("VOLLIE_SKIP_STATS") && atoi(getenv("VOLLIE_SKIP_STATS")) == 1) {
+        const double tok = (double) (ggml_c2_st_tok - ggml_c2_sk0_tok);
+        const double pairs = (double) (ggml_c2_st_pairs - ggml_c2_sk0_pairs), bytes = ggml_c2_st_bytes - ggml_c2_sk0_bytes;
+        const double read = ggml_c2_st_bytes_read - ggml_c2_sk0_read;
+        ggml_c2_line("c2-skip-run: run=%s prompt=%lld tokens=%.0f pairs=%.0f pairs_skipped=%.4f%% expert_bytes_skipped=%.4f%% "
+                     "MB_per_token_selected=%.3f MB_per_token_skipped=%.3f batch_bytes_unread=%.4f%%",
+                     ggml_c2_run, (long long) ggml_c2_prompt, tok, pairs,
+                     100.0*(double) (ggml_c2_st_pairs_skip - ggml_c2_sk0_skip)/(pairs > 0 ? pairs : 1),
+                     100.0*(ggml_c2_st_bytes_skip - ggml_c2_sk0_bskip)/(bytes > 0 ? bytes : 1),
+                     bytes/tok/1e6, (ggml_c2_st_bytes_skip - ggml_c2_sk0_bskip)/tok/1e6,
+                     100.0*(ggml_c2_st_bytes_unread - ggml_c2_sk0_unread)/(read > 0 ? read : 1));
+    }
+    ggml_c2_sk0_tok = ggml_c2_st_tok; ggml_c2_sk0_pairs = ggml_c2_st_pairs; ggml_c2_sk0_skip = ggml_c2_st_pairs_skip;
+    ggml_c2_sk0_bytes = ggml_c2_st_bytes; ggml_c2_sk0_bskip = ggml_c2_st_bytes_skip;
+    ggml_c2_sk0_read = ggml_c2_st_bytes_read; ggml_c2_sk0_unread = ggml_c2_st_bytes_unread;
+    const int64_t gs[6] = { ggml_c2_g_graphs, ggml_c2_g_nodes, ggml_c2_g_ops, ggml_c2_g_tiny, ggml_c2_g_barriers, ggml_c2_g_syncs };
+    if (gs[0] > ggml_c2_gs0[0] && ggml_c2_gstats) {
+        const double g = (double) (gs[0] - ggml_c2_gs0[0]);
+        ggml_c2_line("c2-graph-run: run=%s prompt=%lld one_token_graphs=%.0f nodes=%.1f ops_run=%.1f ops_tiny=%.1f barriers=%.1f syncs=%.1f",
+                     ggml_c2_run, (long long) ggml_c2_prompt, g, (gs[1] - ggml_c2_gs0[1])/g, (gs[2] - ggml_c2_gs0[2])/g,
+                     (gs[3] - ggml_c2_gs0[3])/g, (gs[4] - ggml_c2_gs0[4])/g, (gs[5] - ggml_c2_gs0[5])/g);
+    }
+    memcpy(ggml_c2_gs0, gs, sizeof gs);
+    ggml_c2_head2_flush(ggml_c2_run, ggml_c2_prompt);
+}
+
+// Returns the graph's start time (µs) for the profile line.
+static int64_t ggml_c2_kit_begin(const struct ggml_cgraph * cgraph) {
+    const int64_t t_start = ggml_time_us();
+    const char * e;
+    // 0001's knobs, now per graph
+    ggml_c2_skip_sum  = ggml_c2_env("VOLLIE_SKIP_SUM");
+    ggml_c2_skip_max  = ggml_c2_env("VOLLIE_SKIP_MAX");
+    ggml_c2_skip_mass = ggml_c2_env("VOLLIE_SKIP_MASS");
+    e = getenv("VOLLIE_SKIP_MINK");
+    ggml_c2_skip_mink = e && atoi(e) > 1 ? atoi(e) : 1; // the top slot is always kept
+    static bool skip_exit = false;
+    if (!skip_exit && ggml_c2_env("VOLLIE_SKIP_STATS") > 0) {
+        skip_exit = true;
+        atexit(ggml_c2_skip_report);
+    }
+    ggml_c2_head2_knobs();
+    e = getenv("VOLLIE_LINES");
+    ggml_c2_lines_stderr = e && strcmp(e, "stderr") == 0;
+    // A/B
+    ggml_c2_ab_knob = -1;
+    e = getenv("VOLLIE_AB");
+    if (e && *e) {
+        char name[24];
+        long long a, b;
+        if (sscanf(e, "knob:%23[A-Z0-9_]:%lld:%lld", name, &a, &b) == 3) {
+            for (int i = 0; i < (int) (sizeof ggml_c2_ab_names/sizeof ggml_c2_ab_names[0]); i++) {
+                if (strcmp(name, ggml_c2_ab_names[i]) == 0) {
+                    ggml_c2_ab_knob = i;
+                    ggml_c2_ab_val[0] = a;
+                    ggml_c2_ab_val[1] = b;
+                }
+            }
+        }
+        static bool warned = false;
+        if (ggml_c2_ab_knob < 0 && !warned) {
+            warned = true;
+            ggml_c2_line("c2-ab: error=unknown_or_malformed value=%.60s", e);
+        }
+        ggml_c2_ab_warm  = (e = getenv("VOLLIE_AB_WARM"))  && *e ? MAX(0, atoi(e)) : 16;
+        ggml_c2_ab_block = (e = getenv("VOLLIE_AB_BLOCK")) && *e ? MAX(1, atoi(e)) : 8;
+        ggml_c2_ab_baab  = (e = getenv("VOLLIE_AB_BAAB"))  && atoi(e) == 1;
+    }
+    // prompt boundary
+    char run[33] = "-";
+    if ((e = getenv("VOLLIE_RUN")) && *e) {
+        int n = 0;
+        for (; e[n] && n < 32; n++) {
+            const char c = e[n];
+            run[n] = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' ? c : '_';
+        }
+        run[n] = 0;
+    }
+    const bool one = cgraph->n_nodes > 0 && cgraph->nodes[0]->ne[1] == 1;
+    if (!ggml_c2_seen || strcmp(run, ggml_c2_run) != 0 || (!one && ggml_c2_last_one)) {
+        if (ggml_c2_seen) {
+            ggml_c2_flush();
+        }
+        ggml_c2_prompt++;
+        ggml_c2_tok = 0;
+        snprintf(ggml_c2_run, sizeof ggml_c2_run, "%s", run);
+        if (ggml_c2_ab_knob >= 0) {
+            ggml_c2_line("c2-ab: run=%s prompt=%lld knob=%s a=%lld b=%lld warm=%d block=%d order=%s", ggml_c2_run,
+                         (long long) ggml_c2_prompt, ggml_c2_ab_names[ggml_c2_ab_knob], (long long) ggml_c2_ab_val[0],
+                         (long long) ggml_c2_ab_val[1], ggml_c2_ab_warm, ggml_c2_ab_block, ggml_c2_ab_baab ? "BAAB" : "ABBA");
+        }
+    }
+    ggml_c2_seen = true;
+    ggml_c2_last_one = one;
+    if (one) {
+        ggml_c2_tok++;
+    }
+    // the A/B side of this graph overrides the env value of its knob (prompt graphs: side A)
+    ggml_c2_ab_side = '-';
+    ggml_c2_ab_blk  = 0;
+    if (ggml_c2_ab_knob >= 0) {
+        const int side = one ? ggml_c2_ab_side_of(ggml_c2_tok, &ggml_c2_ab_blk) : 0;
+        const int64_t v = ggml_c2_ab_val[side];
+        ggml_c2_ab_side = side ? 'B' : 'A';
+        switch (ggml_c2_ab_knob) {
+            case 0: ggml_c2_tiny = v; break;
+            case 1: ggml_c2_q3k_x4 = v == 1 || v == 2 ? (int) v : 0; break;
+            case 2: ggml_c2_mmid_nb = v == 1; break;
+            case 3: ggml_c2_mmid_fuse = v == 1; break;
+            case 4: ggml_c2_expert_io = v == 1; break;
+            case 5: break; // SAMPLER_BYPASS: libllama reads VOLLIE_AB itself
+            case 6: ggml_c2_skip_sum  = (float) v; break;
+            case 7: ggml_c2_skip_max  = (float) v; break;
+            case 8: ggml_c2_skip_mass = (float) v; break;
+            case 9: ggml_c2_head2_ab(v); break;
+        }
+    }
+    // profile
+    e = getenv("VOLLIE_PROF");
+    ggml_c2_prof_graph = one && e && atoi(e) == 1;
+    ggml_c2_gcount = ggml_c2_gstats || ggml_c2_prof_graph;
+    if (ggml_c2_prof_graph) {
+        memset(ggml_c2_pf_comp, 0, sizeof ggml_c2_pf_comp);
+        memset(ggml_c2_pf_wait, 0, sizeof ggml_c2_pf_wait);
+        memset(ggml_c2_pf_cnt,  0, sizeof ggml_c2_pf_cnt);
+        ggml_c2_pf_head = ggml_c2_pf_router = ggml_c2_pf_mm = ggml_c2_pf_mmid = ggml_c2_pf_attn = ggml_c2_pf_other = ggml_c2_pf_waitall = 0;
+        ggml_c2_faults(ggml_c2_flt0);
+        ggml_c2_skg_pairs = ggml_c2_st_pairs;
+        ggml_c2_skg_skip  = ggml_c2_st_pairs_skip;
+    }
+    return t_start;
+}
+
+// thread 0: node (the first of a fused group) computed from t0 to t1, past its barrier at t2
+static void ggml_c2_prof_add(const struct ggml_tensor * node, int64_t t0, int64_t t1, int64_t t2) {
+    const int64_t c = t1 - t0;
+    ggml_c2_pf_comp[node->op] += c;
+    ggml_c2_pf_wait[node->op] += t2 - t1;
+    ggml_c2_pf_cnt[node->op]++;
+    ggml_c2_pf_waitall += t2 - t1;
+    const char * w = node->src[0] ? node->src[0]->name : "";
+    switch (node->op) {
+        case GGML_OP_MUL_MAT:
+            if (strcmp(w, "output.weight") == 0 || strcmp(w, "token_embd.weight") == 0) {
+                ggml_c2_pf_head += c;
+            } else if (strstr(w, "ffn_gate_inp") != NULL) {
+                ggml_c2_pf_router += c;
+            } else {
+                ggml_c2_pf_mm += c;
+            }
+            break;
+        case GGML_OP_MUL_MAT_ID:     ggml_c2_pf_mmid += c; break;
+        case GGML_OP_FLASH_ATTN_EXT:
+        case GGML_OP_SOFT_MAX:       ggml_c2_pf_attn += c; break;
+        default:                     ggml_c2_pf_other += c; break;
+    }
+}
+
+static void ggml_c2_kit_end(const struct ggml_cgraph * cgraph, int n_threads, int64_t t_start) {
+    GGML_UNUSED(cgraph);
+    if (!ggml_c2_prof_graph) {
+        return;
+    }
+    long f[2];
+    ggml_c2_faults(f);
+    const int64_t us = ggml_time_us() - t_start;
+    char ops[1400];
+    int n = 0;
+    for (int op = 0; op < GGML_OP_COUNT && n < (int) sizeof ops - 64; op++) {
+        if (ggml_c2_pf_cnt[op]) {
+            n += snprintf(ops + n, sizeof ops - n, " %s %lld:%lld+%lld", ggml_op_name((enum ggml_op) op), (long long) ggml_c2_pf_cnt[op],
+                          (long long) ggml_c2_pf_comp[op], (long long) ggml_c2_pf_wait[op]);
+        }
+    }
+    ops[n] = 0;
+    ggml_c2_line("cpu-prof ab=%c tok=%lld us/token=%lld majflt=%ld minflt=%ld mhz=%d/%d run=%s prompt=%lld blk=%d threads=%d "
+                 "ops=%lld barriers=%lld syncs=%d skipped=%llu pairs=%llu head=%lld router=%lld mm=%lld mmid=%lld attn=%lld "
+                 "other=%lld wait=%lld |%s",
+                 ggml_c2_ab_side, (long long) ggml_c2_tok, (long long) us, f[0] - ggml_c2_flt0[0], f[1] - ggml_c2_flt0[1],
+                 ggml_c2_mhz(4), ggml_c2_mhz(7), ggml_c2_run, (long long) ggml_c2_prompt, ggml_c2_ab_blk, n_threads,
+                 (long long) ggml_c2_g_cur_ops, (long long) ggml_c2_g_cur_barriers + 1,
+                 atomic_load_explicit(&ggml_c2_g_cur_syncs, memory_order_relaxed)/(n_threads > 1 ? n_threads : 1),
+                 ggml_c2_st_pairs_skip - ggml_c2_skg_skip, ggml_c2_st_pairs - ggml_c2_skg_pairs,
+                 (long long) ggml_c2_pf_head, (long long) ggml_c2_pf_router, (long long) ggml_c2_pf_mm, (long long) ggml_c2_pf_mmid,
+                 (long long) ggml_c2_pf_attn, (long long) ggml_c2_pf_other, (long long) ggml_c2_pf_waitall, ops);
+}
+
+// the lines of the prompt being counted, now (libllama calls this when a context is freed, through the CPU backend's
+// proc address "ggml_backend_cpu_c2_flush"); the next graph still starts a new prompt as usual
