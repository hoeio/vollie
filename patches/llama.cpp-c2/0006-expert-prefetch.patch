+            }
             if (node->op == GGML_OP_MUL_MAT_ID && ggml_c2_mmid_fuse_ok(cgraph, node_n, cplan, params.nth)) {
                 ggml_c2_mmid_decode_fused(&p, node, cgraph->nodes[node_n + 2]); // Vollie c2 (0005): counts as one MUL_MAT_ID
                 n_fused = 2;
@@ -3880,6 +3942,8 @@ enum ggml_status ggml_graph_compute(struct ggml_cgraph * cgraph, struct ggml_cpl
         ggml_c2_mmid_nb = m && atoi(m) == 1;
         const char * f = getenv("VOLLIE_MMID_FUSE"); // Vollie c2 (0005)
         ggml_c2_mmid_fuse = f && atoi(f) == 1;
+        const char * io = getenv("VOLLIE_EXPERT_IO"); // Vollie c2 (0006)
+        ggml_c2_expert_io = io && atoi(io) == 1;
     }
 
