+// ---- Vollie c2 (patches/llama.cpp-c2/0006): env VOLLIE_EXPERT_IO=1 (unset / 0 = off): expert read-ahead. Before the
+// first MUL_MAT_ID of a layer (the first node within 32 that uses this ids tensor) thread 0 asks the kernel to read the
+// routed experts' slices of every sibling MUL_MAT_ID (same ids, the next 32 nodes) with madvise(MADV_WILLNEED), so
+// mmapped experts are requested together instead of faulting in page by page on the compute threads. In a one-token
+// graph experts that 0001's skip leaves without a row are not advised. Advice only: no data or result changes.
+// Campaign 1: GGML_EXPERT_IO bit 1 (device R18, R26).
+static int ggml_c2_expert_io = 0; // read per graph by ggml_graph_compute
+
+static void ggml_c2_expert_prefetch(const struct ggml_cgraph * cgraph, int node_n) {
+#if !defined(_WIN32)
+    struct ggml_tensor * node = cgraph->nodes[node_n];
+    const struct ggml_tensor * ids = node->src[2];
+    for (int j = node_n - 1; j >= 0 && j >= node_n - 32; j--) {
+        if (cgraph->nodes[j]->op == GGML_OP_MUL_MAT_ID && cgraph->nodes[j]->src[2] == ids) {
+            return; // an earlier sibling already covered this layer
+        }
+    }
+    const int64_t n_as = node->src[0]->ne[2];
+    if (n_as > GGML_C2_MMID_MAX_AS || ids->type != GGML_TYPE_I32 || n_as*ids->ne[0] > GGML_C2_MMID_MAX_ROWS) {
+        return;
+    }
+    int64_t need[GGML_C2_MMID_MAX_AS] = { 0 };
+    if (ids->ne[1] == 1) {
+        struct mmid_row_mapping matrix_rows[GGML_C2_MMID_MAX_ROWS];
+        ggml_c2_mmid_map(node, ids, n_as, need, matrix_rows, false); // the op's own map, 0001's skip applied; writes nothing
+    } else {
+        for (int64_t t = 0; t < ids->ne[1]; t++) {
+            for (int64_t k = 0; k < ids->ne[0]; k++) {
+                const int32_t e = *(const int32_t *) ((const char *) ids->data + t*ids->nb[1] + k*ids->nb[0]);
+                if (e >= 0 && e < n_as) {
+                    need[e] = 1;
+                }
+            }
+        }
+    }
+    static uintptr_t page = 0;
+    if (!page) {
+        page = (uintptr_t) sysconf(_SC_PAGESIZE);
+    }
+    for (int j = node_n; j < cgraph->n_nodes && j < node_n + 32; j++) {
+        const struct ggml_tensor * n = cgraph->nodes[j];
+        if (n->op != GGML_OP_MUL_MAT_ID || n->src[2] != ids || n->src[0]->data == NULL) {
+            continue;
+        }
+        const struct ggml_tensor * w = n->src[0];
+        for (int64_t e = 0; e < n_as && e < w->ne[2]; e++) {
+            if (need[e]) {
+                const uintptr_t b = ((uintptr_t) w->data + e*w->nb[2]) & ~(page - 1);
+                const uintptr_t x = ((uintptr_t) w->data + (e + 1)*w->nb[2] + page - 1) & ~(page - 1);
+                madvise((void *) b, x - b, MADV_WILLNEED);
+            }
+        }
+    }
+#else
+    GGML_UNUSED(cgraph); GGML_UNUSED(node_n);
+#endif
+}
