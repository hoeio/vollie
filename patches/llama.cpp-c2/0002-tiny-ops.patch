+// Vollie c2 (0002): env VOLLIE_TINY_OP=<elements> (unset or 0 = off, stock loop). An op whose output and inputs
+// have at most this many elements (GET_ROWS: output and index list only) runs on thread 0 alone (nth = 1), and the
+// barrier between two consecutive such ops is skipped. The next op that runs on every thread is still preceded by a
+// barrier, so every thread sees thread 0's results first. Mat-muls, flash attention and every op that calls
+// ggml_barrier or the shared chunk counter itself never count as tiny. A fused RMS_NORM + MUL is tiny only if both
+// nodes are. Same results: an op computed on one thread writes the same values per element as on n threads (no
+// op in the tiny set splits a reduction across threads). Read per graph by ggml_graph_compute.
+// Env VOLLIE_GRAPH_STATS=1 (counter only): at exit one "c2-graph:" line on stderr with the mean per one-token graph
+// (first node's ne[1] == 1) of graph nodes, ops run, ops run tiny, barriers between ops (the closing one included) and
+// syncs (every ggml_barrier call, those inside ops included; with 1 thread none).
+static int64_t ggml_c2_tiny = 0;
+static int64_t ggml_c2_g_graphs, ggml_c2_g_nodes, ggml_c2_g_ops, ggml_c2_g_tiny, ggml_c2_g_barriers, ggml_c2_g_syncs; // one-token graphs
+static int64_t ggml_c2_g_cur_ops, ggml_c2_g_cur_tiny, ggml_c2_g_cur_barriers; // this graph, thread 0 only
+
+static void ggml_c2_gstats_report(void) {
+    const double g = ggml_c2_g_graphs ? (double) ggml_c2_g_graphs : 1.0;
+    fprintf(stderr, "c2-graph: tiny_op=%lld one_token_graphs=%lld nodes=%.1f ops_run=%.1f ops_tiny=%.1f barriers=%.1f syncs=%.1f\n",
+            (long long) ggml_c2_tiny, (long long) ggml_c2_g_graphs, ggml_c2_g_nodes/g, ggml_c2_g_ops/g, ggml_c2_g_tiny/g,
+            ggml_c2_g_barriers/g, ggml_c2_g_syncs/g);
+}
+
+static bool ggml_c2_node_is_tiny(const struct ggml_tensor * node) {
+    switch (node->op) {
+        case GGML_OP_MUL_MAT:
+        case GGML_OP_MUL_MAT_ID:
+        case GGML_OP_OUT_PROD:
+        case GGML_OP_SSM_SCAN:
+        case GGML_OP_FLASH_ATTN_EXT:
+        case GGML_OP_FLASH_ATTN_BACK:
+        case GGML_OP_CUSTOM:
+        case GGML_OP_MAP_CUSTOM1:
+        case GGML_OP_MAP_CUSTOM2:
+        case GGML_OP_MAP_CUSTOM3:
+        case GGML_OP_ACC:
+        case GGML_OP_SET:
+        case GGML_OP_COUNT_EQUAL:
+        case GGML_OP_DIAG_MASK_INF:
+        case GGML_OP_DIAG_MASK_ZERO:
+        case GGML_OP_CONV_TRANSPOSE_1D:
+        case GGML_OP_CONV_2D:
+        case GGML_OP_CONV_3D:
+        case GGML_OP_CONV_TRANSPOSE_2D:
+        case GGML_OP_ADD_REL_POS:
+        case GGML_OP_RWKV_WKV6:
+        case GGML_OP_GATED_LINEAR_ATTN:
+        case GGML_OP_GATED_DELTA_NET:
+        case GGML_OP_CROSS_ENTROPY_LOSS:
+            return false; // real work, or ops that call ggml_barrier / the chunk counter themselves
+        default:
+            break;
+    }
+    int64_t n = ggml_nelements(node);
+    for (int i = node->op == GGML_OP_GET_ROWS ? 1 : 0; i < GGML_MAX_SRC && node->src[i]; i++) {
+        n = MAX(n, ggml_nelements(node->src[i]));
+    }
+    return n <= ggml_c2_tiny;
+}
+
+static bool ggml_c2_runs_tiny(const struct ggml_cgraph * cgraph, int j, int n_fused) {
+    return ggml_c2_node_is_tiny(cgraph->nodes[j]) && (n_fused == 0 || ggml_c2_node_is_tiny(cgraph->nodes[j + 1]));
+}
+
+// the compute loop's decision for the next node that runs
+static bool ggml_c2_next_is_tiny(const struct ggml_cgraph * cgraph, int node_n, const struct ggml_cplan * cplan) {
+    for (int j = node_n + 1; j < cgraph->n_nodes; j++) {
+        const struct ggml_tensor * next = cgraph->nodes[j];
+        if (ggml_op_is_empty(next->op) || (next->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            continue;
+        }
+        return ggml_c2_runs_tiny(cgraph, j, ggml_cpu_fuse_count(cgraph, j, cplan));
+    }
+    return false;
+}
