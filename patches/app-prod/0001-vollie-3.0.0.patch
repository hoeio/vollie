+import 'package:flutter/services.dart';
+
+/// 3.0.0: the two engines. [v2] (default) = campaign 2's runtime with a model the user picks; [classic] = Vollie 1
+/// (2.3.0+45) exactly: its libraries, its model file and its settings. The engine is chosen per process before Dart
+/// starts (MainActivity.preloadEngine); switching stores the choice and restarts the app.
+enum Engine { v2, classic }
+
+/// A model the app can download (ModelDownloadService.SPECS has the URL and sha256 of each).
+typedef ModelInfo = ({String id, String name, String about, String file, int bytes});
+
+class Engines {
+  static const _channel = MethodChannel('vollie/downloads');
+
+  /// The engine this process runs, and the stored choice (they differ only if the classic libraries failed to load).
+  static Engine active = Engine.v2, stored = Engine.v2;
+
+  /// When the last engine switch ended the previous process (epoch ms, 0 = never): that SIGKILL is not a crash.
+  static int restartAt = 0;
+  static bool get classic => active == Engine.classic;
+
+  static Future<void> init() async {
+    try {
+      final m = await _channel.invokeMapMethod<String, Object?>('engine') ?? const {};
+      active = m['active'] == 'classic' ? Engine.classic : Engine.v2;
+      stored = m['stored'] == 'classic' ? Engine.classic : Engine.v2;
+      restartAt = (m['restartAt'] as int?) ?? 0;
+    } on MissingPluginException {
+      // tests, desktop: Vollie 2
+    }
+  }
+
+  /// Stores [e] and restarts the app into it (RestartActivity). Does not return on a phone.
+  static Future<void> switchTo(Engine e) => _channel.invokeMethod('setEngine', {'engine': e.name});
+
+  static const c1 = (
+    id: 'c1',
+    name: 'Granite 4.0 H Tiny · Q4_0/Q3_K',
+    about: 'Vollie 1\'s model.',
+    file: 'vollie-granite-4.0-h-tiny-d6-e6.gguf',
+    bytes: 3161269888,
+  );
+
+  /// Vollie 2's models (campaign 2's served files, stock weights), in the order the first run offers them.
+  static const v2Models = <ModelInfo>[
+    (
+      id: 'olmoe',
+      name: 'OLMoE 1B-7B',
+      about: 'Ai2\'s open model. The faster of the two on a Snapdragon 888.',
+      file: 'olmoe-Mi.gguf',
+      bytes: 3072399552,
+    ),
+    (
+      id: 'granite',
+      name: 'Granite 4.0 H Tiny',
+      about: 'IBM\'s model, the original weights.',
+      file: 'granite-Mi.gguf',
+      bytes: 3161269344,
+    ),
+  ];
+
+  static ModelInfo? byId(String? id) => id == c1.id ? c1 : v2Models.where((m) => m.id == id).firstOrNull;
+  static ModelInfo? byFile(String path) {
+    final name = path.split('/').last;
+    return name == c1.file ? c1 : v2Models.where((m) => m.file == name).firstOrNull;
+  }
+
+  /// Vollie 2's native settings per model: kit r31's arms as R70 (OLMoE, b5) and R71 S1 (Granite, b2) measured them,
+  /// without the kit's counters and log lines (GGML_C2_IO, VOLLIE_SKIP_STATS, VOLLIE_SCHED, VOLLIE_LINES, VOLLIE_RUN).
+  /// Both: campaign 1's settings without numerics (tiny-op 262,144, expert read-ahead 1, sampler fast path), the KV
+  /// clear by MADV_DONTNEED, the persistent pool pinned to the fast cores (0xf0 on an SD888), the executable model
+  /// mapping. OLMoE: skip MASS=900 + untied two-stage head 1,024 (the head in CPU_REPACK at load), the page touch every
+  /// 12 s while idle, the pool at nice -10. Granite: campaign 1's skip at 130 + two-stage head 2,048 with a Q4_0 screen.
+  /// Both numerics settings are inside the +5 % budget (R61, host). [fastMask]: the fast cores as a hex mask, null =
+  /// no per-thread mask (the pool still runs).
+  static Map<String, String> v2Env(String modelId, String? fastMask) => {
+        'GGML_TINY_OP': '262144',
+        'GGML_EXPERT_IO': '1',
+        'VOLLIE_SAMPLER_BYPASS': '1',
+        'VOLLIE_KV_DONTNEED': '1',
+        'VOLLIE_POOL': '1',
+        if (fastMask != null) 'VOLLIE_CPUMASK': fastMask,
+        'VOLLIE_EXEC_MAP': '1',
+        if (modelId == 'olmoe') ...{
+          'VOLLIE_HEAD2_REPACK': '1',
+          'VOLLIE_SKIP_MASS': '900',
+          'VOLLIE_HEAD2': '1024',
+          'VOLLIE_TOUCH': '1',
+          'VOLLIE_TOUCH_S': '12',
+          'VOLLIE_NICE': '-10',
+        } else ...{
+          'GGML_EXPERT_SKIP': '130',
+          'GGML_HEAD2': '2048',
+          'GGML_HEAD2_Q': 'q4_0',
+        },
+      };
+
+  /// Every name [v2Env] can set: unset before each Vollie 2 load, so a model switch leaves nothing of the other.
+  static final v2Knobs = {...v2Env('olmoe', '0'), ...v2Env('granite', '0')}.keys.toSet();
+
+  /// Vollie 2's fixed thread count and context (kit r31: 3 threads, n_ctx 4096; OLMoE was trained to 4,096).
+  static const v2Threads = 3, v2Context = 4096;
+
+  /// What llama.cpp copies into its faster CPU layouts for these files (dense Q4_0 and the Q6_K head; Q3_K experts
+  /// have no repack path): about the same 700 MB for all three.
+  static const copyBytes = 700000000;
+  static bool known(int bytes) => bytes == c1.bytes || v2Models.any((m) => m.bytes == bytes);
+
+  /// Turn markup per chat template: where a user turn starts, what closes it, and the token that closes a reply.
+  /// Granite's (both files, and 2.3.0+45's constants) and OLMoE's (Tulu: <|user|>\n...\n<|assistant|>\n...<|endoftext|>).
+  static ({String userStart, String userEnd, String turnEnd}) markup(String? path) =>
+      path != null && byFile(path)?.id == 'olmoe'
+          ? (userStart: '<|user|>', userEnd: '\n', turnEnd: '<|endoftext|>')
+          : (userStart: '<|start_of_role|>user', userEnd: '<|end_of_text|>', turnEnd: '<|end_of_text|>');
+
+  /// [cpus] as a hex affinity mask ("0xf0" for cores 4-7), null when there are none.
+  static String? mask(List<int>? cpus) =>
+      cpus == null || cpus.isEmpty ? null : '0x${cpus.where((c) => c < 64).fold<int>(0, (m, c) => m | (1 << c)).toRadixString(16)}';
+}
