+  /// Stores the other engine and restarts the app into it (a running download is paused first; it resumes from
+  /// where it stopped).
+  Future<void> _switchEngine(Engine e) async {
+    if (e == Engines.active) return;
+    final ok = await showDialog<bool>(
+      context: context,
+      builder: (d) => AlertDialog(
+        title: Text(e == Engine.classic ? 'Switch to Vollie 1 classic?' : 'Switch to Vollie 2?'),
+        content: Text(
+          '${e == Engine.classic ? 'Vollie 1 classic is the previous version\'s engine and model, unchanged. '
+              : 'Vollie 2 is the new engine, with a model you choose. '}'
+          'Vollie restarts to switch. Your chat is kept.',
+        ),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(d, false), child: const Text('Cancel')),
+          FilledButton(onPressed: () => Navigator.pop(d, true), child: const Text('Restart')),
+        ],
+      ),
+    );
+    if (ok != true || !mounted) return;
+    final store = context.read<ModelStore>();
+    if (store.active) await store.pause();
+    await Engines.switchTo(e);
+  }
+
+  /// Vollie 2: makes [m] the model. Downloaded: loaded now; else the download screen takes over.
+  Future<void> _switchModel(ModelInfo m) async {
+    final store = context.read<ModelStore>();
+    final assistant = context.read<Assistant>();
+    if (m.id == store.model?.id || assistant.isBusy) return;
+    final have = await store.isDownloaded(m);
+    if (!mounted) return;
+    if (!have) {
+      final ok = await showDialog<bool>(
+        context: context,
+        builder: (d) => AlertDialog(
+          title: Text('Download ${m.name}?'),
+          content: Text('It needs a one-time download of ${(m.bytes / 1e9).toStringAsFixed(1)} GB. '
+              'The model you have now stays on the phone; you can switch back anytime.'),
+          actions: [
+            TextButton(onPressed: () => Navigator.pop(d, false), child: const Text('Cancel')),
+            FilledButton(onPressed: () => Navigator.pop(d, true), child: const Text('Download')),
+          ],
+        ),
+      );
+      if (ok != true || !mounted) return;
+      await assistant.unload();
+      if (mounted) Navigator.of(context).popUntil((r) => r.isFirst);
+    }
+    await store.select(m.id);
+  }
