+ *  and fp16 but not i8mm (ggml-cpu/arch/arm/cpu-feats.cpp: 8.6_1 and 9.2_1 need i8mm). Top level, so a JVM test can call
+ *  it without loading FlutterActivity. */
+internal fun classicModuleIsBest(features: Set<String> = cpuinfoFeatures()) =
+    "asimddp" in features && "asimdhp" in features && "i8mm" !in features
+
+private fun cpuinfoFeatures(): Set<String> = runCatching {
+    File("/proc/cpuinfo").useLines { lines ->
+        lines.firstOrNull { it.startsWith("Features") }?.substringAfter(":")?.trim()?.split(Regex("\\s+"))?.toSet()
+    }
+}.getOrNull() ?: emptySet()
