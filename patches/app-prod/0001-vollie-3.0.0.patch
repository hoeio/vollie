@@ -0,0 +1,26 @@
+package com.insaneutils.vollie
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class EngineTest {
+    // Vollie 1 classic loads 2.3.0+45's own android_armv8.2_2 module exactly where ggml picked that variant.
+    @Test fun classicModuleOnlyWhereGgmlPicked82() {
+        val sd888 = "fp asimd evtstrm aes pmull sha1 sha2 crc32 atomics fphp asimdhp cpuid asimdrdm lrcpc dcpop asimddp".split(" ").toSet()
+        assertEquals(true, classicModuleIsBest(sd888))
+        assertEquals(false, classicModuleIsBest(sd888 + "i8mm")) // 8.6_1 / 9.2_1 win
+        assertEquals(false, classicModuleIsBest(sd888 - "asimddp")) // 8.0_1
+        assertEquals(false, classicModuleIsBest(sd888 - "asimdhp"))
+        assertEquals(false, classicModuleIsBest(emptySet()))
+    }
+
+    // First start of 3.0.0: an upgrade from 2.3.0+45 keeps classic, a fresh install gets Vollie 2.
+    @Test fun upgradeFrom45KeepsClassic() {
+        assertEquals("v2", firstEngine(emptySet(), emptyList())) // fresh install
+        assertEquals("v2", firstEngine(setOf("other.key"), listOf("notes.txt"))) // nothing of 2.3.0+45's
+        assertEquals("classic", firstEngine(setOf("flutter.theme_mode"), emptyList())) // installed, download never finished
+        assertEquals("classic", firstEngine(emptySet(), listOf("vollie-granite-4.0-h-tiny-d6-e6.gguf.part"))) // partial
+        assertEquals("classic", firstEngine(emptySet(), listOf("vollie-granite-4.0-h-tiny-d6-e6.gguf", "vollie-granite-4.0-h-tiny-d6-e6.gguf.verified")))
+        assertEquals("classic", firstEngine(emptySet(), listOf("vollie-qwen3.5-4b-q4_0-mtp.gguf.verified"))) // a legacy build's model
+    }
+}
