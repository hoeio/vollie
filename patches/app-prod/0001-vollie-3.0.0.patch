+/// Other models' files on this phone (3.0.0: Vollie 1 classic's and Vollie 2's), each with a delete button.
+class _OtherModels extends StatefulWidget {
+  final ModelInfo? current;
+  const _OtherModels({required this.current});
+
+  @override
+  State<_OtherModels> createState() => _OtherModelsState();
+}
+
+class _OtherModelsState extends State<_OtherModels> {
+  List<ModelInfo> _have = const [];
+
+  @override
+  void initState() {
+    super.initState();
+    _scan();
+  }
+
+  @override
+  void didUpdateWidget(_OtherModels old) {
+    super.didUpdateWidget(old);
+    if (old.current?.id != widget.current?.id) _scan();
+  }
+
+  Future<void> _scan() async {
+    final store = context.read<ModelStore>();
+    final have = <ModelInfo>[];
+    for (final m in [Engines.c1, ...Engines.v2Models]) {
+      if (m.id != widget.current?.id && await store.isDownloaded(m)) have.add(m);
+    }
+    if (mounted) setState(() => _have = have);
+  }
+
+  Future<void> _delete(ModelInfo m) async {
+    final ok = await showDialog<bool>(
+      context: context,
+      builder: (d) => AlertDialog(
+        title: Text('Delete ${m.name}?'),
+        content: Text('This frees about ${(m.bytes / 1e9).toStringAsFixed(1)} GB. '
+            '${m.id == Engines.c1.id ? 'Vollie 1 classic needs it' : 'Vollie 2 needs it'} to run this model again.'),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(d, false), child: const Text('Cancel')),
+          FilledButton(onPressed: () => Navigator.pop(d, true), child: const Text('Delete')),
+        ],
+      ),
+    );
+    if (ok != true || !mounted) return;
+    await context.read<ModelStore>().deleteOther(m);
+    await _scan();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (_have.isEmpty) return const SizedBox.shrink();
+    return Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+      const _Section('Other models on this phone'),
+      _Card(children: [
+        for (final m in _have)
+          ListTile(
+            contentPadding: EdgeInsets.zero,
+            title: Text(m.name),
+            subtitle: Text('${m.id == Engines.c1.id ? 'Vollie 1 classic' : 'Vollie 2'} · '
+                '${(m.bytes / 1e9).toStringAsFixed(1)} GB'),
+            trailing: IconButton(
+              tooltip: 'Delete',
+              icon: const Icon(Icons.delete_outline_rounded),
+              onPressed: () => _delete(m),
+            ),
+          ),
+      ]),
+    ]);
+  }
+}
