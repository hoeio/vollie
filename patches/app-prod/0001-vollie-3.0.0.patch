+import 'package:flutter_test/flutter_test.dart';
+import 'package:vollie/engine.dart';
+
+void main() {
+  test('Vollie 2 env: R70 b5 arm for OLMoE, R71 S1 b2 arm for Granite, without the kit counters', () {
+    final o = Engines.v2Env('olmoe', '0xf0');
+    expect(o, {
+      'GGML_TINY_OP': '262144', 'GGML_EXPERT_IO': '1', 'VOLLIE_SAMPLER_BYPASS': '1', 'VOLLIE_KV_DONTNEED': '1',
+      'VOLLIE_POOL': '1', 'VOLLIE_CPUMASK': '0xf0', 'VOLLIE_EXEC_MAP': '1',
+      'VOLLIE_HEAD2_REPACK': '1', 'VOLLIE_SKIP_MASS': '900', 'VOLLIE_HEAD2': '1024',
+      'VOLLIE_TOUCH': '1', 'VOLLIE_TOUCH_S': '12', 'VOLLIE_NICE': '-10',
+    });
+    final g = Engines.v2Env('granite', null);
+    expect(g, {
+      'GGML_TINY_OP': '262144', 'GGML_EXPERT_IO': '1', 'VOLLIE_SAMPLER_BYPASS': '1', 'VOLLIE_KV_DONTNEED': '1',
+      'VOLLIE_POOL': '1', 'VOLLIE_EXEC_MAP': '1',
+      'GGML_EXPERT_SKIP': '130', 'GGML_HEAD2': '2048', 'GGML_HEAD2_Q': 'q4_0',
+    });
+    // A switch unsets every knob of both models first.
+    expect(Engines.v2Knobs, containsAll({...o.keys, ...g.keys}));
+    for (final k in ['GGML_C2_IO', 'VOLLIE_SKIP_STATS', 'VOLLIE_SCHED', 'VOLLIE_LINES', 'VOLLIE_RUN']) {
+      expect(Engines.v2Knobs, isNot(contains(k)));
+    }
+  });
+
+  test('fast-core mask, known files, markup', () {
+    expect(Engines.mask([4, 5, 6, 7]), '0xf0');
+    expect(Engines.mask([6, 7]), '0xc0');
+    expect(Engines.mask(null), isNull);
+    expect(Engines.known(3161269888) && Engines.known(3072399552) && Engines.known(3161269344), isTrue);
+    expect(Engines.known(3774686848), isFalse); // a legacy file copies its whole size, as in 2.3.0+45
+    final granite = Engines.markup('/x/vollie-granite-4.0-h-tiny-d6-e6.gguf');
+    expect(granite, (userStart: '<|start_of_role|>user', userEnd: '<|end_of_text|>', turnEnd: '<|end_of_text|>'));
+    expect(Engines.markup('/x/granite-Mi.gguf'), granite);
+    expect(Engines.markup('/x/olmoe-Mi.gguf'), (userStart: '<|user|>', userEnd: '\n', turnEnd: '<|endoftext|>'));
+    expect(Engines.byFile('/data/user/0/com.insaneutils.vollie/files/olmoe-Mi.gguf')?.id, 'olmoe');
+  });
+}
