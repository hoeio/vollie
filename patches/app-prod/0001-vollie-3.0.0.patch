--- /dev/null
+++ b/android/app/src/main/kotlin/com/example/vollie/RestartActivity.kt
@@ -0,0 +1,20 @@
+package com.insaneutils.vollie
+
+import android.app.Activity
+import android.content.Intent
+import android.os.Bundle
+
+/** 3.0.0 engine switch (kit r30's process restart, as ProcessPhoenix): runs in its own process (":restart"), ends the
+ *  app's main process, starts MainActivity in a new one (which loads the stored engine's libraries), then ends itself.
+ *  Started from the settings screen, so the app is in front (Android 15 blocks starts from the background: R71). */
+class RestartActivity : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val pid = intent.getIntExtra("pid", -1)
+        if (pid > 0) android.os.Process.killProcess(pid)
+        startActivity(Intent(this, MainActivity::class.java)
+            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TASK))
+        finish()
+        Runtime.getRuntime().exit(0)
+    }
+}
