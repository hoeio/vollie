+ *  preferences (FlutterSharedPreferences, "flutter.*": settings, chats, a started download's id), or any model file in
+ *  its download folder (a model, a .part, a .verified marker, current or legacy names). */
+internal fun firstEngine(oldPrefKeys: Set<String>, oldFiles: List<String>) =
+    if (oldPrefKeys.any { it.startsWith("flutter.") } ||
+        oldFiles.any { it.endsWith(".gguf") || it.endsWith(".gguf.part") || it.endsWith(".gguf.verified") }) "classic" else "v2"
