+#if defined(__linux__)
+// Vollie c3 (0004): this thread's affinity = m (cpus 0-63).
+static void ggml_c2_pin_set(unsigned long long m) {
+    cpu_set_t cs;
+    CPU_ZERO(&cs);
+    for (int c = 0; c < 64; c++) {
+        if (m >> c & 1) CPU_SET(c, &cs);
+    }
+    sched_setaffinity(0, sizeof cs, &cs);
+}
+
+// Vollie c3 (0004): VOLLIE_PIN_GUARD at a graph start (cpu = sched_getcpu() after the mask check).
+static void ggml_c2_pin_guard(int ith, int ph, unsigned long long want, int cpu) {
+    if (ph >= 0) ggml_c2_pin[ith][ph].chk++;
+    if (cpu < 0 || cpu >= 64 || (want >> cpu & 1)) {
+        return;
+    }
+    const int64_t t0 = ggml_time_us();
+    do {
+        ggml_c2_pin_set(want | 1ull << cpu); // a different mask that keeps the current cpu: no move yet
+        ggml_c2_pin_set(want);               // the current cpu is not in it: the kernel moves the thread now
+        for (const int64_t t1 = ggml_time_us(); ggml_time_us() - t1 < 50; ) {
+            if ((cpu = sched_getcpu()) >= 0 && cpu < 64 && (want >> cpu & 1)) break;
+        }
+    } while (!(cpu >= 0 && cpu < 64 && (want >> cpu & 1)) && ggml_time_us() - t0 < ggml_c2_guard_us);
+    const bool ok = cpu >= 0 && cpu < 64 && (want >> cpu & 1);
+    if (ok && ggml_c2_warm_us > 0) {
+        for (const int64_t t1 = ggml_time_us(); ggml_time_us() - t1 < ggml_c2_warm_us; ) {}
+    }
+    if (ph >= 0) {
+        ggml_c2_pin[ith][ph].mis++;
+        ggml_c2_pin[ith][ph].rec += ok;
+        ggml_c2_pin[ith][ph].fail += !ok;
+        ggml_c2_pin[ith][ph].us += ggml_time_us() - t0;
+    }
+}
+#endif
