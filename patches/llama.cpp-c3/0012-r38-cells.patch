+// ---- the timed matrix loop. Thread 0 runs prep(k) for matrix k (copy, mask, kept lists; returns the matrix's 128-row units),
+// a barrier, every thread takes units from a shared counter and runs unit(u), a barrier; thread 0 times prep to the second
+// barrier. Accounting (cpu / wall, switches, off-core checks) as l4's run_layers.
+const double W38 = 0.3, M38 = 1.0, RAMP38 = 1.0;   // warm-up, measured, clock wait cap of the probe arms (ggml arms: gtime's 4 s)
+struct MV { long mats = 0; std::vector<double> ms; Cell2 c; };
+template <class P, class U> MV run_mv(const std::vector<int> & set, P prep, U unit, double warm, double meas) {
+    Aff aff; pin_cpus({ 0, 1, 2, 3 });
+    const int n = (int) set.size(); Bar bar; bar.n = n; std::atomic<int> ready{0}, phase{0}, cur{0}, ctr{0}, nu{0};
+    MV r; Cell2 & c = r.c; c.n = n; c.cpu.assign(n, 0); c.wall.assign(n, 0); c.niv.assign(n, -1); c.nv.assign(n, -1); c.u.assign(n, 0); c.b.assign(n, 0);
+    c.chk.assign(n, 0); c.off.assign(n, 0); c.other.assign(n, -1);
+    std::vector<int> ok(n); std::vector<std::thread> th;
+    for (int i = 0; i < n; i++) th.emplace_back([&, i] {
+        bool p = pin(set[i]); int c0 = where(); ready++;
+        while (ready.load() < n) {}
+        int last = 0; double q0 = 0; clk::time_point w0, m0; long iv0 = -1, v0 = -1;
+        for (long k = 0;; k++) {
+            if (i == 0) {
+                const int ph = phase.load(); cur.store(ph, std::memory_order_relaxed); ctr.store(0, std::memory_order_relaxed);
+                m0 = clk::now(); if (ph != 2) nu.store(prep(k), std::memory_order_relaxed);
+            }
+            bar.wait();
+            const int ph = cur.load(std::memory_order_relaxed);
+            if (ph != last) {
+                if (ph == 1) { q0 = tcpu(); w0 = clk::now(); csw(iv0, v0, false); }
+                else { long iv1, v1; csw(iv1, v1, false); c.cpu[i] = tcpu() - q0; c.wall[i] = secs(w0, clk::now()); c.niv[i] = iv0 < 0 ? -1 : iv1 - iv0; c.nv[i] = v0 < 0 ? -1 : v1 - v0; }
+                last = ph;
+            }
+            if (ph == 2) break;
+            const int units = nu.load(std::memory_order_relaxed);
+            for (;;) { const int u = ctr.fetch_add(1, std::memory_order_relaxed); if (u >= units) break; unit(u); if (ph == 1) c.u[i] += 1; }
+            bar.wait();
+            if (i == 0 && ph == 1) { r.ms.push_back(secs(m0, clk::now()) * 1e3); r.mats++; }
+            if (ph == 1 && !(k & 15)) { const int w = where(); c.chk[i]++; if (w != set[i]) { c.off[i]++; c.other[i] = w; } }
+        }
+        ok[i] = p && c0 == set[i] && where() == set[i];
+    });
+    while (ready.load() < n) {}
+    c.m0 = mhz(); c.rp = ramp(set, warm, RAMP38, [] { sleep_s(0.05); }); phase = 1; const auto t0 = clk::now();
+    while (secs(t0, clk::now()) < meas) { c.mz.sample(); sleep_s(0.1); }
+    phase = 2;
+    for (auto & t : th) t.join();
+    c.m1 = mhz(); for (int i = 0; i < n; i++) c.cpu_ok += ok[i];
+#if !defined(__linux__)
+    c.cpu_ok = -1;
+#endif
+    for (double v : r.ms) c.secs += v * 1e-3;
+    return r;
+}
+
+// ---- one block: arms in chains, a trip line per lever, a canary per arm
+
+struct AR { std::string kern, subj; int rows = 0, K = 0; double d = 1, bytes = 0, ms = -1; long mats = 0; };
+struct B38 {
+    Out & o; const char * blk; Therm th; clk::time_point t0 = clk::now(); int pos = 0; std::vector<int> set; std::vector<AR> ch;
+    B38(Out & o_, const char * b) : o(o_), blk(b) {}
+    void emit(AR a, const std::string & pq, const std::string & tail, const std::string & buft) {
+        const double t_ms = secs(t0, clk::now()) * 1e3;
+        o.line("ud arm blk=%s pos=%d t_ms=%.0f cores=%s threads=%zu kern=%s subj=%s rows=%d k_in=%d d=%.4f mats=%ld ms_per_mat=%.4f ms_p=%s ns_per_touched_w=%.4f bytes_per_mat=%.0f gbs=%.2f buft=%s hr=%s status=%s %s",
+               blk, pos, t_ms, setname(set).c_str(), set.size(), a.kern.c_str(), a.subj.c_str(), a.rows, a.K, a.d, a.mats, a.ms, pq.c_str(),
+               a.ms > 0 ? a.ms * 1e6 / ((double) a.rows * a.K * a.d) : -1.0, a.bytes, a.ms > 0 ? a.bytes / (a.ms * 1e6) : -1.0, buft.c_str(), th.hr().c_str(), th.status().c_str(), tail.c_str());
+        canary(o, blk, pos, t0);
+        pos++; ch.push_back(a);
+    }
+    void probe(AR a, const MV & r) {
+        a.mats = r.mats; a.ms = r.mats ? r.c.secs * 1e3 / r.mats : -1;
+        char b[64]; snprintf(b, sizeof b, "cpu_ok=%d/%d ", r.c.cpu_ok, r.c.n);
+        emit(a, pq(r.ms, "%.4f"), b + ("thr=" + thr(r.c, set)) + " mhz=" + r.c.m0 + "->" + r.c.m1 + " mhz_range=" + r.c.mz.str() + " " + rampstr(r.c.rp), "probe");
+    }
+    void close() {   // levers between two stock arms of this chain
+        for (size_t i = 1; i + 1 < ch.size(); i++) {
+            const AR & s1 = ch[i - 1], & a = ch[i], & s2 = ch[i + 1];
+            if (a.kern == "stock" || s1.kern != "stock" || s2.kern != "stock") continue;
+            const double sm = (s1.ms + s2.ms) / 2, t = s1.ms > 0 && s2.ms > 0 && a.ms > 0 ? a.ms / sm : -1;
+            o.line("ud trip blk=%s pos=%d cores=%s kern=%s subj=%s rows=%d k_in=%d d=%.4f st1_ms=%.4f lever_ms=%.4f st2_ms=%.4f stock_diff=%.4f t_vs_stock=%.4f k=%.4f",
+                   blk, pos - (int) ch.size() + (int) i, setname(set).c_str(), a.kern.c_str(), a.subj.c_str(), a.rows, a.K, a.d, s1.ms, a.ms, s2.ms,
+                   sm > 0 ? std::fabs(s1.ms - s2.ms) / sm : -1.0, t, t > 0 ? t / a.d : -1.0);
+        }
+        ch.clear();
+    }
+};
+// the arena: 256 MB of random bytes, every layout's fp16 scales made finite (4x4 groups, K1 chunks, plain blocks)
+struct Arena { uint8_t * a = nullptr; size_t n = (size_t) 256 << 20; ~Arena() { if (a) munmap(a, n); }
+    bool make() { void * p = mmap(nullptr, n, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0); if (p == MAP_FAILED) return false;
+                  a = (uint8_t *) p; fill(a, n); fix_scales(a, n, sizeof(bq4x4), 4); fix_scales(a, n, KB, KT); fix_scales(a, n, sizeof(bq4), 1); return true; } };
+struct Sh { int rows, K; size_t bytes() const { return (size_t) rows * (K / QK) * 18; } };
+// probe kernels on one shape: kern stock | y1b (dense) | k1 (mask m's inputs) | rows (mask m's row list, Y1b in place)
+void parm(B38 & B, const Arena & A, const Sh & s, const std::vector<bq8> & x, const char * kern, const std::vector<const UMask *> & ms = {}) {
+    const int nb = s.K / QK; const size_t S = s.bytes(), cp = A.n / S; std::vector<float> y(F38 + KT);
+    const bool k1 = !strcmp(kern, "k1"), rows = !strcmp(kern, "rows"), yb = !strcmp(kern, "y1b");
+    std::vector<Lists> Ls; for (const UMask * m : ms) Ls.push_back(m->in);
+    Lists * L = nullptr; const std::vector<int> * rl = nullptr; const uint8_t * base = A.a;
+    auto prep = [&](long k) -> int {
+        base = A.a + (size_t)(k % (long) cp) * S;
+        if (k1) { L = &Ls[k % (long) Ls.size()]; build_lists(*L, x.data()); }
+        if (rows) { rl = &ms[k % (long) ms.size()]->rl; return (int)((rl->size() + KT - 1) / KT); }
+        return s.rows / KT;
+    };
+    auto unit = [&](int u) {
+        if (k1) k1x<0>(base, nb, x.data(), *L, y.data(), u, u + 1);
+        else if (rows) y1b_rows(base, nb, x.data(), rl->data() + (size_t) u * KT, std::min<int>(KT, (int) rl->size() - u * KT), y.data() + (size_t) u * KT);
+        else if (yb) y1b(base + (size_t) u * KT * nb * 18, KT, nb, x.data(), y.data() + (size_t) u * KT);
+        else stock_n(base + (size_t) u * (KT / 4) * nb * sizeof(bq4x4), KT, nb, x.data(), y.data() + (size_t) u * KT);
+    };
+    const MV r = run_mv(B.set, prep, unit, W38, M38);
+    AR a; a.kern = kern; a.subj = ms.empty() ? "-" : ms[0]->src->subj; a.rows = s.rows; a.K = s.K; a.d = 1; a.bytes = (double) S;
+    if (k1) { double kept = 0, by = 0; for (const Lists & l : Ls) { kept += l.kept; by += touched_bytes(l, s.rows); } a.d = kept / Ls.size() / s.K; a.bytes = by / Ls.size(); }
+    if (rows) { double n = 0; for (const UMask * m : ms) n += m->rl.size(); a.d = n / ms.size() / s.rows; a.bytes = n / ms.size() * nb * 18; }
+    B.probe(a, r);
+}
+std::vector<const UMask *> of(const std::vector<UMask> & U, const char * subj) { std::vector<const UMask *> v; for (auto & m : U) if (m.ok && !strcmp(m.src->subj, subj)) v.push_back(&m); return v; }
+const char * const SUBJ38[3] = { "yi15-6b", "llama2-7b", "deepseek7b" };
+const std::vector<std::vector<int>> SETS38 = { { 4, 5, 6, 7 }, { 4 } };
+
+void masks_lines(Out & o, const std::vector<UMask> & U) {
+    for (const UMask & m : U) {
+        int mn = 99, mx = -1; for (int b = 0; b < m.in.nb; b++) { const int c = __builtin_popcount(m.in.mask[b]); mn = std::min(mn, c); mx = std::max(mx, c); }
+        o.line("ud mask subj=%s t=%d l=%d file16=%s ok=%d rows_kept=%.4f rows_list=%zu in_kept=%.4f in_blk_min=%d in_blk_mean=%.2f in_blk_max=%d k1_bytes_share=%.4f",
+               m.src->subj, m.src->t, m.src->l, m.src->file16, m.ok, m.rows_kept / (double) F38, m.rl.size(), m.in.kept / (double) F38, mn, m.in.kept / (double) m.in.nb, mx,
+               touched_bytes(m.in, 4096) / (4096.0 * F38 / QK * 18));
+    }
+}
+void udk1(Out & o) {
+    B38 B(o, "udk1"); const std::vector<UMask> U = umasks(); masks_lines(o, U);
+    const IdW I = idw(F38); int nk = 0, ok = 0; for (const UMask & m : U) if (m.ok) { nk++; ok += id_k1(I, m.in); }
+    o.line("ud identity blk=udk1 rows=256 k_in=%d k1_real=%d/%d", F38, ok, nk);
+    Arena A; if (!A.make()) { o.line("ud error=mmap blk=udk1 errno=%d", errno); return; }
+    const Sh s{ 4096, F38 }; const std::vector<bq8> x = rand_x(F38 / QK, false);
+    o.line("ud setup blk=udk1 shape=4096x%d arena_mb=%zu copies=%zu warm_s=%.1f meas_s=%.1f sets=4-7|4 setup_s=%.1f", F38, A.n >> 20, A.n / s.bytes(), W38, M38, secs(B.t0, clk::now()));
+    B.t0 = clk::now();
+    for (const auto & set : SETS38) {
+        B.set = set; parm(B, A, s, x, "stock");
+        for (const char * sj : SUBJ38) { parm(B, A, s, x, "k1", of(U, sj)); parm(B, A, s, x, "stock"); }
+        B.close();
+    }
+}
+void udr1(Out & o) {
+    B38 B(o, "udr1"); const std::vector<UMask> U = umasks(); masks_lines(o, U);
+    const IdW I = idw(4096); int nr = 0, ok = 0; for (const UMask & m : U) if (m.ok) { nr++; ok += id_rows(I, m.rl); }
+    o.line("ud identity blk=udr1 rows=256 k_in=4096 y1b=%d y1b_rows_real=%d/%d", (int) id_y1b(I), ok, nr);
+    Arena A; if (!A.make()) { o.line("ud error=mmap blk=udr1 errno=%d", errno); return; }
+    const Sh s{ F38, 4096 }; const std::vector<bq8> x = rand_x(4096 / QK, false);
+    o.line("ud setup blk=udr1 shape=%dx4096 arena_mb=%zu copies=%zu warm_s=%.1f meas_s=%.1f sets=4-7|4 setup_s=%.1f", F38, A.n >> 20, A.n / s.bytes(), W38, M38, secs(B.t0, clk::now()));
+    B.t0 = clk::now();
+    for (const auto & set : SETS38) {
+        B.set = set; parm(B, A, s, x, "stock"); parm(B, A, s, x, "y1b"); parm(B, A, s, x, "stock");
+        for (const char * sj : SUBJ38) { parm(B, A, s, x, "rows", of(U, sj)); parm(B, A, s, x, "stock"); }
+        B.close();
+    }
+}
+// ggml's own mat-vec with the weights in the named buffer type (128 MB of copies); false when the type is missing or declined
+bool gws(GB & g, WSet & ws, const char * name, const Sh & s, const std::vector<uint8_t> & tq) {
+    ggml_backend_buffer_type_t bt = nullptr; for (auto b : g.bufts) if (!strcmp(ggml_backend_buft_name(b), name)) bt = b;
+    if (!bt) return false;
+    const auto keep = g.bufts; g.bufts = { bt }; if (bt != keep.back()) g.bufts.push_back(keep.back());   // pick() then offers bt, else the plain buffer
+    const bool ok = make_wset(g, ws, GGML_TYPE_Q4_0, s.K, s.rows, (int) std::max<size_t>(5, ((size_t) 128 << 20) / s.bytes()), tq, 64);
+    g.bufts = keep; return ok && ws.buft == name;
+}
+void y1bd(Out & o) {
+    B38 B(o, "y1bd");
+    int ok = 0; for (int K : { 4096, F38 }) ok += id_y1b(idw(K));
+    o.line("ud identity blk=y1bd rows=256 k_in=4096,%d y1b=%d/2", F38, ok);
+    GB g; if (!g.init()) { o.line("ud error=no_cpu_backend blk=y1bd"); return; }
+    o.line("ud backend blk=y1bd %s", g.desc().c_str());
+    Arena A; if (!A.make()) { o.line("ud error=mmap blk=y1bd errno=%d", errno); return; }
+    o.line("ud setup blk=y1bd shapes=4096x4096,%dx4096,4096x%d arena_mb=%zu warm_s=%.1f meas_s=%.1f sets=4-7|4 ggml_mb=128 setup_s=%.1f", F38, F38, A.n >> 20, W38, M38, secs(B.t0, clk::now()));
+    B.t0 = clk::now();
+    const char * const GK[3] = { "CPU", "CPU_REPACK", "CPU_KLEIDIAI" }, * const GN[3] = { "ggml_plain", "ggml_repack", "ggml_kai" };
+    for (const Sh & s : { Sh{ 4096, 4096 }, Sh{ F38, 4096 }, Sh{ 4096, F38 } }) {
+        const std::vector<bq8> x = rand_x(s.K / QK, false); const std::vector<uint8_t> tq = templ(GGML_TYPE_Q4_0, s.K, 64);
+        const auto g0 = clk::now(); std::unique_ptr<WSet> ws[3];
+        for (int i = 0; i < 3; i++) { ws[i].reset(new WSet); if (!gws(g, *ws[i], GK[i], s, tq)) { o.line("ud skip blk=y1bd kern=%s rows=%d k_in=%d buft=%s got=%s", GN[i], s.rows, s.K, GK[i], ws[i]->buft.empty() ? "none" : ws[i]->buft.c_str()); ws[i].reset(); } }
+        o.line("ud ggml blk=y1bd rows=%d k_in=%d copies=%zu probe_copies=%zu make_s=%.1f", s.rows, s.K, std::max<size_t>(5, ((size_t) 128 << 20) / s.bytes()), A.n / s.bytes(), secs(g0, clk::now()));
+        for (const auto & set : SETS38) {
+            B.set = set; parm(B, A, s, x, "stock"); parm(B, A, s, x, "y1b"); parm(B, A, s, x, "stock");
+            for (int i = 0; i < 3; i++) {
+                if (!ws[i]) continue;
+                const GCell r = gtime(g, ws[i]->gf, set, W38, M38); const int nc = ggml_graph_n_nodes(ws[i]->gf);
+                AR a; a.kern = GN[i]; a.subj = "-"; a.rows = s.rows; a.K = s.K; a.bytes = (double) s.bytes(); a.mats = r.calls * nc; a.ms = a.mats ? r.secs * 1e3 / a.mats : -1;
+                B.emit(a, "-1/-1/-1", gline(r, set), ws[i]->buft);
+                parm(B, A, s, x, "stock");
+            }
+            B.close();
+        }
+    }
+}
+void r38(Out & o, const char * blk, const char * dir) {
+    FILE * live = nullptr; if (!o.tee && (live = fopen((std::string(dir) + "/x4-live-" + blk + ".txt").c_str(), "w"))) o.tee = live;
+    if (CAN_WS.empty()) { CAN_WS.resize((size_t) 256 << 10); fill_q4x4(CAN_WS.data(), CAN_WS.size()); init_x(); }
+    auto tl = [&](const char * when) { Therm t; o.line("ud therm blk=%s when=%s status=%s hr=%s thermal_pwrlevel=%s max_mhz=%s", blk, when, t.status().c_str(), t.hr().c_str(), kg("thermal_pwrlevel").c_str(), maxstr().c_str()); };
+    tl("before");
+    if (!strcmp(blk, "udk1")) udk1(o); else if (!strcmp(blk, "udr1")) udr1(o); else y1bd(o);
+    tl("after");
+    if (live) { o.tee = nullptr; fclose(live); }
+}
