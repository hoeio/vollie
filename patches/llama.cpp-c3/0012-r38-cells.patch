+// ---- identity on the phone (memcmp, 256 rows; weight scales as r32's identity: negative, -0, +0, subnormal, large)
+struct IdW { int N = 256, nb = 0; std::vector<bq4> w; std::vector<uint8_t> w4, wk; std::vector<bq8> x; std::vector<float> ys; };
+IdW idw(int K) {
+    IdW I; I.nb = K / QK; I.w.resize((size_t) I.N * I.nb);
+    for (auto & b : I.w) {
+        const uint32_t u = rnd() & 1023; float dv = 0.001f + 0.01f * (rnd() & 1023) / 1023.f; if (rnd() & 1) dv = -dv;
+        b.d = (__fp16) dv;
+        if (u < 10) b.d = (__fp16) -0.0f; else if (u < 15) b.d = (__fp16) 0.0f;
+        else if (u < 25) { uint16_t h = (uint16_t)((rnd() & 0x3ff) | (rnd() & 0x8000)); memcpy(&b.d, &h, 2); }
+        else if (u < 30) b.d = (__fp16)(dv * 4000.f);
+        for (auto & q : b.qs) q = (uint8_t) rnd();
+    }
+    I.w4.resize(I.w.size() * 18); I.wk.resize(I.w.size() * 18); to_4x4(I.w.data(), I.N, I.nb, I.w4.data()); to_k1(I.w.data(), I.N, I.nb, I.wk.data());
+    I.x = rand_x(I.nb, true); I.ys.resize(I.N); stock_n(I.w4.data(), I.N, I.nb, I.x.data(), I.ys.data());
+    return I;
+}
+bool id_k1(const IdW & I, Lists L) {   // K1 on the mask against stock fed x with the dropped inputs zeroed
+    std::vector<bq8> xz = I.x; std::vector<float> ys(I.N), yk(I.N, 1.f);
+    for (int b = 0; b < I.nb; b++) for (int j = 0; j < 32; j++) if (!(L.mask[b] >> j & 1)) xz[b].qs[j] = 0;
+    stock_n(I.w4.data(), I.N, I.nb, xz.data(), ys.data()); build_lists(L, I.x.data()); k1x<0>(I.wk.data(), I.nb, I.x.data(), L, yk.data(), 0, I.N / KT);
+    return !memcmp(ys.data(), yk.data(), 4 * (size_t) I.N);
+}
+bool id_y1b(const IdW & I) { std::vector<float> y(I.N); y1b((const uint8_t *) I.w.data(), I.N, I.nb, I.x.data(), y.data()); return !memcmp(y.data(), I.ys.data(), 4 * (size_t) I.N); }
+bool id_rows(const IdW & I, const std::vector<int> & rl) {   // the mask's rows below 256, cut to a multiple of 4
+    std::vector<int> r; for (int v : rl) if (v < I.N) r.push_back(v);
+    r.resize(r.size() & ~(size_t) 3); if (r.empty()) return false;
+    std::vector<float> y(r.size()); y1b_rows((const uint8_t *) I.w.data(), I.nb, I.x.data(), r.data(), (int) r.size(), y.data());
+    bool same = true; for (size_t q = 0; q < r.size(); q++) same &= !memcmp(&y[q], &I.ys[r[q]], 4);
+    return same;
+}
