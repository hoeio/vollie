+constexpr int F38 = 11008;
+std::vector<uint8_t> b64(const char * s) {
+    std::vector<uint8_t> o; uint32_t acc = 0; int nb = 0;
+    for (; *s; s++) {
+        const char c = *s; int v;
+        if (c >= 'A' && c <= 'Z') v = c - 'A'; else if (c >= 'a' && c <= 'z') v = c - 'a' + 26; else if (c >= '0' && c <= '9') v = c - '0' + 52;
+        else if (c == '+') v = 62; else if (c == '/') v = 63; else continue;
+        acc = acc << 6 | (uint32_t) v; nb += 6;
+        if (nb >= 8) { nb -= 8; o.push_back((uint8_t)(acc >> nb)); }
+    }
+    return o;
+}
+// one real mask: the down input list (K1's Lists over 344 blocks) and the gate row list (kept rows, sorted, cut to a multiple of 4)
+struct UMask { const UMaskSrc * src = nullptr; Lists in; std::vector<int> rl; int rows_kept = 0; bool ok = false; };
+std::vector<UMask> umasks() {
+    std::vector<UMask> v;
+    for (const UMaskSrc & s : UMASKS) {
+        UMask m; m.src = &s; const std::vector<uint8_t> b = b64(s.b64); const int nb = F38 / QK;
+        m.in.nb = nb; m.in.mask.assign(nb, 0); m.in.kc.assign((size_t) nb * 32, 0); m.in.nk.assign(nb, 0); m.in.sx.assign(nb, 0);
+        if ((m.ok = b.size() == 2 * F38 / 8))
+            for (int i = 0; i < F38; i++) {
+                if (b[i >> 3] >> (i & 7) & 1) { m.rows_kept++; m.rl.push_back(i); }
+                if (b[F38 / 8 + (i >> 3)] >> (i & 7) & 1) { m.in.mask[i / 32] |= 1u << (i % 32); m.in.nk[i / 32]++; m.in.kept++; }
+            }
+        m.rl.resize(m.rl.size() & ~(size_t) 3);
+        v.push_back(std::move(m));
+    }
+    return v;
+}
