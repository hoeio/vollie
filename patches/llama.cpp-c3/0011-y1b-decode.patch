+// vollie c3 0011 (B-T1, no numerics change): env VOLLIE_Y1B=1 (exactly "1", read once). Q4_0 mul_mat on plain rows
+// (extra buffers off, e.g. --no-repack) through the in-place 4-row kernel Y1b (memo-05 T2): per row XOR 0x88, shl 4 /
+// and 0xF0, two sdot, 3 addp for four rows, then the 4x4 repack gemv's float step, so each row equals the repack gemv
+// (and gemm) to the bit. Batches loop positions. Tail groups repeat the last row pointer and store only valid rows.
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD) && defined(__ARM_FEATURE_FP16_VECTOR_ARITHMETIC)
+#define VOLLIE_Y1B_BUILT 1
+static int vollie_y1b_on(void) {
+    static int on = -1;
+    if (on < 0) { const char * e = getenv("VOLLIE_Y1B"); on = e && strcmp(e, "1") == 0; }
+    return on;
+}
+static inline float32x4_t vollie_y1b4(int nb, const block_q4_0 * w0, const block_q4_0 * w1, const block_q4_0 * w2, const block_q4_0 * w3, const block_q8_0 * x) {
+    const int8x16_t m88 = vdupq_n_s8((int8_t) 0x88), mf0 = vdupq_n_s8((int8_t) 0xF0); const int32x4_t z = vdupq_n_s32(0); float32x4_t acc = vdupq_n_f32(0);
+    for (int b = 0; b < nb; b++) {
+        const int8x16_t a0 = vld1q_s8(x[b].qs), a1 = vld1q_s8(x[b].qs + 16);
+        const int8x16_t v0 = veorq_s8(vld1q_s8((const int8_t *) w0[b].qs), m88), v1 = veorq_s8(vld1q_s8((const int8_t *) w1[b].qs), m88);
+        const int8x16_t v2 = veorq_s8(vld1q_s8((const int8_t *) w2[b].qs), m88), v3 = veorq_s8(vld1q_s8((const int8_t *) w3[b].qs), m88);
+        const int32x4_t d0 = vdotq_s32(vdotq_s32(z, vshlq_n_s8(v0, 4), a0), vandq_s8(v0, mf0), a1);
+        const int32x4_t d1 = vdotq_s32(vdotq_s32(z, vshlq_n_s8(v1, 4), a0), vandq_s8(v1, mf0), a1);
+        const int32x4_t d2 = vdotq_s32(vdotq_s32(z, vshlq_n_s8(v2, 4), a0), vandq_s8(v2, mf0), a1);
+        const int32x4_t d3 = vdotq_s32(vdotq_s32(z, vshlq_n_s8(v3, 4), a0), vandq_s8(v3, mf0), a1);
+        const int32x4_t ret = vpaddq_s32(vpaddq_s32(d0, d1), vpaddq_s32(d2, d3));
+        float16x4_t bd = vld1_dup_f16((const __fp16 *) &w0[b].d);
+        bd = vld1_lane_f16((const __fp16 *) &w1[b].d, bd, 1); bd = vld1_lane_f16((const __fp16 *) &w2[b].d, bd, 2); bd = vld1_lane_f16((const __fp16 *) &w3[b].d, bd, 3);
+        acc = vfmaq_f32(acc, vcvtq_n_f32_s32(ret, 4), vmulq_f32(vcvt_f32_f16(vld1_dup_f16((const __fp16 *) &x[b].d)), vcvt_f32_f16(bd)));
+    }
+    return acc;
+}
+// rows [ir0, ir1) of src0 (row stride nb01) against one q8_0 column, into dst_col
+static void vollie_y1b_rows(int64_t ne00, const char * src0_row, size_t nb01, const void * src1_col, float * dst_col, int64_t ir0, int64_t ir1) {
+    const int nb = (int) (ne00 / QK8_0); const block_q8_0 * x = (const block_q8_0 *) src1_col;
+    for (int64_t r = ir0; r < ir1; r += 4) {
+        const block_q4_0 * w[4];
+        for (int i = 0; i < 4; i++) w[i] = (const block_q4_0 *) (src0_row + MIN(r + i, ir1 - 1) * nb01);
+        float t[4]; vst1q_f32(t, vollie_y1b4(nb, w[0], w[1], w[2], w[3], x));
+        memcpy(dst_col + r, t, MIN(4, ir1 - r) * sizeof(float));
+    }
+}
+#else
+static int vollie_y1b_on(void) { return 0; }
+#endif
