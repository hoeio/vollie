+// the parent side: run block blk in libvollie_x4c.so, kill it at timeout s, copy its x4 lines (other output as x4 childlog)
+void child(Out & o, const char * blk, const std::string & dir, double timeout) {
+    const std::string exe = self_dir() + "libvollie_x4c.so", lg = dir + "/x4-" + blk + ".out";
+    if (access(exe.c_str(), X_OK) != 0) { o.line("x4 child blk=%s rc=-1000 s=0 timeout=0 lines=0 reason=no_exe errno=%d", blk, errno); return; }
+    std::vector<std::string> env = { "VOLLIE_PROBE=1", "VOLLIE_PROBE_TEE=1" };
+#if defined(__ANDROID__)
+    env.push_back("LD_LIBRARY_PATH=" + self_dir() + ":/vendor/lib64:/system/lib64");
+#else
+    for (const char * k : { "PATH", "HOME", "OCL_ICD_VENDORS", "OCL_ICD_FILENAMES", "POCL_DEVICES" }) if (getenv(k)) env.push_back(std::string(k) + "=" + getenv(k));
