+    if (e) { o.line("x4 pk test=gemv ok=0 reason=alloc err=%d", e); }
+    else {
+        int base = 0; cl_int le = 0;
+        auto one = [&](int kind, int G, size_t i, H y) {   // kind 0 = q4n, 1 = q4p with G groups
+            H k = kind ? pk.q4p : pk.q4n; cl_int x1 = g.cl.SetKernelArg(k, 0, sizeof(H), &wb[i]); x1 |= g.cl.SetKernelArg(k, 1, sizeof(H), &xb); x1 |= g.cl.SetKernelArg(k, 2, sizeof(H), &y);
+            x1 |= g.cl.SetKernelArg(k, 3, 4, &nb);
+            if (kind) { x1 |= g.cl.SetKernelArg(k, 4, 4, &R); x1 |= g.cl.SetKernelArg(k, 5, sizeof(H), &cb); x1 |= g.cl.SetKernelArg(k, 6, 4, &base); base += R + G; }
