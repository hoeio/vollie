+// ---- x4c: stacked buffers on the general kernel (identity against float64; cold rate against the unstacked shape, ABBA-ish)
+void x4c(Gpu & g, Out & o, Therm & th, Kset & ks, const XIn & x4, H dst2) {
+    identity(g, o, ks, 22016, 4096, true, x4, dst2);
+    identity(g, o, ks, 12288, 4096, true, x4, dst2);
+    HMat h11, h22, h4, h12; make_hmat(h11, 11008, 4096); make_hmat(h22, 22016, 4096); make_hmat(h4, 4096, 4096); make_hmat(h12, 12288, 4096);
+    const double a1 = alone(g, o, th, ks, h11, true, true, x4, dst2), b1 = alone(g, o, th, ks, h22, true, true, x4, dst2);
+    const double c1 = alone(g, o, th, ks, h4, true, true, x4, dst2), d1 = alone(g, o, th, ks, h12, true, true, x4, dst2);
+    const double d2 = alone(g, o, th, ks, h12, true, true, x4, dst2), c2 = alone(g, o, th, ks, h4, true, true, x4, dst2);
+    const double b2 = alone(g, o, th, ks, h22, true, true, x4, dst2), a2 = alone(g, o, th, ks, h11, true, true, x4, dst2);
+    auto r = [](double x, double y, double u, double v) { return x > 0 && y > 0 && u > 0 && v > 0 ? (x + y) / (u + v) : -1; };
+    o.line("x4 stacksum gate_up_gbs=%.2f m11008_gbs=%.2f gate_up_vs_11008=%.3f qkv_gbs=%.2f m4096_gbs=%.2f qkv_vs_4096=%.3f", (b1 + b2) / 2, (a1 + a2) / 2, r(b1, b2, a1, a2),
+           (d1 + d2) / 2, (c1 + c2) / 2, r(d1, d2, c1, c2));
+}
