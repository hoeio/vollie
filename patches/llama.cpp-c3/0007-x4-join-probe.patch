+            }
+            g.cl.Finish(g.q); gb[c] = by / secs(m0, clk::now()) / 1e9;
+            o.line("x4 pk test=gemv kern=%s groups=%d m=%d k=%d copies=%d mb=%.1f launches=%ld gbs=%.2f err=%d", c ? "q4p" : "q4n", c ? Gs[c] : R, R, K, NC, NC * mb / 1048576.0, n, gb[c], le);
+        }
+        o.line("x4 pksum test=gemv q4n_gbs=%.2f q4p48_gbs=%.2f q4p192_gbs=%.2f q4p48_vs_q4n=%.3f q4p192_vs_q4n=%.3f same_rows=%d", gb[0], gb[1], gb[2], gb[0] > 0 ? gb[1] / gb[0] : -1,
+               gb[0] > 0 ? gb[2] / gb[0] : -1, same);
+    }
+    for (H b : wb) if (b) g.cl.ReleaseMemObject(b);
+    for (H b : { xb, yb, y2, cb }) if (b) g.cl.ReleaseMemObject(b);
