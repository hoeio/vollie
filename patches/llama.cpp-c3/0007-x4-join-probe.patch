+        o.line("x4 handoffarm pos=%d mode=%s joins=%ld joins_per_s=%.0f write_us=%.1f read_us=%.1f wall_us=%.1f checked=%ld matched=%ld err=%d %s", pos, modes[md], s.cpu_n,
+               s.cpu_s > 0 ? s.cpu_n / s.cpu_s : -1, wu, ru, au, nc, nh, ae, astr(s).c_str());
