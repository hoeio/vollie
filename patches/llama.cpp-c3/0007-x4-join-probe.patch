+void x4(Out & o, const char * blk, const char * dir) {
+    const bool kid = strstr(blk, "_c") != nullptr;
+    if (!kid) cond(o);
+    if (!strcmp(blk, "x4d")) { child(o, "x4d_c", dir, 30); return; }
+    if (!strcmp(blk, "x4e")) { child(o, "x4e1_c", dir, 9); child(o, "x4e2_c", dir, 9); child(o, "x4e3_c", dir, 12); return; }
+    Gpu g; if (!g.init()) { o.line("x4 error=%s", g.err.c_str()); return; }
+    XC.load(g);
+    if (!kid) info(g, o, "x4");
+    if (!strcmp(blk, "x4i")) x4i(g, o);
+    if (!strncmp(blk, "x4e", 3)) { x4e_c(g, o, blk[3] - '0'); return; }
+    const bool fresh = !strcmp(blk, "x4i");
+    if (fresh) {
+        o.line("x3 src file=gemv_noshuffle_q4_0_f32.cl bytes=%zu sha256=%s", strlen(SRC_GENERAL), sha256(SRC_GENERAL).c_str());
+        o.line("x3 src file=gemv_noshuffle_q4_0_f32_spec.cl bytes=%zu sha256=%s", strlen(SRC_SPEC), sha256(SRC_SPEC).c_str());
+    }
+    Kset ks; for (int i = 0; i < 4; i++) ks.p[i] = get_prog(g, o, dir, KERNS[i], fresh);
