+// optional entry points (OpenCL 1.1 / 1.2 / 2.0 and the qcom recording calls); a missing one is printed and its cell skipped
+struct CL4 {
+    cl_int (*Flush)(H) = nullptr; cl_int (*WaitForEvents)(cl_uint, const H *) = nullptr;
+    cl_int (*GetEventInfo)(H, cl_uint, size_t, void *, size_t *) = nullptr;
+    H (*CreateUserEvent)(H, cl_int *) = nullptr; cl_int (*SetUserEventStatus)(H, cl_int) = nullptr;
+    void * (*EnqueueMapBuffer)(H, H, cl_uint, cl_bitfield, size_t, size_t, cl_uint, const H *, H *, cl_int *) = nullptr;
+    cl_int (*EnqueueUnmapMemObject)(H, H, void *, cl_uint, const H *, H *) = nullptr;
+    cl_int (*EnqueueWriteBuffer)(H, H, cl_uint, size_t, size_t, const void *, cl_uint, const H *, H *) = nullptr;
+    void * (*SVMAlloc)(H, cl_bitfield, size_t, cl_uint) = nullptr; void (*SVMFree)(H, void *) = nullptr;
+    cl_int (*SetKernelArgSVMPointer)(H, cl_uint, const void *) = nullptr;
+    void * (*ExtAddr)(H, const char *) = nullptr;   // clGetExtensionFunctionAddressForPlatform
+    H (*NewRecording)(H, cl_int *) = nullptr; cl_int (*EndRecording)(H) = nullptr; cl_int (*ReleaseRecording)(H) = nullptr;
+    // cl_qcom_recordable_queues: queue, recording, then (count, array) for args, global offsets, global sizes, local sizes; then
+    // the wait list and event. Only empty arrays are passed (replay as recorded), so the arrays' layout does not matter.
+    cl_int (*EnqueueRecording)(H, H, size_t, const void *, size_t, const void *, size_t, const void *, size_t, const void *, cl_uint, const H *, H *) = nullptr;
+    std::string rec_how = "none";
+    void load(Gpu & g) {
+        void * l = g.cl.lib;
+#define S(f) *(void **) &f = dlsym(l, "cl" #f)
+        S(Flush); S(WaitForEvents); S(GetEventInfo); S(CreateUserEvent); S(SetUserEventStatus); S(EnqueueMapBuffer); S(EnqueueUnmapMemObject); S(EnqueueWriteBuffer); S(SVMAlloc); S(SVMFree); S(SetKernelArgSVMPointer);
+#undef S
+        *(void **) &ExtAddr = dlsym(l, "clGetExtensionFunctionAddressForPlatform");
+        H plat = nullptr; g.cl.GetDeviceInfo(g.dev, 0x1031 /*CL_DEVICE_PLATFORM*/, sizeof plat, &plat, nullptr);
+        auto get = [&](const char * n) -> void * { void * f = dlsym(l, n); if (f) { rec_how = "dlsym"; return f; } if (ExtAddr && plat && (f = ExtAddr(plat, n))) rec_how = "extaddr"; return f; };
+        *(void **) &NewRecording = get("clNewRecordingQCOM"); *(void **) &EndRecording = get("clEndRecordingQCOM");
+        *(void **) &ReleaseRecording = get("clReleaseRecordingQCOM"); *(void **) &EnqueueRecording = get("clEnqueueRecordingQCOM");
+        if (!NewRecording || !EndRecording || !EnqueueRecording) rec_how = "none";
+    }
+};
+CL4 XC;
+
+uint64_t ts_ns(H ev, Gpu & g, cl_uint w) { uint64_t v = 0; return g.cl.GetEventProfilingInfo(ev, w, 8, &v, nullptr) ? 0 : v; }
+struct St { uint64_t q = 0, s = 0, b = 0, e = 0; bool ok() const { return q && s >= q && b >= s && e >= b; } };   // QUEUED, SUBMIT, START, END (ns)
+St stamps(Gpu & g, H ev) { St t; t.q = ts_ns(ev, g, 0x1280); t.s = ts_ns(ev, g, 0x1281); t.b = ts_ns(ev, g, 0x1282); t.e = ts_ns(ev, g, 0x1283); return t; }
+double us(clk::time_point a, clk::time_point b) { return secs(a, b) * 1e6; }
+double pct(std::vector<double> v, double p) { if (v.empty()) return -1; std::sort(v.begin(), v.end()); return v[std::min(v.size() - 1, (size_t)(p * v.size()))]; }
+double mean(const std::vector<double> & v) { double s = 0; for (double x : v) s += x; return v.empty() ? -1 : s / v.size(); }
+
+// waits: 0 clFinish (as R74), 1 clFlush + spin on CL_EVENT_COMMAND_EXECUTION_STATUS, 2 clFlush + clWaitForEvents
+const char * WNAME[3] = { "finish", "spin", "wfe" };
+cl_int spin_ev(H ev) { cl_int st = 1, e = 0; do { e = XC.GetEventInfo(ev, 0x11D3, sizeof st, &st, nullptr); } while (!e && st > 0); return e ? e : st; }
+cl_int wait1(Gpu & g, H q, H ev, int w) {
+    if (w == 0 || !ev) return g.cl.Finish(q);
+    const cl_int e = XC.Flush(q); if (e) return e;
+    return w == 2 ? XC.WaitForEvents(1, &ev) : spin_ev(ev);
+}
+
+// clocks (CPU policies, GPU by any readable node) and the threads pinned to one of 4-7, sampled every 50 ms from a thread on 0-3
+struct Samp {
+    Mhz mz; GClk gc; TMon tm; std::atomic<int> stop{0}; std::thread t;
+    void start() { tm.start(); t = std::thread([this] { pin_cpus({ 0, 1, 2, 3 }); while (!stop.load()) { mz.sample(); gc.sample(); tm.sample(); sleep_s(0.05); } }); }
+    void end() { stop = 1; if (t.joinable()) t.join(); tm.stop(); }
+};
+// the launcher's own placement: sched_getcpu() checks off its set / checks @ the last other cpu
+struct Place { std::vector<int> set; long chk = 0, off = 0; int other = -1;
+    void check() { const int w = where(); chk++; if (w >= 0 && std::find(set.begin(), set.end(), w) == set.end()) { off++; other = w; } }
+    std::string str() const { char b[48]; snprintf(b, sizeof b, "%ld/%ld@%d", off, chk, other); return b; } };
+struct Lc { const char * name; std::vector<int> set; };
+const Lc L03 = { "0-3", { 0, 1, 2, 3 } }, L4 = { "4", { 4 } }, L7 = { "7", { 7 } };
+// pin the calling thread to the launcher set; spin: busy 0.5 s, then until the set's policy reads scaling_max (at most 2 s more)
+Ramp prep(const Lc & l, bool spin) {
+    pin_cpus(l.set);
+    return ramp(l.set, spin ? 0.5 : 0, spin ? 2.0 : 0, [] { volatile uint64_t z = 0; for (int i = 0; i < 2000; i++) z += i; });
+}
+std::string tail(Samp & s, Therm & th, const Ramp & rp, const Lc & l, double lcpu_s, double wall_s, long calls, const Place & pl) {
+    char b[1100];
+    snprintf(b, sizeof b, "lcpu=%s lcpu_us=%.1f lcpu_over_wall=%.3f lplace=%s thr=%s mhz_range=%s max_mhz=%s gpu_mhz=%s hr=%s ramp_s=%.2f ramp_ok=%d", l.name,
+             calls > 0 ? lcpu_s / calls * 1e6 : -1, wall_s > 0 ? lcpu_s / wall_s : -1, pl.str().c_str(), s.tm.thr().c_str(), s.mz.str().c_str(), maxstr().c_str(),
+             s.gc.str().c_str(), th.hr().c_str(), rp.s, rp.ok);
+    return b;
+}
+bool has(const std::string & ext, const char * e) { return (" " + ext + " ").find(std::string(" ") + e + " ") != std::string::npos; }
+
+// ---- x4i
+void x4i(Gpu & g, Out & o) {
+    const std::string ext = g.str(0x1030);
+    int n = 0; for (size_t i = 0; i < ext.size(); i++) if (ext[i] != ' ' && (i == 0 || ext[i - 1] == ' ')) n++;
+    o.line("x4 ext n=%d text=%s", n, san(ext, 12000).c_str());
+    uint64_t svm = 0, qp = 0, hqp = 0, tres = 0; cl_uint cu = 0; cl_int es = g.cl.GetDeviceInfo(g.dev, 0x1053, sizeof svm, &svm, nullptr);
+    g.cl.GetDeviceInfo(g.dev, 0x102A, sizeof qp, &qp, nullptr); g.cl.GetDeviceInfo(g.dev, 0x104E, sizeof hqp, &hqp, nullptr);
+    g.cl.GetDeviceInfo(g.dev, 0x1025, sizeof tres, &tres, nullptr); g.cl.GetDeviceInfo(g.dev, 0x1002, sizeof cu, &cu, nullptr);
+    o.line("x4 dev svm_err=%d svm_caps=0x%llx svm_coarse=%d svm_fine_buffer=%d svm_fine_system=%d svm_atomics=%d queue_props=0x%llx host_queue_props=0x%llx timer_res_ns=%llu compute_units=%u",
+           es, (unsigned long long) svm, (int)(svm & 1), (int)(svm >> 1 & 1), (int)(svm >> 2 & 1), (int)(svm >> 3 & 1), (unsigned long long) qp, (unsigned long long) hqp,
+           (unsigned long long) tres, cu);
+    if (has(ext, "cl_qcom_recordable_queues")) {
+        uint64_t v = 0; size_t rs = 0; const cl_int e = g.cl.GetDeviceInfo(g.dev, 0x41DE /*CL_DEVICE_RECORDABLE_QUEUE_MAX_SIZE*/, sizeof v, &v, &rs);
+        o.line("x4 recq present=1 max_size=%llu ret_bytes=%zu err=%d entry=%s", (unsigned long long) v, rs, e, XC.rec_how.c_str());
+    } else o.line("x4 recq present=0 entry=%s", XC.rec_how.c_str());
+    o.line("x4 entry flush=%d wait_for_events=%d event_info=%d user_event=%d map_buffer=%d svm_alloc=%d svm_arg=%d ext_addr=%d recording=%s", !!XC.Flush, !!XC.WaitForEvents,
+           !!XC.GetEventInfo, XC.CreateUserEvent && XC.SetUserEventStatus, !!XC.EnqueueMapBuffer, !!XC.SVMAlloc, !!XC.SetKernelArgSVMPointer, !!XC.ExtAddr, XC.rec_how.c_str());
+}
+
+// ---- x4a: launch timeline. One warm-up repetition, then 5 printed; times relative to the first QUEUED of the repetition (us)
+void x4a(Gpu & g, Out & o, Therm & th, Kset & ks, HMat * hm, const XIn & x4, const XIn & x11, H dst) {
+    if (!ks.p[0].k) { o.line("x4 tl ok=0 reason=no_kernel"); return; }
+    HMat h28; make_hmat(h28, 2816, 4096);
+    std::vector<GMat> b8(8), ly(7); const int hi[7] = { 0, 0, 0, 0, 2, 2, 3 }; const char * nm[7] = { "q", "k", "v", "o", "gate", "up", "down" };
+    std::vector<Prog *> pk(7); std::string ids; cl_int e = 0;
+    for (auto & m : b8) if (!e) e = up(g, m, h28);
+    for (int j = 0; j < 7 && !e; j++) { e = up(g, ly[j], hm[hi[j]]); const char * id; pk[j] = ks.pick(hm[hi[j]].M, hm[hi[j]].kin, false, &id); ids += std::string(j ? "," : "") + nm[j] + ":" + id; if (!pk[j]) e = -2; }
+    if (e) { o.line("x4 tl ok=0 err=%d", e); for (auto & m : b8) release(g, m); for (auto & m : ly) release(g, m); return; }
+    o.line("x4 tl setup batch=8x2816x4096 kern=general layer=llama2-7b kerns=%s queue=profiling", ids.c_str());
+    for (const Lc * lc : { &L03, &L4 }) {
+        Aff aff; const Ramp rp = prep(*lc, lc != &L03);
+        for (int cs = 0; cs < 3; cs++) {
+            const char * cname = cs == 0 ? "batch8" : cs == 1 ? "layer7" : "batch8flush"; const int n = cs == 1 ? 7 : 8;
+            Samp sm; sm.start(); Place pl; pl.set = lc->set; const double c0 = tcpu(); const auto w0 = clk::now();
+            std::vector<double> wall, enq, gap, gap_max, q2s0, s2b0, q2s1, s2b1, devsum, span; cl_int le = 0;
+            for (int rep = -1; rep < 5; rep++) {
+                H ev[8] = {}; double eu[8] = {}; const auto r0 = clk::now();
+                for (int j = 0; j < n; j++) {
+                    const auto a = clk::now();
+                    const cl_int x1 = cs == 1 ? launch(g, pk[j]->k, ly[j], hi[j] == 3 ? x11 : x4, dst, g.qp, &ev[j]) : launch(g, ks.p[0].k, b8[j], x4, dst, g.qp, &ev[j]);
+                    if (cs == 2) XC.Flush(g.qp);
+                    eu[j] = us(a, clk::now()); if (x1) { if (!le) le = x1; ev[j] = nullptr; }
+                    pl.check();
+                }
+                const cl_int fe = g.cl.Finish(g.qp); if (fe && !le) le = fe;
+                const double wr = us(r0, clk::now());
+                St t[8]; bool ok = true; for (int j = 0; j < n; j++) { if (ev[j]) t[j] = stamps(g, ev[j]); ok &= ev[j] && t[j].ok(); }
+                if (rep >= 0 && ok) {
+                    const uint64_t z = t[0].q; double ds = 0, gm = -1;
+                    for (int j = 0; j < n; j++) {
+                        const double gp = j ? ((double) t[j].b - (double) t[j - 1].e) * 1e-3 : -1; ds += (t[j].e - t[j].b) * 1e-3;
+                        o.line("x4 tl case=%s lcpu=%s rep=%d i=%d m=%d k=%d enq_us=%.1f queued_us=%.1f submit_us=%.1f start_us=%.1f end_us=%.1f dev_us=%.1f gap_us=%.1f",
+                               cname, lc->name, rep, j, cs == 1 ? ly[j].M : 2816, cs == 1 ? ly[j].kin : 4096, eu[j], (t[j].q - z) * 1e-3, (t[j].s - z) * 1e-3, (t[j].b - z) * 1e-3,
+                               (t[j].e - z) * 1e-3, (t[j].e - t[j].b) * 1e-3, gp);
+                        if (j) { gap.push_back(gp); gm = std::max(gm, gp); q2s1.push_back((t[j].s - t[j].q) * 1e-3); s2b1.push_back(((double) t[j].b - (double) t[j].s) * 1e-3); }
+                        enq.push_back(eu[j]);
+                    }
+                    q2s0.push_back((t[0].s - t[0].q) * 1e-3); s2b0.push_back((t[0].b - t[0].s) * 1e-3); devsum.push_back(ds); span.push_back((t[n - 1].e - z) * 1e-3);
+                    gap_max.push_back(gm); wall.push_back(wr);
+                } else if (rep >= 0) o.line("x4 tl case=%s lcpu=%s rep=%d ok=0 err=%d", cname, lc->name, rep, le);
+                for (H x : ev) if (x) g.cl.ReleaseEvent(x);
+            }
+            const double ws = secs(w0, clk::now()), lc_s = tcpu() - c0; sm.end();
+            o.line("x4 tlsum case=%s lcpu=%s reps=%zu launches=%d wall_us=%.1f enq_us=%.1f q2s_first_us=%.1f s2b_first_us=%.1f q2s_rest_p50_us=%.1f s2b_rest_p50_us=%.1f gap_p50_us=%.1f "
+                   "gap_mean_us=%.1f gap_max_us=%.1f dev_sum_us=%.1f span_us=%.1f busy=%.3f err=%d %s", cname, lc->name, wall.size(), n, mean(wall), mean(enq), pct(q2s0, 0.5),
+                   pct(s2b0, 0.5), pct(q2s1, 0.5), pct(s2b1, 0.5), pct(gap, 0.5), mean(gap), pct(gap_max, 1.0), mean(devsum), mean(span),
+                   mean(span) > 0 ? mean(devsum) / mean(span) : -1, le, tail(sm, th, rp, *lc, lc_s, ws, 6L * n, pl).c_str());
+        }
+    }
+    for (auto & m : b8) release(g, m);
+    for (auto & m : ly) release(g, m);
+}
+
+// ---- x4b / x4f: the rt cell. 0.8 s of launch + wait calls (the first 0.2 s not kept), then 100 profiled calls (same wait)
+struct Rt { double wall = -1, p50 = -1, p90 = -1, enq = -1, dev = -1, q2b = -1, s2b = -1, q2s = -1, lcpu = 0, ws = 0; long calls = 0; cl_int err = 0; };
+// args: 15 = launch() sets every argument; 2 = only the weight image and scale buffer change (two matrices alternate)
+Rt rtcell(Gpu & g, H k, GMat * m2, const XIn & x, H dst, int w, int args, Place & pl) {
+    Rt r; std::vector<double> wl, eq; const auto t0 = clk::now(); double c0 = -1; clk::time_point k0; long i = 0;
+    if (args == 2) launch(g, k, m2[0], x, dst, g.q, nullptr), g.cl.Finish(g.q);
+    const size_t gws[3] = { (size_t)((m2[0].M / 2 + 63) / 64) * 64, 4, 1 }, lws[3] = { 64, 4, 1 };
+    while (secs(t0, clk::now()) < 0.8) {
+        const bool keep = secs(t0, clk::now()) > 0.2; if (keep && c0 < 0) { c0 = tcpu(); k0 = clk::now(); }
+        const GMat & m = m2[args == 2 ? (i++ & 1) : 0]; H ev = nullptr; H * pe = w ? &ev : nullptr;
+        const auto a = clk::now(); cl_int x1;
+        if (args == 2) { x1 = g.cl.SetKernelArg(k, 0, sizeof(H), &m.img); x1 |= g.cl.SetKernelArg(k, 1, sizeof(H), &m.d); if (!x1) x1 = g.cl.EnqueueNDRangeKernel(g.q, k, 3, nullptr, gws, lws, 0, nullptr, pe); }
+        else x1 = launch(g, k, m, x, dst, g.q, pe);
+        const auto b = clk::now(); const cl_int x2 = x1 ? 0 : wait1(g, g.q, ev, w); if (ev) g.cl.ReleaseEvent(ev);
+        if ((x1 || x2) && !r.err) r.err = x1 ? x1 : x2;
+        if (keep) { wl.push_back(us(a, clk::now())); eq.push_back(us(a, b)); pl.check(); }
+    }
+    if (c0 >= 0) { r.lcpu = tcpu() - c0; r.ws = secs(k0, clk::now()); }
+    double dv = 0, q2b = 0, s2b = 0, q2s = 0; int n = 0;
+    for (int j = 0; j < 100; j++) {
+        H ev = nullptr; if (launch(g, k, m2[0], x, dst, g.qp, &ev) || !ev) continue;
+        wait1(g, g.qp, ev, w); const St t = stamps(g, ev); g.cl.ReleaseEvent(ev);
+        if (t.ok()) { dv += (t.e - t.b) * 1e-3; q2b += (t.b - t.q) * 1e-3; s2b += (t.b - t.s) * 1e-3; q2s += (t.s - t.q) * 1e-3; n++; }
+    }
+    r.calls = (long) wl.size(); r.wall = mean(wl); r.p50 = pct(wl, 0.5); r.p90 = pct(wl, 0.9); r.enq = mean(eq);
+    if (n) { r.dev = dv / n; r.q2b = q2b / n; r.s2b = s2b / n; r.q2s = q2s / n; }
+    return r;
+}
+std::string rtstr(const Rt & r) {
+    char b[400]; snprintf(b, sizeof b, "calls=%ld wall_us=%.1f p50_us=%.1f p90_us=%.1f enq_us=%.1f dev_us=%.1f ovh_us=%.1f queued_to_start_us=%.1f submit_to_start_us=%.1f queued_to_submit_us=%.1f err=%d",
+                          r.calls, r.wall, r.p50, r.p90, r.enq, r.dev, r.dev >= 0 ? r.wall - r.dev : -1, r.q2b, r.s2b, r.q2s, r.err);
+    return b;
+}
+void x4b(Gpu & g, Out & o, Therm & th, Kset & ks, const XIn & x4, H dst) {
+    if (!ks.p[0].k || !XC.Flush || !XC.GetEventInfo || !XC.WaitForEvents) { o.line("x4 rt ok=0 reason=%s", ks.p[0].k ? "no_entry" : "no_kernel"); return; }
+    HMat h; make_hmat(h, 2816, 4096); GMat m; const cl_int e = up(g, m, h);
+    if (e) { o.line("x4 rt ok=0 err=%d", e); release(g, m); return; }
+    const Lc * ls[4] = { &L03, &L4, &L7, &L03 };   // 0-3 again at the end: drift anchor (rep=1)
+    for (int li = 0; li < 4; li++) for (int w = 0; w < 3; w++) {
+        if (li == 3 && w) break;
+        Aff aff; const Ramp rp = prep(*ls[li], true); Samp sm; sm.start(); Place pl; pl.set = ls[li]->set;
+        const Rt r = rtcell(g, ks.p[0].k, &m, x4, dst, w, 15, pl); sm.end();
+        o.line("x4 rt rep=%d wait=%s kern=general m=2816 k=4096 %s %s", li == 3, WNAME[w], rtstr(r).c_str(), tail(sm, th, rp, *ls[li], r.lcpu, r.ws, r.calls, pl).c_str());
+    }
+    release(g, m);
+}
+void x4f(Gpu & g, Out & o, Therm & th, Kset & ks, const XIn & x4, H dst) {
+    if (!ks.p[0].k || !XC.Flush || !XC.GetEventInfo || !XC.CreateUserEvent || !XC.SetUserEventStatus) { o.line("x4 la ok=0 reason=%s", ks.p[0].k ? "no_entry" : "no_kernel"); return; }
+    HMat h; make_hmat(h, 2816, 4096); GMat m2[2]; cl_int e = up(g, m2[0], h); if (!e) e = up(g, m2[1], h);
+    if (e) { o.line("x4 la ok=0 err=%d", e); release(g, m2[0]); release(g, m2[1]); return; }
+    Aff aff; const Ramp rp = prep(L4, true);
+    { // (1) gate (behind a user event set about 1 ms after the enqueue) and plain, alternating, 50 each after 5 unprinted pairs
+        Samp sm; sm.start(); Place pl; pl.set = L4.set; const double c0 = tcpu(); const auto w0 = clk::now();
