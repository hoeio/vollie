+// ---- x4e (children): persistent kernels. f[0] CPU -> GPU, f[16] GPU -> CPU, f[32] the kernel's exit (separate 64 B lines).
+// Every kernel loop is bounded (cap), so a flag that is never seen ends the kernel instead of hanging the queue.
+const char * PK_SRC = R"x4cl(
+__kernel void pp(volatile __global int * f, int n, int cap) {          // ping-pong: wait for f[0] >= s, answer f[16] = s
+    int it = 0;
+    for (int s = 1; s <= n; s++) {
+        while (atomic_add(&f[0], 0) < s) { if (++it >= cap) { atomic_xchg(&f[32], -s); return; } }
+        atomic_xchg(&f[16], s);
+    }
+    atomic_xchg(&f[32], it + 1);
+}
+__kernel void ctr(volatile __global int * f, int n, int spin) {       // counter: f[16] = i, i = 1..n; f[0] < 0 stops it
+    for (int i = 1; i <= n; i++) {
+        atomic_xchg(&f[16], i);
+        for (int j = 0; j < spin; j++) if (atomic_add(&f[0], 0) < 0) { atomic_xchg(&f[32], -i); return; }
+    }
+    atomic_xchg(&f[32], n);
+}
+float rowdot(__global const uchar * w, __global const float * x, int r, int nb, int l) {
+    float acc = 0.f;
+    for (int b = l; b < nb; b += 64) {
+        __global const uchar * p = w + ((size_t) r * nb + b) * 18; const float d = vload_half(0, (__global const half *) p); float s = 0.f;
+        for (int j = 0; j < 16; j++) { const uchar q = p[2 + j]; s += ((int)(q & 15) - 8) * x[b * 32 + j] + ((int)(q >> 4) - 8) * x[b * 32 + j + 16]; }
+        acc += d * s;
+    }
+    return acc;
+}
+void reduce_store(__local float * red, int l, float v, __global float * y, int r) {
+    red[l] = v; barrier(CLK_LOCAL_MEM_FENCE);
+    for (int k = 32; k > 0; k >>= 1) { if (l < k) red[l] += red[l + k]; barrier(CLK_LOCAL_MEM_FENCE); }
+    if (l == 0) y[r] = red[0];
+}
+__kernel void q4n(__global const uchar * w, __global const float * x, __global float * y, int nb) {   // one work-group of 64 per row
+    __local float red[64]; const int l = get_local_id(0), r = get_group_id(0);
+    reduce_store(red, l, rowdot(w, x, r, nb, l), y, r);
+}
+__kernel void q4p(__global const uchar * w, __global const float * x, __global float * y, int nb, int rows, volatile __global int * c, int base) {
+    __local float red[64]; __local int row; const int l = get_local_id(0);   // fixed grid; each group claims the next row
+    for (;;) {
+        if (l == 0) row = atomic_inc(c) - base;
+        barrier(CLK_LOCAL_MEM_FENCE);
+        const int r = row; if (r >= rows) return;
+        reduce_store(red, l, rowdot(w, x, r, nb, l), y, r);
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+}
+)x4cl";
+// the same two flag kernels with OpenCL C 2.0 atomics (Ebony E-J8): atomic_int, acquire loads, release stores, all-SVM-devices
+// scope; built on their own (-cl-std=CL2.0, else CL3.0) so that a compiler without them costs only mode=svm_c11
+const char * PK11_SRC = R"x4cl(
+#define LD(p) atomic_load_explicit(p, memory_order_acquire, memory_scope_all_svm_devices)
+#define ST(p, v) atomic_store_explicit(p, v, memory_order_release, memory_scope_all_svm_devices)
+__kernel void pp11(__global atomic_int * f, int n, int cap) {
+    int it = 0;
+    for (int s = 1; s <= n; s++) {
+        while (LD(&f[0]) < s) { if (++it >= cap) { ST(&f[32], -s); return; } }
+        ST(&f[16], s);
+    }
+    ST(&f[32], it + 1);
+}
+__kernel void ctr11(__global atomic_int * f, int n, int spin) {
+    for (int i = 1; i <= n; i++) {
+        ST(&f[16], i);
+        for (int j = 0; j < spin; j++) if (LD(&f[0]) < 0) { ST(&f[32], -i); return; }
+    }
+    ST(&f[32], n);
+}
+)x4cl";
+struct PkProg { H prg = nullptr, pp = nullptr, ctr = nullptr, q4n = nullptr, q4p = nullptr; cl_int err = 0; std::string log;
+                H prg11 = nullptr, pp11 = nullptr, ctr11 = nullptr; cl_int err11 = 0; std::string log11; const char * opt11 = ""; };
+std::string blog(Gpu & g, H prg) {
+    size_t ln = 0; std::string l; g.cl.GetProgramBuildInfo(prg, g.dev, 0x1183, 0, nullptr, &ln);
+    if (ln > 1) { l.assign(ln, 0); g.cl.GetProgramBuildInfo(prg, g.dev, 0x1183, ln, &l[0], nullptr); l.resize(strlen(l.c_str())); }
+    return l;
+}
+void pk_build11(Gpu & g, PkProg & p) {
+    const char * s = PK11_SRC; const size_t n = strlen(s);
+    for (const char * opt : { "-cl-std=CL2.0", "-cl-std=CL3.0" }) {
+        if (p.prg11) { g.cl.ReleaseProgram(p.prg11); p.prg11 = nullptr; }
+        p.opt11 = opt; p.prg11 = g.cl.CreateProgramWithSource(g.ctx, 1, &s, &n, &p.err11); if (!p.prg11) return;
+        p.err11 = g.cl.BuildProgram(p.prg11, 1, &g.dev, opt, nullptr, nullptr);
+        p.log11 = blog(g, p.prg11); if (!p.err11) break;
+    }
+    if (p.err11) return;
+    cl_int e = 0; p.pp11 = g.cl.CreateKernel(p.prg11, "pp11", &e); p.ctr11 = g.cl.CreateKernel(p.prg11, "ctr11", &e);
+    if (!p.pp11 || !p.ctr11) p.err11 = e ? e : -1;
+}
+PkProg pk_build(Gpu & g) {
+    PkProg p; const char * s = PK_SRC; const size_t n = strlen(s);
+    p.prg = g.cl.CreateProgramWithSource(g.ctx, 1, &s, &n, &p.err); if (!p.prg) return p;
+    p.err = g.cl.BuildProgram(p.prg, 1, &g.dev, g.cstd == "CL2.0" ? "-cl-std=CL2.0" : "", nullptr, nullptr);
+    p.log = blog(g, p.prg);
+    if (p.err) return p;
+    cl_int e = 0; p.pp = g.cl.CreateKernel(p.prg, "pp", &e); p.ctr = g.cl.CreateKernel(p.prg, "ctr", &e); p.q4n = g.cl.CreateKernel(p.prg, "q4n", &e); p.q4p = g.cl.CreateKernel(p.prg, "q4p", &e);
+    if (!p.pp || !p.ctr || !p.q4n || !p.q4p) p.err = e ? e : -1;
+    return p;
+}
+// the flag memory: "hostptr" = ALLOC_HOST_PTR buffer kept mapped (zero copy), "svm" and "svm_c11" = fine-grain SVM (with atomics if offered)
+struct Flag { const char * mode; H buf = nullptr; void * svm = nullptr; volatile int * p = nullptr; cl_int err = 0; std::string why;
+    bool make(Gpu & g, const char * md) {
+        mode = md; const size_t sz = 4096;
+        if (!strcmp(md, "hostptr")) {
+            if (!XC.EnqueueMapBuffer) { why = "no_map_entry"; return false; }
+            buf = g.cl.CreateBuffer(g.ctx, (1 << 0) | (1 << 4), sz, nullptr, &err); if (!buf) { why = "create"; return false; }
+            p = (volatile int *) XC.EnqueueMapBuffer(g.q, buf, 1, (1 << 0) | (1 << 1), 0, sz, 0, nullptr, nullptr, &err); if (!p) { why = "map"; return false; }
+        } else {
+            uint64_t caps = 0; g.cl.GetDeviceInfo(g.dev, 0x1053, sizeof caps, &caps, nullptr);
+            if (!XC.SVMAlloc || !XC.SetKernelArgSVMPointer) { why = "no_svm_entry"; return false; }
+            if (!(caps & 2)) { char b[64]; snprintf(b, sizeof b, "no_fine_grain_buffer_caps_0x%llx", (unsigned long long) caps); why = b; return false; }
+            svm = XC.SVMAlloc(g.ctx, (1 << 0) | (1 << 10) | ((caps & 8) ? (1 << 11) : 0), sz, 0); if (!svm) { why = "svm_alloc"; return false; }
+            p = (volatile int *) svm;
+        }
+        for (int i = 0; i < 1024; i++) p[i] = 0;
+        __atomic_thread_fence(__ATOMIC_SEQ_CST);
+        return true;
+    }
+    cl_int arg(Gpu & g, H k) { return svm ? XC.SetKernelArgSVMPointer(k, 0, svm) : g.cl.SetKernelArg(k, 0, sizeof(H), &buf); }
+    void free_(Gpu & g) {
+        if (svm && XC.SVMFree) XC.SVMFree(g.ctx, svm);
+        if (buf && p && XC.EnqueueUnmapMemObject) { XC.EnqueueUnmapMemObject(g.q, buf, const_cast<int *>(p), 0, nullptr, nullptr); g.cl.Finish(g.q); }
+        if (buf) g.cl.ReleaseMemObject(buf);
+    }
+};
+int ld(volatile int * p) { return __atomic_load_n(p, __ATOMIC_ACQUIRE); }
+void st(volatile int * p, int v) { __atomic_store_n(p, v, __ATOMIC_RELEASE); }
+const double PK_DEADLINE = 2.0;   // the host side of every x4e test gives up after 2 s (the parent kills the child at 9 s for e1 and e2, three modes each, and 12 s for e3)
+// e1: n ping-pongs; first = flush -> first answer (includes the kernel's start); rtt = write s -> see answer s
+bool c11_ok(Out & o, PkProg & pk, const char * test, const char * md) {   // mode svm_c11 needs the C 2.0 program
+    if (strcmp(md, "svm_c11") || !pk.err11) return true;
+    o.line("x4 pk test=%s mode=%s ok=0 reason=build_c11 opt=%s err=%d log=%s", test, md, pk.opt11, pk.err11, san(pk.log11, 1500, '_').c_str());
+    return false;
+}
+void pk_flag(Gpu & g, Out & o, PkProg & pk, const char * md) {
+    if (!c11_ok(o, pk, "flag", md)) return;
+    H kp = strcmp(md, "svm_c11") ? pk.pp : pk.pp11;
+    Flag f; if (!f.make(g, md)) { o.line("x4 pk test=flag mode=%s ok=0 reason=%s err=%d", md, f.why.c_str(), f.err); f.free_(g); return; }
+    const int n = 200, cap = 20000000; cl_int e = f.arg(g, kp); e |= g.cl.SetKernelArg(kp, 1, 4, &n); e |= g.cl.SetKernelArg(kp, 2, 4, &cap);
+    const size_t one = 1; H ev = nullptr;
+    if (!e) e = g.cl.EnqueueNDRangeKernel(g.qp, kp, 1, nullptr, &one, &one, 0, nullptr, &ev);
+    if (!e) e = XC.Flush(g.qp);
+    if (e) { o.line("x4 pk test=flag mode=%s ok=0 reason=enqueue err=%d", md, e); if (ev) g.cl.ReleaseEvent(ev); f.free_(g); return; }
+    const auto t0 = clk::now(); std::vector<double> rtt; double first = -1; int seen = 0, tmo = 0;
+    for (int s = 1; s <= n; s++) {
+        const auto a = clk::now(); st(f.p, s);
+        while (ld(f.p + 16) < s && secs(t0, clk::now()) < PK_DEADLINE) {}
+        if (ld(f.p + 16) < s) { tmo = s; break; }
+        const double u = us(a, clk::now()); if (s == 1) first = us(t0, clk::now()); else rtt.push_back(u); seen = s;
+    }
+    st(f.p, 1 << 30);   // let a kernel that sees it finish at once
+    const cl_int fe = g.cl.Finish(g.qp); const int ex = ld(f.p + 32); const St t = stamps(g, ev); g.cl.ReleaseEvent(ev);
+    o.line("x4 pk test=flag mode=%s n=%d seen=%d timeout_at=%d first_us=%.1f rtt_p50_us=%.1f rtt_p90_us=%.1f rtt_min_us=%.1f kernel_exit=%d dev_ms=%.3f queued_to_start_us=%.1f err=%d ok=%d",
+           md, n, seen, tmo, first, pct(rtt, 0.5), pct(rtt, 0.9), pct(rtt, 0.0), ex, t.ok() ? (t.e - t.b) * 1e-6 : -1, t.ok() ? (t.b - t.q) * 1e-3 : -1, fe, seen == n ? 1 : 0);
