+    else if (!strcmp(blk, "x4f")) x4f(g, o, th, ks, x4, dst);
+    else if (!strcmp(blk, "x4c")) x4c(g, o, th, ks, x4, dst);
+    else if (!strcmp(blk, "x4m")) x4m(g, o, th, ks, x4);
+    else if (!strcmp(blk, "x4s")) x4s(g, o, th, ks, x4, dst);
+    else if (!strcmp(blk, "x4r")) res(g, o, ks, x4, dst, 1.5, "x4");
+    if (dst) g.cl.ReleaseMemObject(dst);
+    for (XIn * x : { &x4, &x11 }) { if (x->img) g.cl.ReleaseMemObject(x->img); if (x->b) g.cl.ReleaseMemObject(x->b); }
