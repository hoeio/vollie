+        else if (l.compare(0, 10, "c3-probe: ") && !l.empty()) other += l + "\n";
+    }
+    o.line("x4 child blk=%s rc=%d s=%.2f timeout=%d lines=%d", blk, c.rc, c.s, c.rc == -1001, n);
+    if (!other.empty()) o.line("x4 childlog blk=%s text=%s", blk, san(other, 2000, '_').c_str());
+}
