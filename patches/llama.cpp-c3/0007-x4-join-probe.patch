+    H yb = e ? nullptr : g.cl.CreateBuffer(g.ctx, 1 << 0, (size_t) R * 4, nullptr, &e), y2 = e ? nullptr : g.cl.CreateBuffer(g.ctx, 1 << 0, (size_t) R * 4, nullptr, &e);
