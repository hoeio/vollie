+        std::vector<float> a(R), b(R); g.cl.EnqueueReadBuffer(g.q, yb, 1, 0, (size_t) R * 4, a.data(), 0, nullptr, nullptr); g.cl.EnqueueReadBuffer(g.q, y2, 1, 0, (size_t) R * 4, b.data(), 0, nullptr, nullptr);
+        const int same = !le && !memcmp(a.data(), b.data(), (size_t) R * 4);
+        double gb[3] = { -1, -1, -1 }; const int Gs[3] = { 0, 48, 192 };
+        for (int c = 0; c < 3; c++) {
+            const auto t0 = clk::now(); clk::time_point m0; double by = 0; long n = 0; bool meas = false;
+            for (size_t i = 0;; i = (i + 1) % NC) {
+                if (!meas && secs(t0, clk::now()) > 0.3) { g.cl.Finish(g.q); meas = true; m0 = clk::now(); }
+                if (meas && secs(m0, clk::now()) > 1.0) break;
+                one(c ? 1 : 0, Gs[c], i, yb); if (i == NC - 1) g.cl.Finish(g.q);
