+// ---- x4d (child): recordable queue. One recording per layer of a 4-layer Llama-2 ring; ABBA plain sync1 / replay + clFinish,
+// from the feeder on 0-3 as R74's x3 layer; device time per layer from one profiled sweep
+void x4d_c(Gpu & g, Out & o, Therm & th, Kset & ks, HMat * hm, const XIn & x4, const XIn & x11, H dst) {
+    const std::string ext = g.str(0x1030);
+    if (!has(ext, "cl_qcom_recordable_queues")) { o.line("x4d skip reason=no_extension"); return; }
+    if (XC.rec_how == "none") { o.line("x4d skip reason=no_entry_points"); return; }
+    const int hi[7] = { 0, 0, 0, 0, 2, 2, 3 }; const int NL = 4; std::vector<GMat> m(NL * 7); std::vector<Prog *> pk(7); cl_int e = 0; double lb = 0;
+    for (int j = 0; j < 7; j++) { const char * id; pk[j] = ks.pick(hm[hi[j]].M, hm[hi[j]].kin, false, &id); if (!pk[j]) e = -2; lb += hm[hi[j]].bytes(); }
+    for (int i = 0; i < NL * 7 && !e; i++) e = up(g, m[i], hm[hi[i % 7]]);
+    if (e) { o.line("x4d skip reason=setup err=%d", e); for (auto & x : m) release(g, x); return; }
+    H rq = g.cl.CreateCommandQueue(g.ctx, g.dev, 1u << 30 /*CL_QUEUE_RECORDABLE_QCOM*/, &e);
+    if (!rq) { o.line("x4d skip reason=queue err=%d", e); for (auto & x : m) release(g, x); return; }
+    std::vector<H> rec(NL, nullptr); cl_int re = 0, ee = 0, le = 0;
+    for (int l = 0; l < NL; l++) {
+        rec[l] = XC.NewRecording(rq, &re); if (!rec[l]) break;
+        for (int j = 0; j < 7; j++) { const cl_int x1 = launch(g, pk[j]->k, m[l * 7 + j], hi[j] == 3 ? x11 : x4, dst, rq, nullptr); if (x1 && !le) le = x1; }
+        ee = XC.EndRecording(rec[l]); if (ee) break;
+    }
+    const bool rok = rec[NL - 1] && !re && !ee && !le;
+    H rqq = g.q; cl_int pe = rok ? XC.EnqueueRecording(g.q, rec[0], 0, nullptr, 0, nullptr, 0, nullptr, 0, nullptr, 0, nullptr, nullptr) : -1;
+    if (!pe) pe = g.cl.Finish(g.q);
+    cl_int pe2 = 0; if (rok && pe) { pe2 = XC.EnqueueRecording(rq, rec[0], 0, nullptr, 0, nullptr, 0, nullptr, 0, nullptr, 0, nullptr, nullptr); if (!pe2) pe2 = g.cl.Finish(rq); rqq = rq; }
+    o.line("x4 rec setup subj=llama2-7b layers_in_ring=%d layer_mb=%.1f new_err=%d end_err=%d launch_err=%d replay_plain_err=%d replay_recq_err=%d replay_queue=%s entry=%s ok=%d", NL,
+           lb / 1048576.0, re, ee, le, pe, pe2, rqq == g.q ? "plain" : "recq", XC.rec_how.c_str(), rok && (!pe || !pe2) ? 1 : 0);
+    if (rok && (!pe || !pe2)) {
+        size_t li = 0; cl_int xe = 0; double ms[2] = { 0, 0 }; const int order[4] = { 0, 1, 1, 0 };
+        for (int pos = 0; pos < 4; pos++) {
+            const int md = order[pos]; Arm a; a.warm = 0.5; a.meas = 1.0;
+            a.gpu = [&] {
+                if (md) { const cl_int x1 = XC.EnqueueRecording(rqq, rec[li], 0, nullptr, 0, nullptr, 0, nullptr, 0, nullptr, 0, nullptr, nullptr); if (x1 && !xe) xe = x1; g.cl.Finish(rqq); }
+                else { for (int j = 0; j < 7; j++) { const cl_int x1 = launch(g, pk[j]->k, m[li * 7 + j], hi[j] == 3 ? x11 : x4, dst, g.q, nullptr); if (x1 && !xe) xe = x1; } g.cl.Finish(g.q); }
+                li = (li + 1) % NL; return lb; };
+            const ARes s = run_arm(a, th); const double nl = s.gpu_b / lb, mpl = s.gpu_s * 1e3 / nl; ms[md] += mpl / 2;
+            o.line("x4 rec pos=%d mode=%s layers=%.0f ms_per_layer=%.3f gbs=%.2f err=%d %s", pos, md ? "replay" : "sync1", nl, mpl, s.ggbs(), xe, astr(s).c_str());
+        }
+        double dev = 0; int n = 0;
+        for (int l = 0; l < NL; l++) {
+            H ev[7] = {};
+            for (int j = 0; j < 7; j++) if (launch(g, pk[j]->k, m[l * 7 + j], hi[j] == 3 ? x11 : x4, dst, g.qp, &ev[j])) ev[j] = nullptr;
+            g.cl.Finish(g.qp); for (H x : ev) if (x) { dev += evs(g, x); g.cl.ReleaseEvent(x); } n++;
+        }
+        const double dms = dev * 1e3 / n, op = (ms[0] - dms) * 1e3 / 7, orr = (ms[1] - dms) * 1e3 / 7;
+        o.line("x4 recsum ms_sync1=%.3f ms_replay=%.3f dev_ms=%.3f ovh_us_per_launch_sync1=%.1f ovh_us_per_launch_replay=%.1f replay_vs_sync1=%.3f", ms[0], ms[1], dms, op, orr,
+               op > 0 ? orr / op : -1);
+    }
+    for (H r : rec) if (r && XC.ReleaseRecording) XC.ReleaseRecording(r);
+    g.cl.ReleaseCommandQueue(rq); for (auto & x : m) release(g, x);
+}
