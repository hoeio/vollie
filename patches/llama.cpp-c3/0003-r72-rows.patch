+        const int i4 = identity(4096, s.keep), i11 = identity(11008, s.keep); const int id[2] = { i4 & i11 & 1, (i4 & i11) >> 1 & 1 };
+        // bytes per layer: stock reads every matrix; the rule reads k, v whole and the kept columns (plus scales) of the rest
+        double bst = (double) lb, bru = 0; for (auto & x : M) bru += x.rule ? touched_bytes(Ls[x.in], x.rows) : (double) x.rows * (x.K / QK) * 18;
+        o.line("l4 identity subj=%s keep=%.2f k1=%d k1m=%d layers_in_arena=%d layer_mb=%.1f rule_layer_mb=%.1f d_in=%.3f/%.3f/%.3f/%.3f", s.name, s.keep, id[0], id[1], nl, bst / 1048576.0,
+               bru / 1048576.0, Ls[0].kept / 4096.0, Ls[1].kept / 4096.0, Ls[2].kept / 4096.0, Ls[3].kept / 11008.0);
+        for (const auto & set : sets) {
+            double sum[3] = { 0, 0, 0 };
+            const int order[6] = { 0, 1, 2, 2, 1, 0 };   // ABBA (A stock, B K1, C K1m: A B C C B A)
+            for (int k = 0; k < 6; k++) {
+                const int arm = order[k];
+                LRun r = run_layers(set, arm, a, lb, nl, M, xs, Ls, y, 0.5, 1.5);
+                sum[arm] += r.ms / 2;
+                const double by = arm ? bru : bst;
+                o.line("l4 subj=%s arm=%s pos=%d set=%s threads=%zu keep=%.2f layers=%ld ms_per_layer=%.3f body_ms=%.2f n_layer=%d gbs=%.2f cpu_ok=%d/%d thr=%s mhz=%s->%s mhz_range=%s %s",
+                       s.name, arms[arm], k, setname(set).c_str(), set.size(), arm ? s.keep : 1.0, r.layers, r.ms, r.ms * s.layers, s.layers, by / (r.ms * 1e6),
+                       r.c.cpu_ok, r.c.n, thr(r.c, set).c_str(), r.c.m0.c_str(), r.c.m1.c_str(), r.c.mz.str().c_str(), rampstr(r.c.rp).c_str());
+            }
+            o.line("l4sum subj=%s set=%s t_stock=%.3f t_k1=%.3f t_k1m=%.3f k1_vs_stock=%.3f k1m_vs_stock=%.3f body_ms_stock=%.2f body_ms_k1=%.2f body_ms_k1m=%.2f", s.name, setname(set).c_str(),
+                   sum[0], sum[1], sum[2], sum[1] / sum[0], sum[2] / sum[0], sum[0] * s.layers, sum[1] * s.layers, sum[2] * s.layers);
+        }
+        munmap(a, used);
+        // the same stock layer through a ggml graph (Q4_0 weights in the buffer llama picks), cold, as many layers as fit 1 GB
