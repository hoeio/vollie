+// ---- anonymous-memory capacity (bonnie-path.md D3): with repack on, the body lives in anonymous memory, not in the
+// file's pages. One anonymous arena of gb GB, filled with incompressible data by 3 threads, then read by 3 threads (4-6)
+// for 20 passes or 45 s, with P1's counters; the header again at the end (PSI and zram after the arm)
+void anon(Out & o, double gb) {
+    const size_t n = (size_t)(gb * 1e9) & ~(size_t) 4095;
+    o.line("anon n=%.1f memavail_kb=%ld swapfree_kb=%ld", gb, kv("/proc/meminfo", "MemAvailable"), kv("/proc/meminfo", "SwapFree"));
+    uint8_t * m = (uint8_t *) mmap(nullptr, n, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (m == MAP_FAILED) { o.line("anon n=%.1f error=mmap errno=%d", gb, errno); return; }
+    auto set = cores("4-6"); long f0 = majflt(); auto t0 = clk::now();
+    { std::vector<std::thread> th;
+      for (int i = 0; i < 3; i++) th.emplace_back([&, i] {
+          pin(set[i]); uint64_t s = 0x9e3779b97f4a7c15ull * (i + 1); uint64_t * p = (uint64_t *)(m + i * (n / 3)); const size_t c = (n / 3) / 8;
+          for (size_t k = 0; k < c; k++) { s ^= s << 13; s ^= s >> 7; s ^= s << 17; p[k] = s; }
+      });
+      for (auto & t : th) t.join(); }
+    o.line("anon n=%.1f fill_s=%.1f majflt=%ld vmrss_kb=%ld vmswap_kb=%ld swapfree_kb=%ld", gb, secs(t0, clk::now()), majflt() - f0, kv("/proc/self/status", "VmRSS"),
+           kv("/proc/self/status", "VmSwap"), kv("/proc/meminfo", "SwapFree"));
+    const auto a0 = clk::now();
+    for (int pass = 0; pass < 20 && secs(a0, clk::now()) < 45; pass++) {
+        long g0 = majflt(); rusage r0; getrusage(RUSAGE_SELF, &r0); auto p0 = clk::now(); std::vector<std::thread> th;
+        for (int i = 0; i < 3; i++) th.emplace_back([&, i] {
+            pin(set[i]); const uint8_t * p = m + i * (n / 3); uint64x2_t acc = vdupq_n_u64(0);
+            for (size_t k = 0; k + 64 <= n / 3; k += 64) acc = vaddq_u64(acc, vaddq_u64(vld1q_u64((const uint64_t *)(p + k)), vld1q_u64((const uint64_t *)(p + k + 32))));
+            volatile uint64_t sink = vgetq_lane_u64(acc, 0); (void) sink;
+        });
+        for (auto & t : th) t.join();
+        const double sec = secs(p0, clk::now()); rusage r1; getrusage(RUSAGE_SELF, &r1);
+        o.line("anon n=%.1f pass=%d s=%.3f gbs=%.2f majflt=%ld minflt=%ld cached=%ld swapfree=%ld vmswap=%ld vmrss=%ld", gb, pass, sec, n / sec / 1e9, majflt() - g0,
+               r1.ru_minflt - r0.ru_minflt, kv("/proc/meminfo", "Cached"), kv("/proc/meminfo", "SwapFree"), kv("/proc/self/status", "VmSwap"), kv("/proc/self/status", "VmRSS"));
+    }
+    munmap(m, n);
+    hdr(o);
+    o.line("anon n=%.1f done", gb);
+}
