+// ---- K1 family (tools/c3_k1v_bench.c, bit-identical there and checked again below): per-call kept lists from a
+// 32-bit mask per block, then the tile kernel on tiles [t0, t1). MODE 0 = K1 (0002's kernel; the kept x sum is in the
+// lists), 1 = K1m (SSHLL + ADD magic + FSUB instead of SCVTF), 4 = k1m4 (SADDW + FSUB, and the fp16 scale by SSHLL #13 +
+// BIC instead of FCVTL, with dx * 2^112).
+struct Lists { int nb = 0; std::vector<uint32_t> mask; std::vector<uint8_t> kc; std::vector<int> nk, sx; long kept = 0; };
+Lists mklists(int nb, double keep) {
+    Lists L; L.nb = nb; L.mask.assign(nb, 0); L.kc.assign((size_t) nb * 32, 0); L.nk.assign(nb, 0); L.sx.assign(nb, 0);
+    for (int b = 0; b < nb; b++) for (int j = 0; j < 32; j++) if ((rnd() & 0xffff) < keep * 65536) { L.mask[b] |= 1u << j; L.kept++; }
+    return L;
+}
+void build_lists(Lists & L, const bq8 * x) {
+    for (int b = 0; b < L.nb; b++) {
+        uint32_t m = L.mask[b]; int n = 0, s = 0; uint8_t * kc = L.kc.data() + (size_t) b * 32;
+        while (m) { const int j = __builtin_ctz(m); m &= m - 1; kc[n++] = (uint8_t) j; s += x[b].qs[j]; }
+        L.nk[b] = n; L.sx[b] = s;
+    }
+}
+template <int MODE> void k1x(const uint8_t * w, int nb, const bq8 * x, const Lists & Ls, float * y, int t0, int t1) {
+    const uint8x16_t m4 = vdupq_n_u8(15); const int32x4_t vmagic0 = vdupq_n_s32(0x4B400000); const float32x4_t vmagf0 = vdupq_n_f32(12582912.0f);
+    for (int t = t0; t < t1; t++) {
+        float * af = y + (size_t) t * KT;
+        for (int i = 0; i < KT; i += 4) vst1q_f32(af + i, vdupq_n_f32(0));
+        for (int b = 0; b < nb; b++) {
+            const int nk = Ls.nk[b]; if (!nk) continue;
+            const uint8_t * p = w + ((size_t) t * nb + b) * KB; const __fp16 * d = (const __fp16 *) p; const uint8_t * col = p + KT * 2;
+            const uint8_t * kc = Ls.kc.data() + (size_t) b * 32;
+            const int16x8_t corr = vdupq_n_s16((int16_t)(8 * Ls.sx[b]));
+            const float32x4_t vdx = vdupq_n_f32(MODE == 4 ? (float) x[b].d * 0x1p112f : (float) x[b].d);
+            int16x8_t a[16];
+#pragma clang loop unroll(full)
+            for (int i = 0; i < 16; i++) a[i] = vdupq_n_s16(0);
+            for (int q = 0; q < nk; q++) {
+                const int j = kc[q]; const int8x16_t xv = vdupq_n_s8(x[b].qs[j]); const int8x8_t xh = vget_low_s8(xv); const uint8_t * c = col + j * 64;
+#pragma clang loop unroll(full)
+                for (int L = 0; L < 4; L++) {
+                    const uint8x16_t v = vld1q_u8(c + 16 * L);
+                    const int8x16_t lo = vreinterpretq_s8_u8(vandq_u8(v, m4)), hi = vreinterpretq_s8_u8(vshrq_n_u8(v, 4));
+                    a[4 * L + 0] = vmlal_s8(a[4 * L + 0], vget_low_s8(lo), xh); a[4 * L + 1] = vmlal_high_s8(a[4 * L + 1], lo, xv);
+                    a[4 * L + 2] = vmlal_s8(a[4 * L + 2], vget_low_s8(hi), xh); a[4 * L + 3] = vmlal_high_s8(a[4 * L + 3], hi, xv);
+                }
+            }
+            int32x4_t vmagic = vmagic0; float32x4_t vmagf = vmagf0; __asm__ volatile("" : "+w"(vmagic), "+w"(vmagf));   // keep the constants in registers
+#pragma clang loop unroll(full)
+            for (int i = 0; i < 16; i++) {   // register i = rows 8i .. 8i+7 of the tile
+                const int16x8_t v = vsubq_s16(a[i], corr); float32x4_t pl, ph, fl, fh;
+                if (MODE == 4) {
+                    const int16x8_t h = vld1q_s16((const int16_t *)(d + 8 * i));
+                    pl = vmulq_f32(vdx, vreinterpretq_f32_s32(vbicq_s32(vshll_n_s16(vget_low_s16(h), 13), vdupq_n_s32(0x70000000))));
+                    ph = vmulq_f32(vdx, vreinterpretq_f32_s32(vbicq_s32(vshll_high_n_s16(h, 13), vdupq_n_s32(0x70000000))));
+                } else {
+                    const float16x8_t dw = vld1q_f16(d + 8 * i); pl = vmulq_f32(vdx, vcvt_f32_f16(vget_low_f16(dw))); ph = vmulq_f32(vdx, vcvt_high_f32_f16(dw));
+                }
+                if (MODE == 0) { fl = vcvtq_f32_s32(vmovl_s16(vget_low_s16(v))); fh = vcvtq_f32_s32(vmovl_high_s16(v)); }
+                else if (MODE == 1) {
+                    fl = vsubq_f32(vreinterpretq_f32_s32(vaddq_s32(vmovl_s16(vget_low_s16(v)), vmagic)), vmagf);
+                    fh = vsubq_f32(vreinterpretq_f32_s32(vaddq_s32(vmovl_high_s16(v), vmagic)), vmagf);
+                } else {
+                    fl = vsubq_f32(vreinterpretq_f32_s32(vaddw_s16(vmagic, vget_low_s16(v))), vmagf);
+                    fh = vsubq_f32(vreinterpretq_f32_s32(vaddw_high_s16(vmagic, v)), vmagf);
+                }
+                vst1q_f32(af + 8 * i, vfmaq_f32(vld1q_f32(af + 8 * i), fl, pl)); vst1q_f32(af + 8 * i + 4, vfmaq_f32(vld1q_f32(af + 8 * i + 4), fh, ph));
+            }
+        }
+    }
+}
+typedef void (*colfn)(const uint8_t *, int, const bq8 *, const Lists &, float *, int, int);
+const char * const KNAME[3] = { "k1", "k1m", "k1m4" };
+const colfn KFN[3] = { k1x<0>, k1x<1>, k1x<4> };
+
+// layouts from the file's row blocks (as the bench)
+void to_4x4(const bq4 * w, int N, int nb, uint8_t * out) {
+    for (int r = 0; r < N; r += 4) for (int b = 0; b < nb; b++) {
+        bq4x4 * o = (bq4x4 *) out + (size_t)(r / 4) * nb + b;
+        for (int k = 0; k < 4; k++) o->d[k] = w[(size_t)(r + k) * nb + b].d;
+        for (int i = 0; i < 16; ++i) { uint32_t e; memcpy(&e, &w[(size_t)(r + i % 4) * nb + b].qs[(i / 4) * 4], 4); e ^= 0x88888888u; memcpy(&o->qs[i * 4], &e, 4); }
+    }
+}
+void to_k1(const bq4 * w, int N, int nb, uint8_t * out) {
+    for (int t = 0; t < N / KT; t++) for (int b = 0; b < nb; b++) {
+        uint8_t * p = out + ((size_t) t * nb + b) * KB; __fp16 * d = (__fp16 *) p; uint8_t * col = p + KT * 2;
+        for (int r = 0; r < KT; r++) d[r] = w[(size_t)(t * KT + r) * nb + b].d;
+        for (int j = 0; j < 32; j++) for (int k = 0; k < 64; k++) {
+            const int r0 = t * KT + (k / 16) * 32 + k % 16; const bq4 & lo = w[(size_t) r0 * nb + b], & hi = w[(size_t)(r0 + 16) * nb + b];
+            const uint8_t ql = j < 16 ? lo.qs[j] & 15 : lo.qs[j - 16] >> 4, qh = j < 16 ? hi.qs[j] & 15 : hi.qs[j - 16] >> 4;
+            col[j * 64 + k] = ql | (qh << 4);
+        }
+    }
+}
+std::vector<bq8> rand_x(int nb, bool adversarial) {   // adversarial: some dx = 0 and some dx = 60000 blocks (the bench's)
+    std::vector<bq8> x(nb);
+    for (int b = 0; b < nb; b++) {
+        x[b].d = (__fp16)(0.01f + 0.02f * (rnd() & 1023) / 1023.f);
+        if (adversarial && b % 97 == 5) x[b].d = (__fp16) 0.0f;
+        if (adversarial && b % 89 == 7) x[b].d = (__fp16) 60000.f;
+        for (auto & q : x[b].qs) q = (int8_t)((int)(rnd() % 255) - 127);
+    }
+    return x;
+}
+// identity on the phone: each kernel against stock 4x4 fed the same x with the dropped inputs zeroed (memcmp), 256 rows;
+// weight scales as the bench: negative, -0, +0, subnormal and large values. bit v set = kernel v equal.
+int identity(int K, double keep) {
+    const int N = 256, nb = K / QK; std::vector<bq4> w((size_t) N * nb);
+    for (auto & b : w) {
+        const uint32_t u = rnd() & 1023; float dv = 0.001f + 0.01f * (rnd() & 1023) / 1023.f; if (rnd() & 1) dv = -dv;
+        b.d = (__fp16) dv;
+        if (u < 10) b.d = (__fp16) -0.0f; else if (u < 15) b.d = (__fp16) 0.0f;
+        else if (u < 25) { uint16_t h = (uint16_t)((rnd() & 0x3ff) | (rnd() & 0x8000)); memcpy(&b.d, &h, 2); }
+        else if (u < 30) b.d = (__fp16)(dv * 4000.f);
+        for (auto & q : b.qs) q = (uint8_t) rnd();
+    }
+    std::vector<bq8> x = rand_x(nb, true), xz = x; Lists L = mklists(nb, keep);
+    for (int b = 0; b < nb; b++) for (int j = 0; j < 32; j++) if (!(L.mask[b] >> j & 1)) xz[b].qs[j] = 0;
+    std::vector<uint8_t> w4((size_t) N * nb * 18), wk((size_t) N * nb * 18); to_4x4(w.data(), N, nb, w4.data()); to_k1(w.data(), N, nb, wk.data());
+    std::vector<float> ys(N), yk(N); stock_n(w4.data(), N, nb, xz.data(), ys.data());
+    int id = 0;
+    for (int v = 0; v < 3; v++) { std::fill(yk.begin(), yk.end(), 1.f); build_lists(L, x.data()); KFN[v](wk.data(), nb, x.data(), L, yk.data(), 0, N / KT); if (!memcmp(ys.data(), yk.data(), 4 * N)) id |= 1 << v; }
+    return id;
+}
+double touched_bytes(const Lists & L, int rows) { double by = 0; for (int b = 0; b < L.nb; b++) if (L.nk[b]) by += KT * 2 + 64.0 * L.nk[b]; return by * (rows / KT); }
+void fix_k1_scales(uint8_t * a, size_t n) { fix_scales(a, n, sizeof(bq4x4), 4); fix_scales(a, n, KB, KT); }   // both layouts' scales finite
+
+// ---- L1: K1, K1m, k1m4 at the subjects' shapes on one A78 (cpu 4) and the X1 (cpu 7)
+void l1(Out & o) {
+    const double keeps[6] = { 1.0, 0.666, 0.65, 0.60, 0.58, 0.50 };   // 0.666 / 0.65: the Llama-2 and DeepSeek body densities (R69 result)
+    for (int K : { 4096, 11008 }) for (double kp : { 1.0, 0.60, 0.58 }) {
+        const int id = identity(K, kp);
+        o.line("l1 identity k_in=%d keep=%.2f rows=256 k1=%d k1m=%d k1m4=%d", K, kp, id & 1, (id >> 1) & 1, (id >> 2) & 1);
+    }
+    const size_t AR = (size_t) 512 << 20; uint8_t * a = (uint8_t *) mmap(nullptr, AR, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (a == MAP_FAILED) { o.line("l1 error=mmap errno=%d", errno); return; }
+    fill(a, AR); fix_k1_scales(a, AR);
+    std::vector<float> y(1024);
+    for (int K : { 4096, 11008 }) {
+        const int nb = K / QK; const size_t rb = (size_t) nb * 18; std::vector<bq8> xs = rand_x(nb, false);
+        std::vector<Lists> Ls; for (double kp : keeps) { Ls.push_back(mklists(nb, kp)); build_lists(Ls.back(), xs.data()); }
+        for (int cpu : { 4, 7 }) for (int cold = 0; cold < 2; cold++) {
+            // hot: one 128-row tile (288 KB at 4096 inputs, 774 KB at 11008), repeated; cold: 1024-row matrices through 512 MB
+            const int rows = cold ? 1024 : KT; const size_t mb = rows * rb, nm = cold ? AR / mb : 1;
+            const size_t l2 = cpu == 7 ? (1u << 20) : (512u << 10);
+            const char * regime = cold ? "cold" : mb + (size_t) nb * 34 <= l2 ? "hot" : "l3";   // a tile larger than the core's L2 is served by the L3
+            const std::vector<int> set{ cpu };
+            struct R { std::string kern; double keep, d, ns, gbs; Cell2 c; };
+            std::vector<R> rs;
+            auto run = [&](const char * kern, double keep, double d, double bytes, double units, const std::function<void(const uint8_t *)> & f) {
+                size_t g = 0;
+                Cell2 c = cell2(set, [&](int, int, double & b, double & u) { f(a + g * mb); g = (g + 1) % nm; b += bytes; u += units; }, 0.5, 1.0);
+                rs.push_back({ kern, keep, d, c.secs * 1e9 / c.units, c.gbs, c });
+            };
+            auto stock = [&] { run("stock", 1.0, 1.0, (double) mb, (double) rows * K, [&](const uint8_t * m) { stock_n(m, rows, nb, xs.data(), y.data()); }); };
+            stock();
+            for (int s = 0; s < 6; s++) for (int v = 0; v < 3; v++) {
+                Lists & L = Ls[s];
+                run(KNAME[v], keeps[s], L.kept / (double) K, touched_bytes(L, rows), (double) L.kept * rows,
+                    [&, v](const uint8_t * m) { build_lists(L, xs.data()); KFN[v](m, nb, xs.data(), L, y.data(), 0, rows / KT); });
+            }
+            run("lists", 0.60, Ls[3].kept / (double) K, 0, (double) Ls[3].kept * rows, [&](const uint8_t *) { build_lists(Ls[3], xs.data()); });
+            stock();   // stock before and after; k is against their mean, drift = after / before
+            const double st = (rs.front().ns + rs.back().ns) / 2;
+            for (size_t i = 0; i < rs.size(); i++) {
+                const R & r = rs[i]; const bool s = r.kern == "stock";
+                o.line("l1 kern=%s%s k_in=%d rows=%d regime=%s ws_kb=%zu keep=%.3f d=%.3f cpu=%d ns_per_touched_w=%.4f stock_ns_per_w=%.4f k=%.3f t_vs_stock=%.3f%s gbs=%.2f cpu_ok=%d/%d thr=%s mhz=%s->%s mhz_range=%s %s",
+                       r.kern.c_str(), s ? (i ? "_after" : "_before") : "", K, rows, regime, mb >> 10, r.keep, r.d, cpu, r.ns, st, r.ns / st, r.ns / st * r.d,
+                       s && i ? (" drift=" + std::to_string(rs.back().ns / rs.front().ns)).c_str() : "", r.gbs, r.c.cpu_ok, r.c.n, thr(r.c, set).c_str(),
+                       r.c.m0.c_str(), r.c.m1.c_str(), r.c.mz.str().c_str(), rampstr(r.c.rp).c_str());
+            }
+        }
+    }
+    munmap(a, AR);
+}
