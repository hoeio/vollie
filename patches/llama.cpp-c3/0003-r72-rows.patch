+// ======== 0003 (kit r32): rows L1 to L7 of memo-08-work/clyde-r72-plan.md, the anonymous-memory arm, the anchors
+namespace r32 {
+
+// ---- timing helpers: per-thread CPU time against wall time and context switches (ebony-paths.md §12), clock range
+double tcpu() { timespec t; clock_gettime(CLOCK_THREAD_CPUTIME_ID, &t); return t.tv_sec + t.tv_nsec * 1e-9; }
+void csw(long & iv, long & v, bool self) {   // involuntary / voluntary switches of this thread (self: the process)
+    rusage r;
+#if defined(__linux__)
+    getrusage(self ? RUSAGE_SELF : RUSAGE_THREAD, &r); iv = r.ru_nivcsw; v = r.ru_nvcsw;
+#else
+    if (!self) { iv = v = -1; return; }
+    getrusage(RUSAGE_SELF, &r); iv = r.ru_nivcsw; v = r.ru_nvcsw;
+#endif
+}
+double proc_cpu() { rusage r; getrusage(RUSAGE_SELF, &r); return r.ru_utime.tv_sec + r.ru_utime.tv_usec * 1e-6 + r.ru_stime.tv_sec + r.ru_stime.tv_usec * 1e-6; }
+long khz(int p) {
+    char path[96]; snprintf(path, sizeof path, "/sys/devices/system/cpu/cpufreq/policy%d/scaling_cur_freq", p);
+    FILE * f = fopen(path, "r"); long v = -1000; if (f) { if (fscanf(f, "%ld", &v) != 1) v = -1000; fclose(f); }
+    return v;
+}
+struct Mhz {   // the range of each policy's clock (A55 / A78 / X1) over the samples taken during a cell
+    long lo[3] = { LONG_MAX, LONG_MAX, LONG_MAX }, hi[3] = { LONG_MIN, LONG_MIN, LONG_MIN }; int n = 0;
+    void sample() { const int p[3] = { 0, 4, 7 }; for (int i = 0; i < 3; i++) { long v = khz(p[i]) / 1000; lo[i] = std::min(lo[i], v); hi[i] = std::max(hi[i], v); } n++; }
+    std::string str() const {
+        if (!n) return "none";
+        char b[96]; snprintf(b, sizeof b, "%ld/%ld/%ld..%ld/%ld/%ld,n=%d", lo[0], lo[1], lo[2], hi[0], hi[1], hi[2], n); return b;
+    }
+};
+// clock ramp (R69: 25 of 26 cells ran below full clocks): after the base warm-up, keep warming until every policy the set
+// uses reads its scaling_max_freq (bounded by cap seconds); the cell prints ramp_s, ramp_ok and the max clocks it waited for
+int policy_of(int cpu) { return cpu >= 7 ? 7 : cpu >= 4 ? 4 : 0; }
+long maxkhz(int p, const char * f) {
+    char path[96]; snprintf(path, sizeof path, "/sys/devices/system/cpu/cpufreq/policy%d/%s", p, f);
+    FILE * fp = fopen(path, "r"); long v = -1000; if (fp) { if (fscanf(fp, "%ld", &v) != 1) v = -1000; fclose(fp); }
+    return v;
+}
+bool at_max(const std::vector<int> & set) {
+    for (int c : set) { const int p = policy_of(c); const long m = maxkhz(p, "scaling_max_freq"), v = khz(p); if (m <= 0 || v <= 0) return true; if (v < m) return false; }
+    return true;
+}
+struct Ramp { double s = 0; int ok = 0; std::string max; };
+template <class W> Ramp ramp(const std::vector<int> & set, double warm, double cap, W step) {   // step(): one wait or one unit of warm work
+    Ramp r; const auto t0 = clk::now();
+    while (secs(t0, clk::now()) < warm) step();
+    while (!(r.ok = at_max(set)) && secs(t0, clk::now()) < warm + cap) step();
+    r.s = secs(t0, clk::now());
+    std::vector<int> ps; for (int c : set) if (std::find(ps.begin(), ps.end(), policy_of(c)) == ps.end()) ps.push_back(policy_of(c));
+    for (int p : ps) { char b[64]; snprintf(b, sizeof b, "%sp%d:%ld/%ld", r.max.empty() ? "" : ",", p, maxkhz(p, "scaling_max_freq") / 1000, maxkhz(p, "cpuinfo_max_freq") / 1000); r.max += b; }
+    return r;
+}
+std::string rampstr(const Ramp & r) { char b[160]; snprintf(b, sizeof b, "ramp_s=%.2f ramp_ok=%d max_mhz=%s", r.s, r.ok, r.max.c_str()); return b; }
+const double RAMP_CAP = 4.0;
+#if defined(__linux__)
+struct Aff { cpu_set_t m; bool ok; Aff() { ok = sched_getaffinity(0, sizeof m, &m) == 0; } ~Aff() { if (ok) sched_setaffinity(0, sizeof m, &m); } };
+bool pin_cpus(const std::vector<int> & s) { cpu_set_t m; CPU_ZERO(&m); for (int c : s) CPU_SET(c, &m); return sched_setaffinity(0, sizeof m, &m) == 0; }
+#else
+struct Aff { Aff() {} ~Aff() {} };
+bool pin_cpus(const std::vector<int> &) { return false; }
+#endif
+struct EnvSet {   // sets a variable for the life of this object, then restores the old value (or unsets it)
+    std::string k, old; bool had;
+    EnvSet(const char * key, const std::string & v) : k(key) { const char * o = getenv(key); had = o != nullptr; if (had) old = o; setenv(key, v.c_str(), 1); }
+    ~EnvSet() { if (had) setenv(k.c_str(), old.c_str(), 1); else unsetenv(k.c_str()); }
+};
+std::string setname(const std::vector<int> & s) { std::string r; for (size_t i = 0; i < s.size(); i++) r += (i ? "," : "") + std::to_string(s[i]); return r; }
+void sleep_s(double s) { std::this_thread::sleep_for(std::chrono::microseconds((long long)(s * 1e6))); }
+
+// a timed cell like run_cell, with set warm-up and measured seconds, per-thread accounting and clock sampling; the
+// caller's thread waits on the A55s (0-3) meanwhile and gets its affinity back afterwards
+struct Cell2 { double gbs = 0, units = 0, secs = 0; int cpu_ok = 0, n = 0; std::vector<double> cpu, wall, b, u; std::vector<long> niv, nv, chk, off; std::vector<int> other;
+               std::string m0, m1; Mhz mz; Ramp rp; };
+// per thread: pinned cpu : cpu time / wall time : involuntary : voluntary switches : checks off the pinned cpu / checks @ the
+// last other cpu seen (sched_getcpu every 16th work unit of the measured window; R69 had 6 cells with a worker off its core)
+std::string thr(const Cell2 & c, const std::vector<int> & set) {
+    std::string s;
+    for (int i = 0; i < c.n; i++) {
+        char b[96]; snprintf(b, sizeof b, "%s%d:%.3f:%ld:%ld:%ld/%ld@%d", i ? "," : "", set[i], c.wall[i] > 0 ? c.cpu[i] / c.wall[i] : -1.0, c.niv[i], c.nv[i],
+                             c.off.empty() ? -1L : c.off[i], c.chk.empty() ? -1L : c.chk[i], c.other.empty() ? -1 : c.other[i]);
+        s += b;
+    }
+    return s;
+}
+template <class F> Cell2 cell2(const std::vector<int> & set, F work, double warm, double meas) {
+    Aff aff; pin_cpus({ 0, 1, 2, 3 });
+    const int n = (int) set.size(); std::atomic<int> ready{0}, phase{0};
+    Cell2 c; c.n = n; c.cpu.assign(n, 0); c.wall.assign(n, 0); c.b.assign(n, 0); c.u.assign(n, 0); c.niv.assign(n, -1); c.nv.assign(n, -1);
+    c.chk.assign(n, 0); c.off.assign(n, 0); c.other.assign(n, -1);
+    std::vector<int> ok(n); std::vector<std::thread> th;
+    for (int i = 0; i < n; i++) th.emplace_back([&, i] {
+        bool p = pin(set[i]); int c0 = where(); ready++;
+        while (ready.load() < n) {}
+        double b = 0, u = 0;
+        while (phase.load(std::memory_order_relaxed) == 0) work(i, n, b, u);
+        b = 0; u = 0; const double q0 = tcpu(); const auto w0 = clk::now(); long iv0, v0; csw(iv0, v0, false);
+        for (long k = 0; phase.load(std::memory_order_relaxed) == 1; k++) {
+            work(i, n, b, u);
+            if (!(k & 15)) { const int w = where(); c.chk[i]++; if (w != set[i]) { c.off[i]++; c.other[i] = w; } }
+        }
+        long iv1, v1; csw(iv1, v1, false);
+        c.cpu[i] = tcpu() - q0; c.wall[i] = secs(w0, clk::now()); c.niv[i] = iv0 < 0 ? -1 : iv1 - iv0; c.nv[i] = v0 < 0 ? -1 : v1 - v0;
+        c.b[i] = b; c.u[i] = u; ok[i] = p && c0 == set[i] && where() == set[i];
+    });
+    while (ready.load() < n) {}
+    c.m0 = mhz(); c.rp = ramp(set, warm, RAMP_CAP, [] { sleep_s(0.05); }); phase = 1; const auto t0 = clk::now();
+    while (secs(t0, clk::now()) < meas) { c.mz.sample(); sleep_s(std::min(0.1, std::max(0.0, meas - secs(t0, clk::now())))); }
+    phase = 2; const auto t1 = clk::now();
+    for (auto & t : th) t.join();
+    c.secs = secs(t0, t1); c.m1 = mhz();
+    for (int i = 0; i < n; i++) { c.gbs += c.b[i]; c.units += c.u[i]; c.cpu_ok += ok[i]; }
+    c.gbs /= c.secs * 1e9;
+#if !defined(__linux__)
+    c.cpu_ok = -1;
+#endif
+    return c;
+}
