+// ---- ggml cells: the CPU backend and the weight buffer type llama would pick (the first extra buffer type of the CPU
+// device that supports the mat-vec, else the CPU buffer), timed through ggml_backend_graph_compute
+struct GB {
+    ggml_backend_dev_t dev = nullptr; ggml_backend_t be = nullptr; std::vector<ggml_backend_buffer_type_t> bufts;
+    ggml_backend_set_n_threads_t set_nt = nullptr; std::string how;
+    bool init() {
+        dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU); how = "loaded";
+        if (!dev) { ggml_backend_load_all(); dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU); how = "load_all"; }
+        if (!dev) { ggml_backend_load("libggml-cpu-android_armv8.2_2.so"); dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU); how = "load_variant"; }
+        if (!dev || !(be = ggml_backend_dev_init(dev, nullptr))) return false;
+        ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+        auto ex = (ggml_backend_dev_get_extra_bufts_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_dev_get_extra_bufts");
+        if (ex) for (ggml_backend_buffer_type_t * p = ex(dev); p && *p; p++) bufts.push_back(*p);
+        bufts.push_back(ggml_backend_dev_buffer_type(dev));
+        set_nt = (ggml_backend_set_n_threads_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_n_threads");
+        return true;
+    }
+    ~GB() { if (be) ggml_backend_free(be); }
+    std::string desc() const { std::string s = how + ":" + ggml_backend_dev_name(dev) + ":"; for (auto b : bufts) s += std::string(ggml_backend_buft_name(b)) + "|"; return s; }
+    ggml_backend_buffer_type_t pick(ggml_type t, int K, int R) const {   // as llama-model.cpp's weight_buft_supported
+        for (auto bt : bufts) {
+            if (bt == bufts.back()) return bt;
+            ggml_init_params ip{ ggml_tensor_overhead() * 4, nullptr, true }; ggml_context * c = ggml_init(ip);
+            ggml_tensor * w = ggml_new_tensor_2d(c, t, K, R), * x = ggml_new_tensor_2d(c, GGML_TYPE_F32, K, 1), * op = ggml_mul_mat(c, w, x);
+            ggml_backend_buffer_t b = ggml_backend_buft_alloc_buffer(bt, 0); w->buffer = b;
+            const bool ok = ggml_backend_dev_supports_op(dev, op);
+            ggml_backend_buffer_free(b); ggml_free(c);
+            if (ok) return bt;
+        }
+        return bufts.back();
+    }
+};
+struct GCell { double secs = 0, cpu_over_wall = 0; long calls = 0, niv = 0, off0 = 0; std::string m0, m1; Mhz mz; int cpu_ok = -1; Ramp rp; };
+// runs gf on the set: n threads, thread 0 = this thread (pinned to set[0]); more threads go through VOLLIE_POOL's
+// persistent pool with VOLLIE_CPUMASK = one cpu per thread (c1-olmoe 0010, the kit's pin path)
+GCell gtime(GB & g, ggml_cgraph * gf, const std::vector<int> & set, double warm, double meas, long max_calls = 0) {
+    Aff aff; GCell r; const int n = (int) set.size();
+    std::string mask; for (int i = 0; i < n; i++) { char b[24]; snprintf(b, sizeof b, "%s%llx", i ? "," : "", 1ull << set[i]); mask += b; }
+    EnvSet e1("VOLLIE_POOL", "1"), e2("VOLLIE_CPUMASK", mask);
+    pin(set[0]); if (g.set_nt) g.set_nt(g.be, n);
+    std::atomic<int> stop{0}; std::thread smp([&] { pin_cpus({ 0, 1, 2, 3 }); while (!stop.load()) { r.mz.sample(); sleep_s(0.1); } });
+    r.m0 = mhz();
+    r.rp = ramp(set, warm, RAMP_CAP, [&] { ggml_backend_graph_compute(g.be, gf); });
+    const double p0 = proc_cpu(); long iv0, v0; csw(iv0, v0, true); const auto t0 = clk::now();
+    do { ggml_backend_graph_compute(g.be, gf); r.calls++; if (where() != set[0]) r.off0++; } while (max_calls ? r.calls < max_calls : secs(t0, clk::now()) < meas);
+    r.secs = secs(t0, clk::now()); long iv1, v1; csw(iv1, v1, true);
+    r.cpu_over_wall = (proc_cpu() - p0) / (r.secs * n); r.niv = iv1 - iv0;
+    r.cpu_ok = where() == set[0];
+#if !defined(__linux__)
+    r.cpu_ok = -1;
+#endif
+    stop = 1; smp.join(); r.m1 = mhz();
+    return r;
+}
+struct WSet {   // ncopies weight tensors [K, R] of one type, x [K, 1] F32, and a graph of their mat-vecs
+    ggml_context * cw = nullptr, * cx = nullptr; ggml_backend_buffer_t bw = nullptr, bx = nullptr; ggml_cgraph * gf = nullptr;
+    std::string buft; size_t bytes = 0; double weights = 0; bool ok = false;
+    ~WSet() { if (bw) ggml_backend_buffer_free(bw); if (bx) ggml_backend_buffer_free(bx); if (cw) ggml_free(cw); if (cx) ggml_free(cx); }
+};
+std::vector<float> rand_f(size_t n) {   // about N(0, 1): sum of four uniforms
+    std::vector<float> f(n);
+    for (auto & v : f) { float s = 0; for (int k = 0; k < 4; k++) s += (rnd() & 0xffff) / 65535.f; v = (s - 2.f) * 1.732f; }
+    return f;
+}
+std::vector<uint8_t> templ(ggml_type t, int K, int nr) {   // nr rows quantized by ggml, replicated into the tensors
+    std::vector<float> f = rand_f((size_t) nr * K); std::vector<uint8_t> q((size_t) nr * ggml_row_size(t, K));
+    ggml_quantize_chunk(t, f.data(), q.data(), 0, nr, K, nullptr);
+    return q;
+}
+bool make_wset(GB & g, WSet & s, ggml_type t, int K, int R, int ncopies, const std::vector<uint8_t> & tq, int tr) {
+    ggml_init_params ip{ ggml_tensor_overhead() * (ncopies + 2), nullptr, true }; s.cw = ggml_init(ip);
+    ggml_init_params ix{ ggml_tensor_overhead() * (ncopies + 2) + ggml_graph_overhead_custom(ncopies + 8, false), nullptr, true }; s.cx = ggml_init(ix);
+    std::vector<ggml_tensor *> w(ncopies); for (auto & p : w) p = ggml_new_tensor_2d(s.cw, t, K, R);
+    ggml_backend_buffer_type_t bt = g.pick(t, K, R); s.buft = ggml_backend_buft_name(bt);
+    if (!(s.bw = ggml_backend_alloc_ctx_tensors_from_buft(s.cw, bt))) return false;
+    ggml_tensor * x = ggml_new_tensor_2d(s.cx, GGML_TYPE_F32, K, 1);
+    s.gf = ggml_new_graph_custom(s.cx, ncopies + 8, false);
+    for (auto * p : w) ggml_build_forward_expand(s.gf, ggml_mul_mat(s.cx, p, x));
+    if (!(s.bx = ggml_backend_alloc_ctx_tensors_from_buft(s.cx, g.bufts.back()))) return false;
+    const size_t rb = ggml_row_size(t, K); std::vector<uint8_t> h((size_t) R * rb);
+    for (int r = 0; r < R; r++) memcpy(h.data() + (size_t) r * rb, tq.data() + (size_t)(r % tr) * rb, rb);
+    for (auto * p : w) ggml_backend_tensor_set(p, h.data(), 0, h.size());
+    std::vector<float> xf = rand_f(K); ggml_backend_tensor_set(x, xf.data(), 0, 4 * (size_t) K);
+    s.bytes = h.size() * ncopies; s.weights = (double) K * R * ncopies; s.ok = true;
+    return true;
+}
+std::string gline(const GCell & c, const std::vector<int> & set) {
+    char b[400]; snprintf(b, sizeof b, "set=%s threads=%zu calls=%ld secs=%.3f proc_cpu_over_wall=%.3f proc_nivcsw=%ld cpu0_ok=%d cpu0_off_calls=%ld mhz=%s->%s mhz_range=%s %s",
+                          setname(set).c_str(), set.size(), c.calls, c.secs, c.cpu_over_wall, c.niv, c.cpu_ok, c.off0, c.m0.c_str(), c.m1.c_str(), c.mz.str().c_str(), rampstr(c.rp).c_str());
+    return b;
+}
+
+// ---- L5: per-type gemv through ggml (hot and cold on one A78 and the X1; hot on every thread of 7+4-5 and 4-7)
+const ggml_type TYPES[10] = { GGML_TYPE_Q4_0, GGML_TYPE_IQ4_NL, GGML_TYPE_Q4_K, GGML_TYPE_IQ4_XS, GGML_TYPE_Q3_K,
+                              GGML_TYPE_IQ3_S, GGML_TYPE_IQ3_XXS, GGML_TYPE_Q2_K, GGML_TYPE_Q6_K, GGML_TYPE_Q8_0 };
+void l5(Out & o) {
+    GB g; if (!g.init()) { o.line("l5 error=no_cpu_backend"); return; }
+    o.line("l5 backend=%s", g.desc().c_str());
+    for (int K : { 4096, 11008 }) for (int ti = 0; ti <= 10; ti++) {   // Q4_0 again at the end: the drift reference
+        const ggml_type t = TYPES[ti % 10]; const size_t rb = ggml_row_size(t, K);
+        const std::vector<uint8_t> tq = templ(t, K, 64);
+        const int rh = std::max<int>(16, (int)((256u << 10) / rb) / 16 * 16);   // hot: about 256 KB per thread
+        const int ncold = (int) std::min<size_t>(64, ((size_t) 256 << 20) / (rb * 4096) + 1);   // cold: >= 256 MB of 4096-row tensors
+        struct C { const char * regime; std::vector<int> set; int R, nc; };
+        const C cs[] = { { "hot", { 4 }, rh, 1 }, { "hot", { 7 }, rh, 1 }, { "cold", { 4 }, 4096, ncold }, { "cold", { 7 }, 4096, ncold },
+                         { "hot", { 7, 4, 5 }, rh * 3, 1 }, { "hot", { 4, 5, 6, 7 }, rh * 4, 1 } };
+        std::unique_ptr<WSet> ws; int wR = -1, wN = -1;
+        for (const C & c : cs) {
+            if (c.R != wR || c.nc != wN) { ws.reset(new WSet); wR = c.R; wN = c.nc; if (!make_wset(g, *ws, t, K, c.R, c.nc, tq, 64)) { o.line("l5 error=alloc type=%s k_in=%d", ggml_type_name(t), K); break; } }
+            GCell r = gtime(g, ws->gf, c.set, 0.5, 1.0);
+            o.line("l5 type=%s pass=%d k_in=%d rows=%d copies=%d row_b=%zu regime=%s buft=%s ns_per_w=%.4f gbs=%.2f %s", ggml_type_name(t), ti / 10 + 1, K, c.R, c.nc, rb, c.regime,
+                   ws->buft.c_str(), r.secs * 1e9 / (r.calls * ws->weights), r.calls * (double) ws->bytes / r.secs / 1e9, gline(r, c.set).c_str());
+        }
+    }
+}
+
+// ---- L7: the head gemv (Q6_K, llama-quantize's default head type, and Q8_0) at each subject's vocabulary, cold
+void l7(Out & o) {
+    GB g; if (!g.init()) { o.line("l7 error=no_cpu_backend"); return; }
+    o.line("l7 backend=%s", g.desc().c_str());
+    for (int V : { 64000, 32000, 102400 }) for (ggml_type t : { GGML_TYPE_Q6_K, GGML_TYPE_Q8_0 }) {
+        WSet ws; if (!make_wset(g, ws, t, 4096, V, 1, templ(t, 4096, 64), 64)) { o.line("l7 error=alloc type=%s vocab=%d", ggml_type_name(t), V); continue; }
+        for (const std::vector<int> & set : { std::vector<int>{ 4, 5, 6 }, std::vector<int>{ 7, 4, 5 }, std::vector<int>{ 4, 5, 6, 7 } }) {
+            GCell r = gtime(g, ws.gf, set, 0.5, 1.5);
+            o.line("l7 type=%s vocab=%d k_in=4096 mb=%.1f buft=%s ms_per_call=%.3f gbs=%.2f %s", ggml_type_name(t), V, ws.bytes / 1048576.0, ws.buft.c_str(),
+                   r.secs * 1e3 / r.calls, r.calls * (double) ws.bytes / r.secs / 1e9, gline(r, set).c_str());
+        }
+    }
+}
+
+// ---- L6: barriers. ggml: a chain of N one-element ADD nodes (each a real node: a barrier after it), N = the subjects'
+// non-empty decode nodes (617 Yi-1.5-6B and Llama-2-7B, 579 DeepSeek-7B: host count of one -ub 1 graph) and 225 (the
+// mat-vec count); spin: the probe's own barrier N times per token on pinned threads
+struct Bar {
+    std::atomic<int> cnt{0}, gen{0}; int n = 1;
+    void wait() {
+        const int g = gen.load(std::memory_order_acquire);
+        if (cnt.fetch_add(1, std::memory_order_acq_rel) == n - 1) { cnt.store(0, std::memory_order_relaxed); gen.store(g + 1, std::memory_order_release); }
+        else while (gen.load(std::memory_order_acquire) == g) {}
+    }
+};
+void l6(Out & o) {
+    GB g; if (!g.init()) { o.line("l6 error=no_cpu_backend"); return; }
+    o.line("l6 backend=%s", g.desc().c_str());
+    const std::vector<std::vector<int>> sets = { { 7 }, { 4, 5, 6 }, { 7, 4, 5 }, { 4, 5, 6, 7 } };
+    for (int N : { 617, 579, 225 }) {
+        ggml_init_params ip{ ggml_tensor_overhead() * (N + 4) + ggml_graph_overhead_custom(N + 8, false), nullptr, true }; ggml_context * c = ggml_init(ip);
+        ggml_tensor * t = ggml_new_tensor_1d(c, GGML_TYPE_F32, 1), * one = ggml_new_tensor_1d(c, GGML_TYPE_F32, 1);
+        ggml_cgraph * gf = ggml_new_graph_custom(c, N + 8, false);
+        for (int i = 0; i < N; i++) t = ggml_add(c, t, one);
+        ggml_build_forward_expand(gf, t);
+        ggml_backend_buffer_t b = ggml_backend_alloc_ctx_tensors_from_buft(c, g.bufts.back());
+        if (!b) { o.line("l6 error=alloc"); ggml_free(c); return; }
+        ggml_backend_buffer_clear(b, 0);
+        for (const auto & set : sets) {
+            GCell r = gtime(g, gf, set, 0.3, 0, 200);
+            o.line("l6 kind=ggml nodes=%d graph_nodes=%d tokens=%ld ms_per_token=%.3f us_per_node=%.3f %s", N, ggml_graph_n_nodes(gf), r.calls, r.secs * 1e3 / r.calls,
+                   r.secs * 1e6 / (r.calls * (double) N), gline(r, set).c_str());
+        }
+        ggml_backend_buffer_free(b); ggml_free(c);
+        for (const auto & set : sets) {
+            if (set.size() < 2) continue;
+            Bar bar; bar.n = (int) set.size(); const int T = 200;
+            std::vector<std::thread> th; std::atomic<int> ready{0}; double ms = 0; Aff aff; pin_cpus({ 0, 1, 2, 3 });
+            for (int i = 0; i < bar.n; i++) th.emplace_back([&, i] {
+                pin(set[i]); ready++; while (ready.load() < bar.n) {}
+                for (int k = 0; k < 20 * N; k++) bar.wait();   // warm-up: 20 tokens
+                const auto t0 = clk::now();
+                for (int k = 0; k < T * N; k++) bar.wait();
+                if (i == 0) ms = secs(t0, clk::now()) * 1e3 / T;
+            });
+            for (auto & x : th) x.join();
+            o.line("l6 kind=spin barriers=%d set=%s threads=%zu tokens=%d ms_per_token=%.3f us_per_barrier=%.3f", N, setname(set).c_str(), set.size(), T, ms, ms * 1e3 / N);
+        }
+    }
+}
+
+// ---- L2, L3: read rate and compute ceiling at 3 and 4 big cores, with per-thread accounting
+void l23(Out & o) {
+    const size_t AR = (size_t) 1 << 30; uint8_t * a = (uint8_t *) mmap(nullptr, AR, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (a == MAP_FAILED) { o.line("l23 error=mmap"); return; }
+    fill_q4x4(a, AR); init_x();
+    const std::vector<std::vector<int>> sets3 = { { 4, 5, 6 }, { 7, 4, 5 }, { 4, 5, 6, 7 } };
+    for (const auto & set : sets3) {   // L2 (a): plain read, one slice per thread
+        std::vector<size_t> off(set.size(), 0);
+        Cell2 c = cell2(set, [&](int i, int n, double & b, double & u) {
+            const size_t sl = AR / n, ch = 1 << 20; const uint8_t * p = a + i * sl + off[i];
+            uint64x2_t s0 = vdupq_n_u64(0), s1 = s0, s2 = s0, s3 = s0;
+            for (size_t k = 0; k < ch; k += 64) {
+                s0 = vaddq_u64(s0, vld1q_u64((const uint64_t *)(p + k))); s1 = vaddq_u64(s1, vld1q_u64((const uint64_t *)(p + k + 16)));
+                s2 = vaddq_u64(s2, vld1q_u64((const uint64_t *)(p + k + 32))); s3 = vaddq_u64(s3, vld1q_u64((const uint64_t *)(p + k + 48)));
+            }
+            volatile uint64_t sink = vgetq_lane_u64(vaddq_u64(vaddq_u64(s0, s1), vaddq_u64(s2, s3)), 0); (void) sink;
+            off[i] = (off[i] + ch) % (sl - sl % ch); b += ch; u += ch;
+        }, 0.5, 1.5);
+        o.line("l2 kern=read set=%s threads=%zu gbs=%.2f cpu_ok=%d/%d thr=%s mhz=%s->%s mhz_range=%s %s", setname(set).c_str(), set.size(), c.gbs, c.cpu_ok, c.n, thr(c, set).c_str(), c.m0.c_str(), c.m1.c_str(), c.mz.str().c_str(), rampstr(c.rp).c_str());
+    }
+    for (const auto & set : sets3) {   // L2 (b): stock q4x4 gemv walked cold, one slice per thread
+        std::vector<size_t> g(set.size(), 0);
+        Cell2 c = cell2(set, [&](int i, int n, double & b, double & u) {
+            const size_t ng = AR / n / G4; float y[4 * 64];
+            for (int k = 0; k < 64; k++) { vst1q_f32(y + 4 * k, group4((const bq4x4 *)(a + (i * (AR / n) / G4 + g[i]) * G4), X, nullptr, 0)); g[i] = (g[i] + 1) % ng; }
+            volatile float sink = y[0]; (void) sink; b += 64.0 * G4; u += 64.0 * 4 * K;
+        }, 0.5, 1.5);
+        o.line("l2 kern=q4x4 set=%s threads=%zu gbs=%.2f ns_per_w=%.4f cpu_ok=%d/%d thr=%s mhz=%s->%s mhz_range=%s %s", setname(set).c_str(), set.size(), c.gbs, c.secs * c.n * 1e9 / c.units,
+               c.cpu_ok, c.n, thr(c, set).c_str(), c.m0.c_str(), c.m1.c_str(), c.mz.str().c_str(), rampstr(c.rp).c_str());
+    }
+    // L3: hot q4x4 on every thread at once, each in its own slice of its own L2 (A78 256 KB, X1 512 KB, as p2hot)
+    for (const auto & set : std::vector<std::vector<int>>{ { 4 }, { 7 }, { 4, 5, 6 }, { 7, 4, 5 }, { 4, 5, 6, 7 } }) {
+        std::vector<size_t> gi(set.size(), 0);
+        Cell2 c = cell2(set, [&](int i, int, double & b, double & u) {
+            const size_t ws = set[i] == 7 ? (512u << 10) : (256u << 10), ng = ws / G4; const uint8_t * base = a + (size_t) i * (4u << 20);
+            float y[4 * 16];
+            for (int k = 0; k < 16; k++) { vst1q_f32(y + 4 * k, group4((const bq4x4 *)(base + gi[i] * G4), X, nullptr, 0)); gi[i] = (gi[i] + 1) % ng; }
+            volatile float sink = y[0]; (void) sink; b += 16.0 * G4; u += 16.0 * 4 * K;
+        }, 0.5, 1.5);
+        std::string per; for (int i = 0; i < c.n; i++) { char b[32]; snprintf(b, sizeof b, "%s%d:%.3f", i ? "," : "", set[i], c.u[i] / c.secs / 1e9); per += b; }
+        o.line("l3 kern=q4x4_hot set=%s threads=%zu gw_per_s=%.3f per_thread_gw_per_s=%s cpu_ok=%d/%d thr=%s mhz=%s->%s mhz_range=%s %s", setname(set).c_str(), set.size(),
+               c.units / c.secs / 1e9, per.c_str(), c.cpu_ok, c.n, thr(c, set).c_str(), c.m0.c_str(), c.m1.c_str(), c.mz.str().c_str(), rampstr(c.rp).c_str());
+    }
+    munmap(a, AR);
+    // L2 (c): cold Q4_0 gemv through ggml's own threads (the weight buffer llama picks), 4096 inputs, 64 x 4096-row tensors (604 MB)
+    GB g; if (!g.init()) { o.line("l2 error=no_cpu_backend"); return; }
+    WSet ws; if (!make_wset(g, ws, GGML_TYPE_Q4_0, 4096, 4096, 64, templ(GGML_TYPE_Q4_0, 4096, 64), 64)) { o.line("l2 error=alloc"); return; }
+    for (const auto & set : sets3) {
+        GCell r = gtime(g, ws.gf, set, 0.5, 1.5);
+        o.line("l2 kern=ggml_q4_0 buft=%s mb=%.0f gbs=%.2f ns_per_w=%.4f %s", ws.buft.c_str(), ws.bytes / 1048576.0, r.calls * (double) ws.bytes / r.secs / 1e9,
+               r.secs * 1e9 / (r.calls * ws.weights), gline(r, set).c_str());
+    }
+}
+
+// ---- L4: one layer of each subject's mat-vecs, cold, stock against the rule, threads in lock step (spin barrier after
+// each mat-vec, 128-row chunks taken from a shared counter, as ggml's chunking); the rule's lists are built by thread 0
+// before each layer (their cost is in the layer time)
+struct Subj { const char * name; int kv, layers; double keep; };
+const Subj SUBJ[3] = { { "yi15-6b", 512, 32, 0.58 }, { "llama2-7b", 4096, 32, 0.60 }, { "deepseek7b", 4096, 30, 0.60 } };
+struct Mat { const char * name; int rows, K, in; bool rule; size_t off; };
+std::vector<Mat> layer_mats(const Subj & s, size_t & lb) {
+    std::vector<Mat> m = { { "q", 4096, 4096, 0, true, 0 }, { "k", s.kv, 4096, 0, false, 0 }, { "v", s.kv, 4096, 0, false, 0 }, { "o", 4096, 4096, 1, true, 0 },
+                           { "gate", 11008, 4096, 2, true, 0 }, { "up", 11008, 4096, 2, true, 0 }, { "down", 4096, 11008, 3, true, 0 } };
+    lb = 0; for (auto & x : m) { x.off = lb; lb += (size_t) x.rows * (x.K / QK) * 18; }
+    return m;
+}
+struct LRun { double ms = 0; long layers = 0; Cell2 c; };
+LRun run_layers(const std::vector<int> & set, int arm, uint8_t * a, size_t lb, int nl, const std::vector<Mat> & M, std::vector<std::vector<bq8>> & xs,
+                std::vector<Lists> & Ls, std::vector<std::vector<float>> & y, double warm, double meas) {
+    Aff aff; pin_cpus({ 0, 1, 2, 3 });
+    const int n = (int) set.size(); Bar bar; bar.n = n; std::atomic<int> ready{0}, phase{0}, cur{0}; std::atomic<int> ctr[8];
+    LRun r; Cell2 & c = r.c; c.n = n; c.cpu.assign(n, 0); c.wall.assign(n, 0); c.niv.assign(n, -1); c.nv.assign(n, -1); c.u.assign(n, 0);
+    c.chk.assign(n, 0); c.off.assign(n, 0); c.other.assign(n, -1);
+    std::vector<int> ok(n); std::vector<std::thread> th; clk::time_point ts, te;
+    for (int i = 0; i < n; i++) th.emplace_back([&, i] {
+        bool p = pin(set[i]); int c0 = where(); ready++;
+        while (ready.load() < n) {}
+        int li = 0, last = 0; long cnt = 0; double q0 = 0; clk::time_point w0; long iv0 = -1, v0 = -1;
+        for (;;) {
+            if (i == 0) {
+                const int ph = phase.load(); cur.store(ph);
+                for (int k = 0; k < 8; k++) ctr[k].store(0, std::memory_order_relaxed);
+                if (arm) for (int k = 0; k < 4; k++) build_lists(Ls[k], xs[k].data());
+                if (ph == 1 && cnt == 0) ts = clk::now();
+            }
+            bar.wait();
+            const int ph = cur.load();
+            if (ph != last) {   // this thread's accounting window = the measured layers
+                if (ph == 1) { q0 = tcpu(); w0 = clk::now(); csw(iv0, v0, false); }
+                else { long iv1, v1; csw(iv1, v1, false); c.cpu[i] = tcpu() - q0; c.wall[i] = secs(w0, clk::now()); c.niv[i] = iv0 < 0 ? -1 : iv1 - iv0; c.nv[i] = v0 < 0 ? -1 : v1 - v0; }
+                last = ph;
+            }
+            if (ph == 2) break;
+            const uint8_t * base = a + (size_t) li * lb;
+            for (size_t m = 0; m < M.size(); m++) {
+                const Mat & x = M[m]; const int nb = x.K / QK, units = x.rows / KT;
+                for (;;) {
+                    const int u = ctr[m].fetch_add(1, std::memory_order_relaxed); if (u >= units) break;
+                    if (!arm || !x.rule) stock_n(base + x.off + (size_t) u * (KT / 4) * nb * sizeof(bq4x4), KT, nb, xs[x.in].data(), y[m].data() + u * KT);
+                    else KFN[arm - 1](base + x.off, nb, xs[x.in].data(), Ls[x.in], y[m].data(), u, u + 1);
+                    if (ph == 1) c.u[i] += 1;
+                }
+                bar.wait();
+            }
+            if (i == 0 && ph == 1) { cnt++; te = clk::now(); }
+            if (ph == 1) { const int w = where(); c.chk[i]++; if (w != set[i]) { c.off[i]++; c.other[i] = w; } }
+            li = (li + 1) % nl;
+        }
+        if (i == 0) r.layers = cnt;
+        ok[i] = p && c0 == set[i] && where() == set[i];
+    });
+    while (ready.load() < n) {}
+    c.m0 = mhz(); c.rp = ramp(set, warm, RAMP_CAP, [] { sleep_s(0.05); }); phase = 1; const auto t0 = clk::now();
+    while (secs(t0, clk::now()) < meas) { c.mz.sample(); sleep_s(0.1); }
+    phase = 2;
+    for (auto & t : th) t.join();
+    c.m1 = mhz(); for (int i = 0; i < n; i++) c.cpu_ok += ok[i];
+#if !defined(__linux__)
+    c.cpu_ok = -1;
+#endif
+    r.ms = r.layers ? secs(ts, te) * 1e3 / r.layers : -1;
+    return r;
+}
+void l4(Out & o) {
