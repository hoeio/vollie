+                cpu_set_t m; CPU_ZERO(&m); if (sched_getaffinity(tid, sizeof m, &m) || CPU_COUNT(&m) != 1) continue;
+                T t; t.tid = tid; for (int c = 4; c < 8; c++) if (CPU_ISSET(c, &m)) t.cpu = c;
+                int pr; if (t.cpu < 0 || !stat(tid, t.c0, pr)) continue;
+                sw(tid, t.iv0, t.v0); ts.push_back(t);
+            }
+            closedir(d);
