+    // the GPU side: a feeder on 0-3 that waits (spinning) for the next matrix index, launches, finishes and reports back
+    std::atomic<long> go{0}, done{0}; std::atomic<int> stop{0}, cur{-1}; std::atomic<double> gpu_s{0}; double fcw = -1; unsigned fm = 0; std::atomic<int> ferr{0};
