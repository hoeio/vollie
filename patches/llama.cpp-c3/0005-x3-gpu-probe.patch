+        const ARes s = run_arm(a, th);
+        const long n = s.cpu_n; const double ms = n ? s.cpu_s * 1e3 / n : -1; tsum[sh + 1] += ms / 2;
+        // cpu_ms / wait_ms / gpu_ms are means over every matrix of the arm (warm-up included); ms_per_mat is the measured window
+        o.line("x3 split pos=%d share=%.2f gpu_rows=%d cpu_rows=%d mats=%ld ms_per_mat=%.3f cpu_ms=%.3f wait_ms=%.3f gpu_ms=%.3f gbs=%.2f err=%d %s", k, sh < 0 ? 0.0 : shares[sh],
+               sh < 0 ? 0 : gm[sh], sh < 0 ? M : M - gm[sh], n, ms, idx && sh >= 0 ? cpu_s * 1e3 / idx : -1, idx && sh >= 0 ? wait_s * 1e3 / idx : -1, idx && sh >= 0 ? (gpu_s.load() - g0) * 1e3 / idx : -1, s.cgbs(), ferr.load(), astr(s).c_str());
+    }
+    stop = 1; feeder.join();
+    for (int i = 0; i < 3; i++)
+        o.line("x3 splitsum share=%.2f gpu_rows=%d t_split_ms=%.3f t_cpu_alone_ms=%.3f ratio=%.3f feeder_cpu_over_wall=%.3f feeder_cpus=%x", shares[i], gm[i], tsum[i + 1], tsum[0],
+               tsum[0] > 0 ? tsum[i + 1] / tsum[0] : -1, fcw, fm);
+    for (auto & r : gr) release(g, r);
+}
+
+// ---- x3r: residency with the lane's GPU buffers allocated (memo-09-gap §10.7): 0.9 GB on the GPU, read by it throughout,
+// while 3 A78 (4-6) read a 2.6 GB anonymous arena (the CPU's share of a 3.4 GB body) for 15 s (at most 200 passes); anon34's
+// counters per pass, and a sum line over the read phase
+void res(Gpu & g, Out & o, Kset & ks, const XIn & x4, H dst) {
+    auto mem = [&](const char * st) {
+        o.line("x3 res stage=%s memavail_kb=%ld cached_kb=%ld swapfree_kb=%ld vmrss_kb=%ld rssanon_kb=%ld vmswap_kb=%ld kgsl_page_alloc=%s", st, kv("/proc/meminfo", "MemAvailable"),
+               kv("/proc/meminfo", "Cached"), kv("/proc/meminfo", "SwapFree"), kv("/proc/self/status", "VmRSS"), kv("/proc/self/status", "RssAnon"), kv("/proc/self/status", "VmSwap"),
+               rdl("/sys/class/kgsl/kgsl/page_alloc").c_str());
+    };
+    mem("before");
+    const char * id = "general"; Prog * p = ks.pick(11008, 4096, false, &id);
+    if (!p) { o.line("x3 res ok=0 reason=no_kernel"); return; }
+    HMat h; make_hmat(h, 11008, 4096); Ring r; const int n = (int) std::lround(0.9e9 / h.bytes()); const auto t0 = clk::now();
+    const cl_int e = mkring(g, r, h, n); for (size_t i = 0; i < r.m.size() && !e; i += 8) batch(g, p->k, r, x4, dst);   // one pass so every buffer is resident
+    o.line("x3 res stage=gpu_alloc kern=%s copies=%d gpu_mb=%.0f alloc_s=%.2f err=%d", id, n, r.bytes / 1048576.0, secs(t0, clk::now()), e ? e : r.err);
+    mem("gpu_alloc");
+    if (e) { release(g, r); return; }
+    const double gb = 2.6; const size_t an = (size_t)(gb * 1e9) & ~(size_t) 4095;
+    uint8_t * m = (uint8_t *) mmap(nullptr, an, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (m == MAP_FAILED) { o.line("x3 res ok=0 reason=mmap errno=%d", errno); release(g, r); return; }
+    const auto set = cores("4-6"); long f0 = majflt(); auto a0 = clk::now();
+    { std::vector<std::thread> th;
+      for (int i = 0; i < 3; i++) th.emplace_back([&, i] {
+          pin(set[i]); uint64_t s = 0x9e3779b97f4a7c15ull * (i + 1); uint64_t * q = (uint64_t *)(m + i * (an / 3)); const size_t c = (an / 3) / 8;
+          for (size_t k = 0; k < c; k++) { s ^= s << 13; s ^= s >> 7; s ^= s << 17; q[k] = s; }
+      });
+      for (auto & t : th) t.join(); }
+    o.line("x3 res stage=anon_fill anon_gb=%.1f fill_s=%.1f majflt=%ld", gb, secs(a0, clk::now()), majflt() - f0);
+    mem("anon_fill");
+    std::atomic<int> stop{0}; std::atomic<double> gbytes{0};
+    std::thread feeder([&] { pin_cpus({ 0, 1, 2, 3 }); while (!stop.load()) gbytes = gbytes.load() + batch(g, p->k, r, x4, dst); });
+    const auto p0 = clk::now(); const long mf0 = majflt(); const double gb0 = gbytes.load(); std::vector<double> rates; int pass = 0;
+    for (; pass < 200 && secs(p0, clk::now()) < 15; pass++) {
+        const long g0 = majflt(); rusage r0; getrusage(RUSAGE_SELF, &r0); const double b0 = gbytes.load(); const auto s0 = clk::now(); std::vector<std::thread> th;
+        for (int i = 0; i < 3; i++) th.emplace_back([&, i] {
+            pin(set[i]); const uint8_t * q = m + i * (an / 3); uint64x2_t acc = vdupq_n_u64(0);
+            for (size_t k = 0; k + 64 <= an / 3; k += 64) acc = vaddq_u64(acc, vaddq_u64(vld1q_u64((const uint64_t *)(q + k)), vld1q_u64((const uint64_t *)(q + k + 32))));
+            volatile uint64_t sink = vgetq_lane_u64(acc, 0); (void) sink;
+        });
+        for (auto & t : th) t.join();
+        const double sec = secs(s0, clk::now()); rusage r1; getrusage(RUSAGE_SELF, &r1); rates.push_back(an / sec / 1e9);
+        o.line("x3 res pass=%d s=%.3f gbs=%.2f gpu_gbs=%.2f majflt=%ld minflt=%ld memavail=%ld cached=%ld swapfree=%ld vmswap=%ld vmrss=%ld mhz=%s gpu_mhz=%ld", pass, sec,
+               an / sec / 1e9, (gbytes.load() - b0) / sec / 1e9, majflt() - g0, r1.ru_minflt - r0.ru_minflt, kv("/proc/meminfo", "MemAvailable"), kv("/proc/meminfo", "Cached"),
+               kv("/proc/meminfo", "SwapFree"), kv("/proc/self/status", "VmSwap"), kv("/proc/self/status", "VmRSS"), mhz().c_str(), gpu_mhz("gpuclk"));
+    }
+    const double ps = secs(p0, clk::now()); stop = 1; feeder.join();
+    std::sort(rates.begin(), rates.end());
+    o.line("x3 res sum passes=%d secs=%.1f cpu_gbs_median=%.2f cpu_gbs_min=%.2f gpu_gbs=%.2f majflt=%ld", pass, ps, rates.empty() ? -1 : rates[rates.size() / 2],
+           rates.empty() ? -1 : rates[0], (gbytes.load() - gb0) / ps / 1e9, majflt() - mf0);
+    mem("after");
+    munmap(m, an); release(g, r);
+    hdr(o);
+    o.line("x3 res done err=%d", r.err);
+}
+
+void x3(Out & o, const char * blk, const char * dir) {
+    cond(o);
+    Gpu g; if (!g.init()) { o.line("x3 error=%s", g.err.c_str()); return; }
+    const std::string exe = self_dir() + "libvollie_clc.so";
+    o.line("x3 info device=%s version=%s c_version=%s driver=%s cstd=%s a6x=%d vsgb=%d e031=%d max_alloc_mb=%llu img_max_texels=%zu global_mb=%llu clc=%s clc_x=%d",
+           san(g.name, 200).c_str(), san(g.ver, 200).c_str(), san(g.cver, 200).c_str(), san(g.drv, 600).c_str(), g.cstd.c_str(), g.a6x, g.vsgb, g.e031,
+           (unsigned long long)(g.max_alloc >> 20), g.img_max, (unsigned long long)(g.gmem >> 20), san(exe, 300).c_str(), access(exe.c_str(), X_OK) == 0 ? 1 : 0);
+    const bool fresh = !strcmp(blk, "x3b");
+    if (fresh) {
+        o.line("x3 src file=gemv_noshuffle_q4_0_f32.cl bytes=%zu sha256=%s", strlen(SRC_GENERAL), sha256(SRC_GENERAL).c_str());
+        o.line("x3 src file=gemv_noshuffle_q4_0_f32_spec.cl bytes=%zu sha256=%s", strlen(SRC_SPEC), sha256(SRC_SPEC).c_str());
+    }
+    Kset ks; for (int i = 0; i < 4; i++) ks.p[i] = get_prog(g, o, dir, KERNS[i], fresh);
+    Therm th; XIn x4, x11; cl_int e = mkx(g, x4, 4096); if (!e) e = mkx(g, x11, 11008);
+    H dst = g.cl.CreateBuffer(g.ctx, 1, (size_t) 11008 * 4, nullptr, &e);
+    if (e || !dst) o.line("x3 error=io_alloc err=%d", e);
+    else if (fresh) {
+        identity(g, o, ks, 512, 4096, true, x4, dst);      // Yi's k, v
+        identity(g, o, ks, 2816, 4096, true, x4, dst);     // a split share of gate / up (0.25 of 11008, rounded to 128)
+        identity(g, o, ks, 11008, 4096, true, x4, dst);    // the general kernel on the largest shape
+        identity(g, o, ks, 4096, 4096, false, x4, dst);
+        identity(g, o, ks, 4096, 11008, false, x11, dst);
+        identity(g, o, ks, 11008, 4096, false, x4, dst);
+    } else if (!strcmp(blk, "x3g")) {
+        HMat hm[4]; make_hmat(hm[0], 4096, 4096); make_hmat(hm[1], 512, 4096); make_hmat(hm[2], 11008, 4096); make_hmat(hm[3], 4096, 11008);
+        for (int i : { 1, 0, 3, 2 }) for (bool cold : { false, true }) alone(g, o, th, ks, hm[i], false, cold, hm[i].kin == 4096 ? x4 : x11, dst);
+        alone(g, o, th, ks, hm[2], true, true, x4, dst);   // the general kernel where upstream uses the special one
+        roundtrip(g, o, ks, 512, 4096, x4, dst); roundtrip(g, o, ks, 1024, 4096, x4, dst); roundtrip(g, o, ks, 2816, 4096, x4, dst); roundtrip(g, o, ks, 4096, 4096, x4, dst);
+        for (const Subj & s : SUBJ) layer(g, o, th, ks, s, hm, x4, x11, dst);
+    } else if (!strcmp(blk, "x3c")) {
+        together(g, o, th, ks, x4, dst);
+        split(g, o, th, ks, x4, dst);
+    } else res(g, o, ks, x4, dst);
+    if (dst) g.cl.ReleaseMemObject(dst);
+    for (XIn * x : { &x4, &x11 }) { if (x->img) g.cl.ReleaseMemObject(x->img); if (x->b) g.cl.ReleaseMemObject(x->b); }
+    for (auto & p : ks.p) release(g, p);
+}
