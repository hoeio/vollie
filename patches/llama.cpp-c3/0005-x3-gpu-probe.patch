+        r.ramp_s = secs(t0, clk::now()); r.ramp_ok = ready();
+        r.tm.start(); ph = 1; const auto m0 = clk::now();
+        while (secs(m0, clk::now()) < a.meas) { r.mz.sample(); r.gc.sample(); r.tm.sample(); sleep_s(0.05); }
+        ph = 2; r.tm.stop(); r.m1 = mhz();
+    });
+    if (a.cpu) {
+        pin(a.set[0]);
+        while (ph.load() == 0) a.cpu();
+        const auto t0 = clk::now();
+        while (ph.load() == 1) { r.cpu_b += a.cpu(); r.cpu_n++; }
+        r.cpu_s = secs(t0, clk::now());
+    }
+    ctl.join(); if (feeder.joinable()) feeder.join();
+    r.hr = th.hr();
+    return r;
+}
+std::string astr(const ARes & r) {
+    char b[700]; snprintf(b, sizeof b, "thr=%s feeder=%.3f:%x mhz=%s->%s mhz_range=%s max_mhz=%s gpu_mhz=%s gpu_max_mhz=%ld gpu_busy=%s hr=%s ramp_s=%.2f ramp_ok=%d",
+                          r.tm.thr().c_str(), r.fcw, r.fmask, r.m0.c_str(), r.m1.c_str(), r.mz.str().c_str(), maxstr().c_str(), r.gc.str().c_str(), gpu_mhz("max_gpuclk"),
+                          kg("gpu_busy_percentage").c_str(), r.hr.c_str(), r.ramp_s, r.ramp_ok);
+    return b;
+}
+struct Ring { std::vector<GMat> m; size_t i = 0; cl_int err = 0; double bytes = 0; };
+cl_int mkring(Gpu & g, Ring & r, const HMat & h, int n) { r.m.resize(n); for (auto & m : r.m) { const cl_int e = up(g, m, h); if (e) return e; r.bytes += m.bytes; } return 0; }
+void release(Gpu & g, Ring & r) { for (auto & m : r.m) release(g, m); r.m.clear(); r.bytes = 0; }
+double batch(Gpu & g, H k, Ring & r, const XIn & x, H dst, int n = 8) {   // n gemvs over the ring on the plain queue, then clFinish
+    double b = 0;
+    for (int j = 0; j < n; j++) { GMat & m = r.m[r.i]; r.i = (r.i + 1) % r.m.size(); const cl_int e = launch(g, k, m, x, dst, g.q, nullptr); if (e && !r.err) r.err = e; b += m.bytes; }
+    const cl_int e = g.cl.Finish(g.q); if (e && !r.err) r.err = e;
+    return b;
+}
+void devpass(Gpu & g, H k, Ring & r, const XIn & x, H dst, double s, double & dev_gbs, double & dev_us) {   // the same walk on the profiling queue
+    double b = 0, t = 0; long n = 0; const auto t0 = clk::now();
+    while (secs(t0, clk::now()) < s) {
+        H ev[8] = {};
+        for (int j = 0; j < 8; j++) { GMat & m = r.m[r.i]; r.i = (r.i + 1) % r.m.size(); if (launch(g, k, m, x, dst, g.qp, &ev[j])) ev[j] = nullptr; b += m.bytes; }
+        g.cl.Finish(g.qp);
+        for (H e : ev) if (e) { t += evs(g, e); n++; g.cl.ReleaseEvent(e); }
+    }
+    dev_gbs = t > 0 ? b / t / 1e9 : -1; dev_us = n ? t / n * 1e6 : -1;
+}
+
+// ---- x3b: identity, one gemv per kernel and shape against the float64 reference; max_rel_err = max |gpu - ref| / rms(ref)
+// (a functional check: the kernel forms (q - 8) * scale in half, so it is not exact; pass < 1e-2)
+void identity(Gpu & g, Out & o, Kset & ks, int M, int kin, bool general, const XIn & x, H dst) {
+    const char * id = "general"; Prog * p = ks.pick(M, kin, general, &id);
+    if (!p) { o.line("x3 identity kern=%s m=%d k=%d ok=0 reason=no_kernel", id, M, kin); return; }
+    HMat h; make_hmat(h, M, kin); GMat m; cl_int e = up(g, m, h);
+    std::vector<float> y(M, NAN);
+    if (!e) e = launch(g, p->k, m, x, dst, g.q, nullptr);
+    if (!e) e = g.cl.Finish(g.q);
+    if (!e) e = g.cl.EnqueueReadBuffer(g.q, dst, 1, 0, (size_t) M * 4, y.data(), 0, nullptr, nullptr);
+    release(g, m);
+    const std::vector<double> r = refdot(h, x.x); double rms = 0; for (double v : r) rms += v * v; rms = std::sqrt(rms / M);
+    double mr = 0, ma = 0; int bad = 0, nf = 0;
+    for (int i = 0; i < M; i++) {
+        if (!std::isfinite(y[i])) { nf++; bad++; continue; }
+        const double a = std::fabs(y[i] - r[i]); ma = std::max(ma, a); mr = std::max(mr, a / rms); if (a > 1e-2 * rms) bad++;
+    }
+    o.line("x3 identity kern=%s m=%d k=%d err=%d max_rel_err=%.3e max_abs=%.3e rms_ref=%.3e rows_bad=%d nonfinite=%d ok=%d", id, M, kin, e, mr, ma, rms, bad, nf,
+           !e && mr < 1e-2 && !bad ? 1 : 0);
+}
+
+// ---- x3g
+void alone(Gpu & g, Out & o, Therm & th, Kset & ks, const HMat & h, bool general, bool cold, const XIn & x, H dst) {
+    const char * id = "general"; Prog * p = ks.pick(h.M, h.kin, general, &id);
+    const char * rg = cold ? "cold" : "hot";
+    if (!p) { o.line("x3 alone kern=%s m=%d k=%d regime=%s ok=0 reason=no_kernel", id, h.M, h.kin, rg); return; }
+    const int n = cold ? (int) std::ceil((512.0 * 1048576) / h.bytes()) : 1;
+    Ring r; cl_int e = mkring(g, r, h, n);
+    if (e) { o.line("x3 alone kern=%s m=%d k=%d regime=%s copies=%d ok=0 err=%d reason=alloc", id, h.M, h.kin, rg, n, e); release(g, r); return; }
+    Arm a; a.gpu = [&] { return batch(g, p->k, r, x, dst); }; a.warm = 0.5; a.meas = 1.0;
+    const ARes s = run_arm(a, th);
+    double dg = -1, du = -1; devpass(g, p->k, r, x, dst, 0.3, dg, du);
+    const double gem = s.gpu_b / h.bytes();
+    o.line("x3 alone kern=%s m=%d k=%d regime=%s copies=%d mb=%.1f gemvs=%.0f secs=%.3f gbs=%.2f gw_per_s=%.3f us_per_gemv=%.1f dev_gbs=%.2f dev_us=%.1f err=%d %s",
+           id, h.M, h.kin, rg, n, r.bytes / 1048576.0, gem, s.gpu_s, s.ggbs(), gem * h.M * h.kin / s.gpu_s / 1e9, s.gpu_s / gem * 1e6, dg, du, r.err, astr(s).c_str());
+    release(g, r);
+}
+void roundtrip(Gpu & g, Out & o, Kset & ks, int M, int kin, const XIn & x, H dst) {   // launch + clFinish per call, from a thread on 0-3
+    const char * id = "general"; Prog * p = ks.pick(M, kin, false, &id);
+    if (!p) { o.line("x3 rt kern=%s m=%d k=%d ok=0 reason=no_kernel", id, M, kin); return; }
+    HMat h; make_hmat(h, M, kin); GMat m; const cl_int e = up(g, m, h);
+    if (e) { o.line("x3 rt kern=%s m=%d k=%d ok=0 err=%d", id, M, kin, e); release(g, m); return; }
+    Aff aff; pin_cpus({ 0, 1, 2, 3 });
+    std::vector<double> w; const auto t0 = clk::now(); cl_int le = 0;
+    while (secs(t0, clk::now()) < 0.8) {
+        const auto a = clk::now(); const cl_int x1 = launch(g, p->k, m, x, dst, g.q, nullptr); const cl_int x2 = g.cl.Finish(g.q);
+        if ((x1 || x2) && !le) le = x1 ? x1 : x2;
+        if (secs(t0, a) > 0.2) w.push_back(secs(a, clk::now()) * 1e6);
+    }
+    double dv = 0, q2s = 0, s2e = 0; int n = 0;
+    for (int i = 0; i < 100; i++) {
+        H ev = nullptr; if (launch(g, p->k, m, x, dst, g.qp, &ev) || !ev) continue;
+        g.cl.Finish(g.qp); dv += evs(g, ev); q2s += evs(g, ev, 0x1280, 0x1282); s2e += evs(g, ev, 0x1281, 0x1282); n++; g.cl.ReleaseEvent(ev);
+    }
+    release(g, m);
+    std::sort(w.begin(), w.end()); double mean = 0; for (double v : w) mean += v; mean = w.empty() ? -1 : mean / w.size();
+    const double p50 = w.empty() ? -1 : w[w.size() / 2], p90 = w.empty() ? -1 : w[w.size() * 9 / 10];
+    o.line("x3 rt kern=%s m=%d k=%d calls=%zu wall_us=%.1f p50_us=%.1f p90_us=%.1f dev_us=%.1f ovh_us=%.1f queued_to_start_us=%.1f submit_to_start_us=%.1f err=%d gpu_mhz=%ld",
+           id, M, kin, w.size(), mean, p50, p90, n ? dv / n * 1e6 : -1, n ? mean - dv / n * 1e6 : -1, n ? q2s / n * 1e6 : -1, n ? s2e / n * 1e6 : -1, le, gpu_mhz("gpuclk"));
+}
+struct LMat { const char * name; int M, kin, hi; };   // hi: index of the host matrix
+void layer(Gpu & g, Out & o, Therm & th, Kset & ks, const Subj & sj, HMat * hm, const XIn & x4, const XIn & x11, H dst) {
+    // hm: 0 = 4096 x 4096, 1 = 512 x 4096, 2 = 11008 x 4096, 3 = 4096 x 11008 (rows x inputs)
+    const int kvh = sj.kv == 512 ? 1 : 0;
+    const LMat L[7] = { { "q", 4096, 4096, 0 }, { "k", sj.kv, 4096, kvh }, { "v", sj.kv, 4096, kvh }, { "o", 4096, 4096, 0 },
+                        { "gate", 11008, 4096, 2 }, { "up", 11008, 4096, 2 }, { "down", 4096, 11008, 3 } };
+    const int NL = 4; std::vector<GMat> m(NL * 7); std::vector<Prog *> pk(7); std::string ids; double lb = 0; cl_int e = 0;
+    for (int j = 0; j < 7; j++) { const char * id; pk[j] = ks.pick(L[j].M, L[j].kin, false, &id); ids += std::string(j ? "," : "") + L[j].name + ":" + id; lb += hm[L[j].hi].bytes();
+                                  if (!pk[j]) e = -2; }
+    for (int i = 0; i < NL * 7 && !e; i++) e = up(g, m[i], hm[L[i % 7].hi]);
+    if (e) { o.line("x3 layer subj=%s ok=0 err=%d kerns=%s", sj.name, e, ids.c_str()); for (auto & x : m) release(g, x); return; }
+    size_t li = 0; cl_int le = 0;
+    auto one = [&](bool each) {   // one layer: the 7 gemvs in graph order, clFinish once (sync1) or after each launch (sync7)
+        for (int j = 0; j < 7; j++) { const cl_int x1 = launch(g, pk[j]->k, m[li * 7 + j], L[j].kin == 4096 ? x4 : x11, dst, g.q, nullptr); if (x1 && !le) le = x1; if (each) g.cl.Finish(g.q); }
+        if (!each) g.cl.Finish(g.q);
+        li = (li + 1) % NL; return lb;
+    };
+    double ms[2] = { 0, 0 };
+    for (int each = 0; each < 2; each++) {
+        Arm a; a.gpu = [&] { return one(each); }; a.warm = 0.5; a.meas = 1.0;
+        const ARes s = run_arm(a, th); const double nl = s.gpu_b / lb; ms[each] = s.gpu_s * 1e3 / nl;
+        o.line("x3 layer subj=%s mode=%s layers_in_ring=%d layer_mb=%.1f layers=%.0f ms_per_layer=%.3f body_ms=%.2f n_layer=%d gbs=%.2f err=%d kerns=%s %s", sj.name,
+               each ? "sync7" : "sync1", NL, lb / 1048576.0, nl, ms[each], ms[each] * sj.layers, sj.layers, s.ggbs(), le, ids.c_str(), astr(s).c_str());
+    }
+    double dev = 0; int n = 0;   // one profiled sweep of the ring: device time per layer
+    for (int l = 0; l < NL; l++) {
+        H ev[7] = {};
+        for (int j = 0; j < 7; j++) if (launch(g, pk[j]->k, m[l * 7 + j], L[j].kin == 4096 ? x4 : x11, dst, g.qp, &ev[j])) ev[j] = nullptr;
+        g.cl.Finish(g.qp);
+        for (H x : ev) if (x) { dev += evs(g, x); g.cl.ReleaseEvent(x); }
+        n++;
+    }
+    const double dms = dev * 1e3 / n;
+    o.line("x3 layersum subj=%s ms_sync1=%.3f ms_sync7=%.3f dev_ms=%.3f rt_us_per_dispatch=%.1f ovh_us_per_dispatch=%.1f body_ms_sync1=%.2f body_ms_dev=%.2f",
+           sj.name, ms[0], ms[1], dms, (ms[1] - ms[0]) * 1e3 / 7, (ms[0] - dms) * 1e3 / 7, ms[0] * sj.layers, dms * sj.layers);
+    for (auto & x : m) release(g, x);
+}
+
+// ---- x3c: CPU rings through ggml (the buffer type llama picks: the repacked Q4_0), one graph per matrix
+struct CRing { ggml_context * cw = nullptr, * cx = nullptr; ggml_backend_buffer_t bw = nullptr, bx = nullptr; std::vector<ggml_cgraph *> gf; std::string buft; double bytes = 0;
+               ~CRing() { if (bw) ggml_backend_buffer_free(bw); if (bx) ggml_backend_buffer_free(bx); if (cw) ggml_free(cw); if (cx) ggml_free(cx); } };
+bool make_cring(GB & g, CRing & s, int kin, int R, int n, const std::vector<uint8_t> & tq, int tr) {
+    ggml_init_params ip{ ggml_tensor_overhead() * (n + 2), nullptr, true }; s.cw = ggml_init(ip);
+    ggml_init_params ix{ ggml_tensor_overhead() * (2 * n + 2) + n * ggml_graph_overhead_custom(8, false), nullptr, true }; s.cx = ggml_init(ix);
+    std::vector<ggml_tensor *> w(n); for (auto & p : w) p = ggml_new_tensor_2d(s.cw, GGML_TYPE_Q4_0, kin, R);
+    ggml_backend_buffer_type_t bt = g.pick(GGML_TYPE_Q4_0, kin, R); s.buft = ggml_backend_buft_name(bt);
+    if (!(s.bw = ggml_backend_alloc_ctx_tensors_from_buft(s.cw, bt))) return false;
+    ggml_tensor * x = ggml_new_tensor_2d(s.cx, GGML_TYPE_F32, kin, 1);
+    for (auto * p : w) { ggml_cgraph * gf = ggml_new_graph_custom(s.cx, 8, false); ggml_build_forward_expand(gf, ggml_mul_mat(s.cx, p, x)); s.gf.push_back(gf); }
+    if (!(s.bx = ggml_backend_alloc_ctx_tensors_from_buft(s.cx, g.bufts.back()))) return false;
+    const size_t rb = ggml_row_size(GGML_TYPE_Q4_0, kin); std::vector<uint8_t> h((size_t) R * rb);
+    for (int r = 0; r < R; r++) memcpy(h.data() + (size_t) r * rb, tq.data() + (size_t)(r % tr) * rb, rb);
+    for (auto * p : w) ggml_backend_tensor_set(p, h.data(), 0, h.size());
+    std::vector<float> xf = rand_f(kin); ggml_backend_tensor_set(x, xf.data(), 0, 4 * (size_t) kin);
+    s.bytes = (double) h.size();
+    return true;
+}
+std::string cpumask(const std::vector<int> & set) { std::string m; for (size_t i = 0; i < set.size(); i++) { char b[24]; snprintf(b, sizeof b, "%s%llx", i ? "," : "", 1ull << set[i]); m += b; } return m; }
+void together(Gpu & g, Out & o, Therm & th, Kset & ks, const XIn & x4, H dst) {
+    GB gb; if (!gb.init()) { o.line("x3 tog error=no_cpu_backend"); return; }
+    const std::vector<int> set = { 4, 5, 6, 7 };
+    WSet ws; if (!make_wset(gb, ws, GGML_TYPE_Q4_0, 4096, 4096, 64, templ(GGML_TYPE_Q4_0, 4096, 64), 64)) { o.line("x3 tog error=cpu_alloc"); return; }
+    const char * id = "general"; Prog * p = ks.pick(11008, 4096, false, &id);
+    if (!p) { o.line("x3 tog ok=0 reason=no_kernel"); return; }
+    HMat h; make_hmat(h, 11008, 4096); Ring r; const cl_int e = mkring(g, r, h, (int) std::ceil((512.0 * 1048576) / h.bytes()));
+    if (e) { o.line("x3 tog ok=0 err=%d reason=gpu_alloc", e); release(g, r); return; }
+    o.line("x3 tog setup cpu=ggml_q4_0 cpu_buft=%s cpu_mb=%.0f gpu_kern=%s gpu_m=11008 gpu_k=4096 gpu_copies=%zu gpu_mb=%.0f set=4,5,6,7 feeder=0-3 backend=%s", ws.buft.c_str(),
+           ws.bytes / 1048576.0, id, r.m.size(), r.bytes / 1048576.0, gb.desc().c_str());
+    EnvSet e1("VOLLIE_POOL", "1"), e2("VOLLIE_CPUMASK", cpumask(set));
+    if (gb.set_nt) gb.set_nt(gb.be, (int) set.size());
+    const char * arms[3] = { "cpu", "gpu", "both" }; const int order[6] = { 0, 1, 2, 2, 1, 0 }; double cs[3] = { 0, 0, 0 }, gs[3] = { 0, 0, 0 };
+    for (int k = 0; k < 6; k++) {
