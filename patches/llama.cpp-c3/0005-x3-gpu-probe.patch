+        if (arm != 1) a.cpu = [&] { ggml_backend_graph_compute(gb.be, ws.gf); return (double) ws.bytes; };
+        if (arm != 0) a.gpu = [&] { return batch(g, p->k, r, x4, dst); };
+        const ARes s = run_arm(a, th); cs[arm] += s.cgbs() / 2; gs[arm] += s.ggbs() / 2;
+        o.line("x3 tog pos=%d arm=%s set=4,5,6,7 cpu_gbs=%.2f gpu_gbs=%.2f sum_gbs=%.2f cpu_calls=%ld gpu_batches=%ld err=%d %s", k, arms[arm], s.cgbs(), s.ggbs(), s.cgbs() + s.ggbs(),
+               s.cpu_n, s.gpu_n, r.err, astr(s).c_str());
+    }
+    o.line("x3 togsum cpu_alone_gbs=%.2f gpu_alone_gbs=%.2f both_cpu_gbs=%.2f both_gpu_gbs=%.2f sum_gbs=%.2f sum_vs_cpu_alone=%.3f cpu_loss_gbs=%.2f gpu_loss_gbs=%.2f",
+           cs[0], gs[1], cs[2], gs[2], cs[2] + gs[2], cs[0] > 0 ? (cs[2] + gs[2]) / cs[0] : -1, cs[0] - cs[2], gs[1] - gs[2]);
+    release(g, r);
+}
+void split(Gpu & g, Out & o, Therm & th, Kset & ks, const XIn & x4, H dst) {
+    GB gb; if (!gb.init()) { o.line("x3 split error=no_cpu_backend"); return; }
+    if (!ks.p[0].k) { o.line("x3 split ok=0 reason=no_kernel"); return; }
+    const std::vector<int> set = { 4, 5, 6, 7 }; const int M = 11008, NR = 8; const double shares[3] = { 0.25, 0.35, 0.50 };
+    const std::vector<uint8_t> tq = templ(GGML_TYPE_Q4_0, 4096, 64);
