+    for (int i = 0; i < M; i++) for (int b = 0; b < nb; b++) {
+        const bq4 & blk = h.w[(size_t) i * nb + b]; uint8_t q8[16];
+        for (int j = 0; j < 8; j++) { const uint8_t x0 = blk.qs[2 * j], x1 = blk.qs[2 * j + 1]; q8[j] = (uint8_t)((x0 & 0x0F) | ((x1 & 0x0F) << 4)); q8[j + 8] = (uint8_t)(((x0 & 0xF0) >> 4) | (x1 & 0xF0)); }
+        uint16_t dd; memcpy(&dd, &blk.d, 2); h.d[(size_t) b * M + i] = dd;
+        for (int j = 0; j < 8; j++) h.q[(size_t)(b * 8 + j) * M + i] = (uint16_t)(q8[2 * j] | q8[2 * j + 1] << 8);
+    }
+}
+std::vector<double> refdot(const HMat & h, const std::vector<float> & x) {   // the plain Q4_0 dot in float64
+    const int nb = h.kin / QK; std::vector<double> y(h.M);
+    for (int i = 0; i < h.M; i++) {
+        double s = 0;
+        for (int b = 0; b < nb; b++) {
+            const bq4 & blk = h.w[(size_t) i * nb + b]; double t = 0;
+            for (int e = 0; e < 16; e++) t += ((blk.qs[e] & 15) - 8) * (double) x[b * 32 + e] + ((blk.qs[e] >> 4) - 8) * (double) x[b * 32 + e + 16];
+            s += (double)(float) blk.d * t;
+        }
+        y[i] = s;
+    }
+    return y;
