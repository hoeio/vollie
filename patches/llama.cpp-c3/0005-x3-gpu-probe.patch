+// ---- weights: random Q4_0 blocks (finite fp16 scales) converted on the CPU as upstream does on the GPU:
+// kernel_convert_block_q4_0_noshuffle (byte j = elements 2j, 2j+1 low nibbles; byte j+8 = elements 16+2j, 17+2j), then
+// transpose_2d_as_16b of q ([M][K/4] ushorts -> [K/4][M]) and of d ([M][K/32] halves -> [K/32][M])
+struct HMat { int M = 0, kin = 0; std::vector<bq4> w; std::vector<uint16_t> q, d; size_t bytes() const { return 2 * (q.size() + d.size()); } };
+void make_hmat(HMat & h, int M, int kin) {
+    const int nb = kin / QK; h.M = M; h.kin = kin; h.w.resize((size_t) M * nb); h.q.assign((size_t) kin / 4 * M, 0); h.d.assign((size_t) nb * M, 0);
