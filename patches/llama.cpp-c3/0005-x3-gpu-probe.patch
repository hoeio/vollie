+            const cl_int x1 = launch(g, ks.p[0].k, m, x4, dst, g.q, nullptr), x2 = g.cl.Finish(g.q); if ((x1 || x2) && !ferr.load()) ferr = x1 ? x1 : x2;
+            gpu_s = gpu_s.load() + secs(a, clk::now()); const int w = where(); if (w >= 0 && w < 32) fm |= 1u << w;
+            done = q;
+        }
+        fcw = (tcpu() - c0) / secs(t0, clk::now());
+    });
+    const int order[8] = { -1, 0, 1, 2, 2, 1, 0, -1 }; double tsum[4] = { 0, 0, 0, 0 };
+    for (int k = 0; k < 8; k++) {
+        const int sh = order[k]; long idx = 0; double cpu_s = 0, wait_s = 0; double g0 = gpu_s.load();
+        Arm a; a.set = set; a.warm = 0.5; a.meas = 1.5;
+        if (sh < 0) a.cpu = [&] { ggml_backend_graph_compute(gb.be, full.gf[idx++ % NR]); return full.bytes; };
+        else a.cpu = [&] {
