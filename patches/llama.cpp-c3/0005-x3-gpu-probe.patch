+// ---- per-thread fields of the threads pinned to one cpu of 4-7 (the probe's and ggml's workers), from /proc/self/task:
+// cpu time over wall, involuntary and voluntary switches, and the cpu the thread last ran on, sampled every 50 ms
+struct TMon {
+    struct T { int tid = 0, cpu = -1, other = -1; long chk = 0, off = 0, iv0 = 0, iv1 = 0, v0 = 0, v1 = 0; double c0 = 0, c1 = 0; };
+    std::vector<T> ts; clk::time_point w0, w1;
+    static bool stat(int tid, double & cs, int & pr) {
+        char p[64]; snprintf(p, sizeof p, "/proc/self/task/%d/stat", tid); FILE * f = fopen(p, "r"); if (!f) return false;
+        char b[1024]; const size_t n = fread(b, 1, sizeof b - 1, f); fclose(f); b[n] = 0;
+        char * s = strrchr(b, ')'); if (!s) return false;
+        int fld = 2; unsigned long ut = 0, st = 0; pr = -1; char * sv = nullptr;
+        for (char * t = strtok_r(s + 1, " ", &sv); t; t = strtok_r(nullptr, " ", &sv)) {
+            fld++;
+            if (fld == 14) ut = strtoul(t, nullptr, 10); else if (fld == 15) st = strtoul(t, nullptr, 10); else if (fld == 39) { pr = atoi(t); break; }
+        }
+        cs = (ut + st) / (double) sysconf(_SC_CLK_TCK); return pr >= 0;
+    }
+    static void sw(int tid, long & iv, long & v) { char p[64]; snprintf(p, sizeof p, "/proc/self/task/%d/status", tid); iv = kv(p, "nonvoluntary_ctxt_switches"); v = kv(p, "voluntary_ctxt_switches"); }
