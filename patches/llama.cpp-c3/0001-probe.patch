+extern "C" int llama_vollie_probe(const char * block, const char * dir, char * out, size_t cap);
+extern "C" int llama_vollie_probe(const char * block, const char * dir, char * out, size_t cap) {
+    const char * on = getenv("VOLLIE_PROBE");
+    if (!on || !*on || !strcmp(on, "0") || !out || cap < 2) return -1;
+    out[0] = 0; Out o{out, cap};
+    auto t0 = clk::now();
+    if (!strcmp(block, "p2")) p2(o);
+    else if (!strcmp(block, "x1")) x1(o);
+    else if (!strcmp(block, "x2")) x2(o);
+    else if (!strcmp(block, "p1")) p1(o, dir ? dir : ".");
+    else return -2;
+    o.line("%s end s=%.1f", block, secs(t0, clk::now()));
+    return (int) o.n;
+}
