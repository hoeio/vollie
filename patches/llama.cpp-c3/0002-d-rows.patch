@@ -234,6 +243,216 @@ template <class F> Cell run_cell(const std::vector<int> & set, F work, std::atom
 }
 // the work unit runs to the end of its chunk, so a phase change is seen within ~1 ms; the counts are of finished chunks
 
+// ---- D3 (memo-05 §4): the header of every block. Values as read; a source that cannot be read gives e<errno>.
+#if defined(__ANDROID__)
+bool starts(const char * s, const char * p) { return !strncmp(s, p, strlen(p)); }
+#endif
+std::string rdl(const char * path, int skip = 0) {   // line skip+1 of a file, blanks -> ','; "e<errno>" or "empty"
+    FILE * f = fopen(path, "r"); if (!f) return "e" + std::to_string(errno);
+    char l[512]; bool ok = false;
+    for (int i = 0; i <= skip && (ok = fgets(l, sizeof l, f) != nullptr); i++) {}
+    fclose(f); if (!ok) return "empty";
+    std::string s(l); while (!s.empty() && (s.back() == '\n' || s.back() == ' ')) s.pop_back();
+    for (size_t i = 0; i < s.size(); i++) if (s[i] == ' ' || s[i] == '\t') { size_t j = i; while (j + 1 < s.size() && (s[j + 1] == ' ' || s[j + 1] == '\t')) j++; s.replace(i, j - i + 1, ","); }
+    return s.empty() ? "empty" : s;
+}
+void hdr(Out & o) {
+#if defined(__ANDROID__)   // the lmkd properties the process can read (ro.lmk.*, and the device_config overrides of Android 12+)
+    struct P { std::string s; int n = 0; } pr;
+    __system_property_foreach([](const prop_info * pi, void * ck) {
+        __system_property_read_callback(pi, [](void * ck, const char * name, const char * value, uint32_t) {
+            if (!starts(name, "ro.lmk.") && !starts(name, "persist.device_config.lmkd_native.") && !starts(name, "ro.config.low_ram")) return;
+            auto * p = (P *) ck; std::string v(value); for (auto & c : v) if (c == ' ' || c == '=') c = '_';
+            p->s += " "; p->s += name; p->s += "="; p->s += v.empty() ? "empty" : v; p->n++;
+        }, ck);
+    }, &pr);
+    o.line("hdr props n=%d%s", pr.n, pr.s.c_str());
+#else
+    o.line("hdr props n=-1");
+#endif
+    o.line("hdr zram disksize=%s mm_stat=%s mem_used_total=%s swaps=%s", rdl("/sys/block/zram0/disksize").c_str(), rdl("/sys/block/zram0/mm_stat").c_str(),
+           rdl("/sys/block/zram0/mem_used_total").c_str(), rdl("/proc/swaps", 1).c_str());
+    for (const char * r : { "memory", "cpu" }) {
+        std::string p = std::string("/proc/pressure/") + r; FILE * f = fopen(p.c_str(), "r");
+        if (!f) { o.line("hdr psi res=%s errno=%d", r, errno); continue; }
+        char l[256];
+        while (fgets(l, sizeof l, f)) { l[strcspn(l, "\n")] = 0; if (*l) o.line("hdr psi res=%s kind=%s", r, l); }
+        fclose(f);
+    }
+    o.line("hdr mem memtotal_kb=%ld memavail_kb=%ld cached_kb=%ld swaptotal_kb=%ld swapfree_kb=%ld", kv("/proc/meminfo", "MemTotal"),
+           kv("/proc/meminfo", "MemAvailable"), kv("/proc/meminfo", "Cached"), kv("/proc/meminfo", "SwapTotal"), kv("/proc/meminfo", "SwapFree"));
+    o.line("hdr vm swappiness=%s min_free_kbytes=%s watermark_scale_factor=%s extra_free_kbytes=%s lmk_minfree=%s", rdl("/proc/sys/vm/swappiness").c_str(),
+           rdl("/proc/sys/vm/min_free_kbytes").c_str(), rdl("/proc/sys/vm/watermark_scale_factor").c_str(), rdl("/proc/sys/vm/extra_free_kbytes").c_str(),
+           rdl("/sys/module/lowmemorykiller/parameters/minfree").c_str());
+}
+
+// ---- D2 (memo-05 §4): K1 at TR 128 and Y1b against the stock 4x4 gemv on one pinned A78 (cpu 4), hot and cold, and Y1b
+// on a kept-row list (short-row skip). Kernels as tools/c3_colkern_bench.c (memo-05 T1, T2, E6: bit-identical, host).
+struct bq4 { __fp16 d; uint8_t qs[16]; };   // the file's Q4_0 block (18 B)
+constexpr int KT = 128;                      // K1 tile (TR 128: one strip of 128 rows)
+constexpr size_t KB = KT * 18;               // one (tile, block) chunk of K1's layout: fp16 d[128], then 32 columns of 64 B
+
+void stock_n(const uint8_t * w, int rows, int nb, const bq8 * x, float * y) {   // group4 for any nb
+    for (int g = 0; g < rows / 4; g++) {
+        const bq4x4 * b = (const bq4x4 *) w + (size_t) g * nb; float32x4_t acc = vdupq_n_f32(0);
+        for (int k = 0; k < nb; k++) acc = blk4(b + k, x + k, acc);
+        vst1q_f32(y + 4 * g, acc);
+    }
+}
+// K1: byte k of column j's 64 B holds row (k/16)*32 + k%16 (low nibble) and that row + 16 (high), as the file's unsigned
+// nibble. Per block the kept columns' int16 sums stay in 16 registers (they wrap; the true sum fits, so the result is
+// exact), minus 8 * the kept x's sum; then the stock float step, blocks in increasing order.
+void k1(const uint8_t * w, int rows, int nb, const bq8 * x, const uint8_t (*kc)[32], const int * nkc, float * y) {
+    const uint8x16_t m4 = vdupq_n_u8(15);
+    for (int t = 0; t < rows / KT; t++) {
+        float * af = y + (size_t) t * KT;
+        for (int i = 0; i < KT; i += 4) vst1q_f32(af + i, vdupq_n_f32(0));
+        for (int b = 0; b < nb; b++) {
+            const int nk = nkc[b]; if (!nk) continue;   // isum 0 adds nothing
+            const uint8_t * p = w + ((size_t) t * nb + b) * KB; const __fp16 * d = (const __fp16 *) p; const uint8_t * col = p + KT * 2;
+            int sx = 0; for (int q = 0; q < nk; q++) sx += x[b].qs[kc[b][q]];
+            const int16x8_t corr = vdupq_n_s16((int16_t)(8 * sx)); const float32x4_t vdx = vdupq_n_f32((float) x[b].d);
+            int16x8_t a[16];
+#pragma clang loop unroll(full)
+            for (int i = 0; i < 16; i++) a[i] = vdupq_n_s16(0);
+            for (int q = 0; q < nk; q++) {
+                const int j = kc[b][q]; const int8x16_t xv = vdupq_n_s8(x[b].qs[j]); const int8x8_t xh = vget_low_s8(xv); const uint8_t * c = col + j * 64;
+#pragma clang loop unroll(full)
+                for (int L = 0; L < 4; L++) {
+                    const uint8x16_t v = vld1q_u8(c + 16 * L);
+                    const int8x16_t lo = vreinterpretq_s8_u8(vandq_u8(v, m4)), hi = vreinterpretq_s8_u8(vshrq_n_u8(v, 4));
+                    a[4 * L + 0] = vmlal_s8(a[4 * L + 0], vget_low_s8(lo), xh); a[4 * L + 1] = vmlal_high_s8(a[4 * L + 1], lo, xv);
+                    a[4 * L + 2] = vmlal_s8(a[4 * L + 2], vget_low_s8(hi), xh); a[4 * L + 3] = vmlal_high_s8(a[4 * L + 3], hi, xv);
+                }
+            }
+#pragma clang loop unroll(full)
+            for (int i = 0; i < 16; i++) {   // register i = rows 8i .. 8i+7 of the tile
+                const int16x8_t v = vsubq_s16(a[i], corr); const float16x8_t dw = vld1q_f16(d + 8 * i);
+                vst1q_f32(af + 8 * i, vfmaq_f32(vld1q_f32(af + 8 * i), vcvtq_f32_s32(vmovl_s16(vget_low_s16(v))), vmulq_f32(vdx, vcvt_f32_f16(vget_low_f16(dw)))));
+                vst1q_f32(af + 8 * i + 4, vfmaq_f32(vld1q_f32(af + 8 * i + 4), vcvtq_f32_s32(vmovl_high_s16(v)), vmulq_f32(vdx, vcvt_high_f32_f16(dw))));
+            }
+        }
+    }
+}
+// Y1b: four of the file's own rows in place (row-major 18 B blocks): XOR 0x88, shl 4 / and 0xF0 as stock, two sdot per
+// row, 3 addp; the stock float step. Equal to the 4x4 gemv on the same rows.
+inline float32x4_t y1b4(int nb, const bq4 * w0, const bq4 * w1, const bq4 * w2, const bq4 * w3, const bq8 * x) {
+    const int8x16_t m88 = vdupq_n_s8((int8_t) 0x88), mf0 = vdupq_n_s8((int8_t) 0xF0); const int32x4_t z = vdupq_n_s32(0); float32x4_t acc = vdupq_n_f32(0);
+    for (int b = 0; b < nb; b++) {
+        const int8x16_t a0 = vld1q_s8(x[b].qs), a1 = vld1q_s8(x[b].qs + 16);
+        const int8x16_t v0 = veorq_s8(vld1q_s8((const int8_t *) w0[b].qs), m88), v1 = veorq_s8(vld1q_s8((const int8_t *) w1[b].qs), m88);
+        const int8x16_t v2 = veorq_s8(vld1q_s8((const int8_t *) w2[b].qs), m88), v3 = veorq_s8(vld1q_s8((const int8_t *) w3[b].qs), m88);
+        const int32x4_t d0 = vdotq_s32(vdotq_s32(z, vshlq_n_s8(v0, 4), a0), vandq_s8(v0, mf0), a1);
+        const int32x4_t d1 = vdotq_s32(vdotq_s32(z, vshlq_n_s8(v1, 4), a0), vandq_s8(v1, mf0), a1);
+        const int32x4_t d2 = vdotq_s32(vdotq_s32(z, vshlq_n_s8(v2, 4), a0), vandq_s8(v2, mf0), a1);
+        const int32x4_t d3 = vdotq_s32(vdotq_s32(z, vshlq_n_s8(v3, 4), a0), vandq_s8(v3, mf0), a1);
+        const int32x4_t ret = vpaddq_s32(vpaddq_s32(d0, d1), vpaddq_s32(d2, d3));
+        float16x4_t bd = vld1_dup_f16(&w0[b].d); bd = vld1_lane_f16(&w1[b].d, bd, 1); bd = vld1_lane_f16(&w2[b].d, bd, 2); bd = vld1_lane_f16(&w3[b].d, bd, 3);
+        acc = vfmaq_f32(acc, vcvtq_n_f32_s32(ret, 4), vmulq_f32(vcvt_f32_f16(vld1_dup_f16((const __fp16 *) &x[b].d)), vcvt_f32_f16(bd)));
+    }
+    return acc;
+}
+void y1b(const uint8_t * w, int rows, int nb, const bq8 * x, float * y) {
+    const bq4 * r = (const bq4 *) w;
+    for (int i = 0; i < rows; i += 4) { const bq4 * w0 = r + (size_t) i * nb; vst1q_f32(y + i, y1b4(nb, w0, w0 + nb, w0 + 2 * nb, w0 + 3 * nb, x)); }
+}
+void y1b_rows(const uint8_t * w, int nb, const bq8 * x, const int * rl, int n, float * y) {   // y[q] = row rl[q]; n % 4 == 0
+    const bq4 * r = (const bq4 *) w;
+    for (int q = 0; q < n; q += 4) vst1q_f32(y + q, y1b4(nb, r + (size_t) rl[q] * nb, r + (size_t) rl[q + 1] * nb, r + (size_t) rl[q + 2] * nb, r + (size_t) rl[q + 3] * nb, x));
+}
+struct CMask { std::vector<uint8_t> kc; std::vector<int> nk; long kept = 0; const uint8_t (*lists() const)[32] { return (const uint8_t (*)[32]) kc.data(); } };
+CMask cmask(int nb, double keep) {
+    CMask m; m.kc.assign((size_t) nb * 32, 0); m.nk.assign(nb, 0);
+    for (int b = 0; b < nb; b++) for (int j = 0; j < 32; j++) if ((rnd() & 0xffff) < keep * 65536) { m.kc[(size_t) b * 32 + m.nk[b]++] = (uint8_t) j; m.kept++; }
+    return m;
+}
+std::vector<int> rowlist(int rows, double keep) {   // sorted, each row kept with probability keep, cut to a multiple of 4
+    std::vector<int> v; for (int r = 0; r < rows; r++) if ((rnd() & 0xffff) < keep * 65536) v.push_back(r);
+    v.resize(v.size() & ~(size_t) 3); return v;
+}
+void fix_scales(uint8_t * p, size_t n, size_t chunk, int ns) {   // finite fp16 scales at the head of every chunk
+    for (size_t i = 0; i + chunk <= n; i += chunk) { auto * d = (__fp16 *)(p + i); for (int r = 0; r < ns; r++) d[r] = (__fp16)(0.001f + 0.01f * (rnd() & 1023) / 1023.f); }
+}
+// identity on the phone (1 = memcmp equal), 256 x 4096: K1 at keep 1.0 and 0.6 against stock with the dropped x zeroed;
+// Y1b against stock; Y1b on a half-kept row list against stock's rows
+int d2_identity() {
+    const int N = 256, nb = NB; std::vector<bq4> w((size_t) N * nb);
+    for (auto & b : w) { b.d = (__fp16)(0.001f + 0.01f * (rnd() & 1023) / 1023.f); for (auto & q : b.qs) q = (uint8_t) rnd(); }
+    std::vector<uint8_t> w4((N / 4) * G4), wk((size_t)(N / KT) * nb * KB);
+    for (int r = 0; r < N; r += 4) for (int b = 0; b < nb; b++) {   // ggml's make_block_q4_0x4, interleave 4
+        auto * o = (bq4x4 *)(w4.data() + (r / 4) * G4) + b;
+        for (int k = 0; k < 4; k++) o->d[k] = w[(size_t)(r + k) * nb + b].d;
+        for (int i = 0; i < 16; ++i) { uint32_t e; memcpy(&e, &w[(size_t)(r + i % 4) * nb + b].qs[(i / 4) * 4], 4); e ^= 0x88888888u; memcpy(&o->qs[i * 4], &e, 4); }
+    }
+    for (int t = 0; t < N / KT; t++) for (int b = 0; b < nb; b++) {   // K1 layout
+        uint8_t * p = wk.data() + ((size_t) t * nb + b) * KB; auto * d = (__fp16 *) p; uint8_t * col = p + KT * 2;
+        for (int r = 0; r < KT; r++) d[r] = w[(size_t)(t * KT + r) * nb + b].d;
+        for (int j = 0; j < 32; j++) for (int k = 0; k < 64; k++) {
+            const int r0 = t * KT + (k / 16) * 32 + k % 16; const bq4 & lo = w[(size_t) r0 * nb + b], & hi = w[(size_t)(r0 + 16) * nb + b];
+            const uint8_t ql = j < 16 ? lo.qs[j] & 15 : lo.qs[j - 16] >> 4, qh = j < 16 ? hi.qs[j] & 15 : hi.qs[j - 16] >> 4;
+            col[j * 64 + k] = ql | (qh << 4);
+        }
+    }
+    std::vector<float> ys(N), yk(N); int id = 0;
+    for (int s = 0; s < 2; s++) {
+        CMask m = cmask(nb, s ? 0.6 : 1.0); bq8 xz[NB]; memcpy(xz, X, sizeof X);
+        for (int b = 0; b < nb; b++) for (int j = 0; j < 32; j++) { bool k = false; for (int q = 0; q < m.nk[b]; q++) k |= m.kc[(size_t) b * 32 + q] == j; if (!k) xz[b].qs[j] = 0; }
+        stock_n(w4.data(), N, nb, xz, ys.data()); k1(wk.data(), N, nb, X, m.lists(), m.nk.data(), yk.data());
+        if (!memcmp(ys.data(), yk.data(), 4 * N)) id |= 1 << s;
+    }
+    stock_n(w4.data(), N, nb, X, ys.data()); y1b((const uint8_t *) w.data(), N, nb, X, yk.data());
+    if (!memcmp(ys.data(), yk.data(), 4 * N)) id |= 4;
+    std::vector<int> rl = rowlist(N, 0.5); y1b_rows((const uint8_t *) w.data(), nb, X, rl.data(), (int) rl.size(), yk.data());
+    bool same = true; for (size_t q = 0; q < rl.size(); q++) same &= !memcmp(&yk[q], &ys[rl[q]], 4);
+    return id | (same ? 8 : 0);
+}
+void d2(Out & o) {
+    init_x();
+    const int id = d2_identity();
+    o.line("p2d identity k1_keep100=%d k1_keep060=%d y1b=%d y1b_rows=%d", id & 1, (id >> 1) & 1, (id >> 2) & 1, (id >> 3) & 1);
+    const size_t AR = (size_t) 512 << 20; uint8_t * a = (uint8_t *) mmap(nullptr, AR, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (a == MAP_FAILED) { o.line("p2d error=mmap errno=%d", errno); return; }
+    fill(a, AR); fix_scales(a, AR, sizeof(bq4x4), 4); fix_scales(a, AR, KB, KT); fix_scales(a, AR, sizeof(bq4), 1);   // every layout's scales finite
+    std::vector<bq8> xs(14336 / QK);
+    for (auto & b : xs) { b.d = (__fp16)(0.01f + 0.02f * (rnd() & 1023) / 1023.f); for (auto & q : b.qs) q = (int8_t)((int) (rnd() % 255) - 127); }
+    const std::vector<int> set{4}; std::vector<float> y(1024);
+    for (int K : { 4096, 14336 }) {   // gate/up input (Mistral) and down input (Mistral)
+        const int nb = K / QK; const size_t rb = (size_t) nb * 18;   // bytes per row, the same in every layout
+        CMask cm[3] = { cmask(nb, 1.0), cmask(nb, 0.65), cmask(nb, 0.60) }; const double keeps[3] = { 1.0, 0.65, 0.60 };
+        for (int cold = 0; cold < 2; cold++) {
+            // hot: one matrix of about 260-290 KB, repeated (inside the A78's 512 KB L2); cold: matrices of 1024 rows walked through 512 MB
+            const int rows = cold ? 1024 : K == 4096 ? KT : 32; const size_t mb = rows * rb, nm = cold ? AR / mb : 1;
+            const std::vector<int> rl = rowlist(rows, 0.5);
+            struct R { std::string kern; double keep, d, ns, gbs; int ok, n; std::string m0, m1; };
+            std::vector<R> rs;
+            auto run = [&](const char * kern, double keep, double d, double bytes, double units, const std::function<void(const uint8_t *)> & f) {
+                size_t g = 0; std::string m0 = mhz();
+                Cell c = run_cell(set, [&](int, int, double & b, double & u) { f(a + g * mb); g = (g + 1) % nm; b += bytes; u += units; });
+                rs.push_back({ kern, keep, d, c.secs * 1e9 / c.units, c.gbs, c.cpu_ok, c.n, m0, mhz() });
+            };
+            auto stock = [&] { run("stock", 1.0, 1.0, (double) mb, (double) rows * K, [&](const uint8_t * m) { stock_n(m, rows, nb, xs.data(), y.data()); }); };
+            stock();
+            if (rows % KT == 0) for (int s = 0; s < 3; s++) {
+                double by = 0; for (int b = 0; b < nb; b++) if (cm[s].nk[b]) by += KT * 2 + 64.0 * cm[s].nk[b];
+                run("k1", keeps[s], cm[s].kept / (double) K, by * (rows / KT), (double) cm[s].kept * rows,
+                    [&](const uint8_t * m) { k1(m, rows, nb, xs.data(), cm[s].lists(), cm[s].nk.data(), y.data()); });
+            }
+            run("y1b", 1.0, 1.0, (double) mb, (double) rows * K, [&](const uint8_t * m) { y1b(m, rows, nb, xs.data(), y.data()); });
+            if (K == 4096) run("y1b_rows", 0.5, rl.size() / (double) rows, (double) rl.size() * rb, (double) rl.size() * K,
+                               [&](const uint8_t * m) { y1b_rows(m, nb, xs.data(), rl.data(), (int) rl.size(), y.data()); });
+            stock();   // stock before and after; k is against their mean, drift = after / before
+            const double st = (rs.front().ns + rs.back().ns) / 2;
+            for (size_t i = 0; i < rs.size(); i++) {
+                const R & r = rs[i]; const bool s = r.kern == "stock";
+                o.line("p2d kern=%s%s k_in=%d rows=%d row_b=%zu regime=%s keep=%.2f d=%.3f cpu=4 ns_per_touched_w=%.4f stock_ns_per_w=%.4f k=%.3f t_vs_stock=%.3f%s gbs=%.2f cpu_ok=%d/%d mhz=%s->%s",
+                       r.kern.c_str(), s ? (i ? "_after" : "_before") : "", K, rows, rb, cold ? "cold" : "hot", r.keep, r.d, r.ns, st, r.ns / st, r.ns / st * r.d,
+                       s && i ? (" drift=" + std::to_string(rs.back().ns / rs.front().ns)).c_str() : "", r.gbs, r.ok, r.n, r.m0.c_str(), r.m1.c_str());
+            }
+        }
+    }
+    munmap(a, AR);
