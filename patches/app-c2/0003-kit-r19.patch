+  /// Kit r19: bytes of [path] in the page cache (mincore over a private read-only mapping of the file; mapped or not
+  /// by llama.cpp), in total and inside [ranges] ([start, end) byte pairs, flat). Reads no data. Null off Android or
+  /// on any error. mincore reports file pages only for a file the process owns or may write (the model is the app's).
+  static ({int total, int inRanges, int pages})? pageCacheBytes(String path, List<int> ranges) {
+    final libc = _libc;
+    if (libc == null) return null;
+    final open = libc.lookupFunction<Int32 Function(Pointer<Uint8>, Int32), int Function(Pointer<Uint8>, int)>('open');
+    final close = libc.lookupFunction<Int32 Function(Int32), int Function(int)>('close');
+    final mmap = libc.lookupFunction<Pointer<Void> Function(Pointer<Void>, IntPtr, Int32, Int32, Int32, IntPtr),
+        Pointer<Void> Function(Pointer<Void>, int, int, int, int, int)>('mmap');
+    final munmap = libc.lookupFunction<Int32 Function(Pointer<Void>, IntPtr), int Function(Pointer<Void>, int)>('munmap');
+    final mincore = libc.lookupFunction<Int32 Function(Pointer<Void>, IntPtr, Pointer<Uint8>),
+        int Function(Pointer<Void>, int, Pointer<Uint8>)>('mincore');
+    final pageSize = libc.lookupFunction<Int32 Function(), int Function()>('getpagesize')();
+    final free = libc.lookupFunction<Void Function(Pointer<Uint8>), void Function(Pointer<Uint8>)>('free');
+    final int len;
+    try {
+      len = File(path).lengthSync();
+    } catch (_) {
+      return null;
+    }
+    final name = _cString(path);
+    final fd = open(name, 0 /* O_RDONLY */);
+    free(name);
+    if (fd < 0) return null;
+    final addr = mmap(nullptr, len, 1 /* PROT_READ */, 1 /* MAP_SHARED */, fd, 0);
+    close(fd);
+    if (addr.address == -1 || addr.address == 0) return null;
+    final n = (len + pageSize - 1) ~/ pageSize;
+    final vec = _malloc!(n);
+    try {
+      if (mincore(addr, len, vec) != 0) return null;
+      final v = vec.asTypedList(n);
+      var total = 0;
+      for (var i = 0; i < n; i++) {
+        total += v[i] & 1;
+      }
+      var inR = 0;
+      for (var r = 0; r + 1 < ranges.length; r += 2) {
+        final end = math.min((ranges[r + 1] + pageSize - 1) ~/ pageSize, n);
+        for (var i = ranges[r] ~/ pageSize; i < end; i++) {
+          inR += v[i] & 1;
+        }
+      }
+      return (total: total * pageSize, inRanges: inR * pageSize, pages: n);
+    } finally {
+      free(vec);
+      munmap(addr, len);
+    }
