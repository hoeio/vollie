+/**
+ * Kit r31: the chain's process restart, made robust (R71: kit r30's restart was refused by Android 15's
+ * background-activity-launch rule, "BAL_BLOCK", because the screen had gone off and the app had no visible window).
+ * Every step is logged to the chain log (<files>/r30-chain-log.txt, the file the Dart side writes) before it is taken.
+ * Route: the app's window is kept on and shown over the lock screen, and the screen is woken if it is off, so the start
+ * of RestartActivity comes from a visible window (Android 15 allows it then, "BAL_ALLOW_VISIBLE_WINDOW"). Not used: an
+ * alarm-clock PendingIntent (blocked the same way on the API 35 emulator, kit r31 test) and a PendingIntent sent with
+ * MODE_BACKGROUND_ACTIVITY_START_ALLOWED (the sender is this app, so it carries no privilege the app does not have).
+ * The Dart side's watchdog retries the whole call (at most 3 tries) and then stops the chain, resumable.
+ */
+object ChainRestart {
+    private const val LOG = "r30-chain-log.txt" // same file name as kit r30 (owner: continue r30's chain)
+    var resumed = false // MainActivity's onResume / onPause
+
+    fun log(ctx: Context, line: String) {
+        val l = "${SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS", Locale.US).format(Date())} [android pid ${android.os.Process.myPid()}] $line"
+        android.util.Log.i("vollie-chain", l)
+        runCatching { File(ctx.filesDir, LOG).appendText("$l\n") }
+    }
+
+    fun screen(ctx: Context): Map<String, Any?> {
+        val pm = ctx.getSystemService(Context.POWER_SERVICE) as PowerManager
+        val km = ctx.getSystemService(Context.KEYGUARD_SERVICE) as KeyguardManager
+        return mapOf("interactive" to pm.isInteractive, "keyguardLocked" to km.isKeyguardLocked,
+            "resumed" to resumed, "pid" to android.os.Process.myPid())
+    }
+
+    /** The chain's window: kept on, shown over the lock screen, turns the screen on when it is (re)shown. */
+    fun window(a: Activity, on: Boolean) {
+        if (Build.VERSION.SDK_INT >= 27) {
+            a.setShowWhenLocked(on)
+            a.setTurnScreenOn(on)
+        }
+        val f = WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON
+        if (on) a.window.addFlags(f) else a.window.clearFlags(f)
+    }
+
+    /** Restart the app into the stored runtime: wake, show, then start RestartActivity (kills this process). */
+    fun restart(a: Activity) {
+        val pm = a.getSystemService(Context.POWER_SERVICE) as PowerManager
+        log(a, "restart requested; screen ${screen(a)}")
+        // CPU awake for the whole try, so the timers of this try (and the Dart watchdog) run by the clock (R71: a 30 s
+        // timer took 49 min while the phone slept)
+        pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "vollie:restart").acquire(60_000)
+        if (!pm.isInteractive) {
+            log(a, "screen is off: waking it (ACQUIRE_CAUSES_WAKEUP, 10 s)")
+            @Suppress("DEPRECATION")
+            pm.newWakeLock(PowerManager.SCREEN_BRIGHT_WAKE_LOCK or PowerManager.ACQUIRE_CAUSES_WAKEUP or
+                PowerManager.ON_AFTER_RELEASE, "vollie:restart-wake").acquire(10_000)
+        }
+        window(a, true)
+        // wait up to 5 s for the window to be shown (the screen was just woken), then start the restart activity
+        val h = Handler(Looper.getMainLooper())
+        val t0 = System.currentTimeMillis()
+        fun go() {
+            if (!resumed && System.currentTimeMillis() - t0 < 5_000) { h.postDelayed(::go, 250); return }
+            log(a, "starting RestartActivity; screen ${screen(a)}")
+            runCatching {
+                a.startActivity(Intent(a, RestartActivity::class.java)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK).putExtra("pid", android.os.Process.myPid()))
+            }.onFailure { log(a, "startActivity(RestartActivity) threw: $it") }
+        }
+        go()
+    }
+}
