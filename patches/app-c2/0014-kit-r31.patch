+// Kit r31: which stopped chains "Resume chain" accepts (R71's r30 state included) and where it continues.
+import 'package:flutter_test/flutter_test.dart';
+import 'package:vollie/assistant.dart';
+
+void main() {
+  // kit r30's state on the phone after R71 (r30-chain_2026-11-20.json, reports trimmed)
+  final r71 = <String, Object?>{'kit': 'r30', 'index': 2, 'restarts': {'2': 1}, 'done': false,
+    'stop': 'restart into c1 did not happen within 30 s'};
+  test('R71 state resumes at segment 2 (c1); c2 and cool are behind it', () {
+    expect(ResearchChain.chainResumable(r71), true);
+    expect(Research.chainPlan[r71['index'] as int].$1, 'c1');
+  });
+  test('r31 restart stop resumes; other stops, a done chain, a running chain and no chain do not', () {
