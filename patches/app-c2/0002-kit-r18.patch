@@ -0,0 +1,25 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:vollie/assistant.dart';
+
+// Kit r18: the runtime's frozen lines (memo-11 §3) are found anywhere in a log line and filed by run id.
+void main() {
+  test('per-token line with a logger prefix', () {
+    const l = '0.00.276.155 I cpu-prof ab=B tok=6 us/token=23172 majflt=0 minflt=6945 mhz=0/0 run=ab_x4.2 prompt=3 blk=2 '
+        'threads=3 ops=501 barriers=274 syncs=414 skipped=0 pairs=0 head=0 router=94 mm=1470 mmid=14340 attn=76 '
+        'other=1265 wait=5866 | ADD 144:50+6 MUL_MAT_ID 48:14340+5595';
+    final p = Research.parseLine(l)!;
+    expect(p.tag, 'ab_x4.2');
+    expect(p.line.startsWith('cpu-prof ab=B'), true);
+    expect(p.tok, ['B', 6, 23172, 0, 6945, 0, 0, 3, 2, 3, 501, 274, 414, 0, 0, 0, 94, 1470, 14340, 76, 1265, 5866]);
+    expect(p.tok!.length, Research.tokFields.length);
+  });
+  test('per-prompt and untagged lines', () {
+    final p = Research.parseLine('c2-skip-run: run=skip.0 prompt=4 tokens=183 pairs=1464 pairs_skipped=13.7% '
+        'expert_bytes_skipped=13.7% MB_per_token_selected=1.0 MB_per_token_skipped=0.1 batch_bytes_unread=2.0%')!;
+    expect(p.tag, 'skip.0');
+    expect(p.tok, null);
+    final h = Research.parseLine('x c2-head-build: screen=q4_0x4x4 exact=q6_K_8x4 rows=50304 copy_mb=58.0 ms=60.8 threads=3 sum=0000000000000000')!;
+    expect(h.tag, null);
+    expect(Research.parseLine('llama_model_loader: loaded'), null);
+  });
+}
