+                    // Kit r21: a copy of a file (the kit report) in the public Downloads folder, so it can be sent as a file.
+                    "saveToDownloads" -> thread {
+                        val r = runCatching {
+                            if (Build.VERSION.SDK_INT < 29) error("needs Android 10 or newer")
+                            val name = call.argument<String>("name")!!
+                            val v = ContentValues().apply {
+                                put(MediaStore.Downloads.DISPLAY_NAME, name)
+                                put(MediaStore.Downloads.MIME_TYPE, "application/json")
+                                put(MediaStore.Downloads.IS_PENDING, 1)
+                            }
+                            val uri = contentResolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, v)
+                                ?: error("Downloads refused the file")
+                            contentResolver.openOutputStream(uri)!!.use { out ->
+                                File(call.argument<String>("path")!!).inputStream().use { it.copyTo(out, 1 shl 20) }
+                            }
+                            v.clear()
+                            v.put(MediaStore.Downloads.IS_PENDING, 0)
+                            contentResolver.update(uri, v, null, null)
+                            "Download/$name"
+                        }
+                        runOnUiThread { r.fold({ result.success(it) }, { result.error("save", it.message, null) }) }
+                    }
+
