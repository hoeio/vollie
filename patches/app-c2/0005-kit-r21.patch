+      if (have > x.bytes) {
+        part.deleteSync();
+        have = 0;
+      }
+      if (have == x.bytes) break;
+      final client = HttpClient()..connectionTimeout = const Duration(seconds: 15);
+      try {
+        final rq = await client.getUrl(Uri.parse(x.url));
+        if (have > 0) rq.headers.set(HttpHeaders.rangeHeader, 'bytes=$have-');
+        final rs = await rq.close();
+        if (rs.statusCode == 206) {
+          if (!(rs.headers.value(HttpHeaders.contentRangeHeader) ?? '').startsWith('bytes $have-')) throw const HttpException('bad range');
+        } else if (rs.statusCode == 200) {
+          have = 0; // the server ignored Range: start over
+        } else {
+          throw HttpException('HTTP ${rs.statusCode}');
+        }
+        final out = part.openWrite(mode: have > 0 ? FileMode.append : FileMode.write);
+        var got = have, t0 = DateTime.now(), b0 = have;
+        try {
+          await for (final c in rs.timeout(const Duration(seconds: 30))) {
+            out.add(c);
+            got += c.length;
+            final dt = DateTime.now().difference(t0).inMilliseconds;
+            if (dt > 1000) {
+              note('${x.file}: ${(got / 1e9).toStringAsFixed(2)} / ${(x.bytes / 1e9).toStringAsFixed(2)} GB · '
+                  '${((got - b0) / dt / 1000).toStringAsFixed(1)} MB/s');
+              t0 = DateTime.now();
+              b0 = got;
+            }
+            if (_stopTest) break;
+          }
+        } finally {
+          await out.close();
+        }
+        failures = 0;
+      } catch (e) {
+        if (++failures > 8) {
+          kitNote = '${x.file}: the download keeps failing ($e). Check Wi-Fi and tap again: it resumes.';
+          return false;
+        }
+        note('${x.file}: retrying ($e)');
+        await Future<void>.delayed(Duration(seconds: math.min(30, 1 << failures)));
+      } finally {
+        client.close(force: true);
+      }
+    }
+    if (_stopTest) {
