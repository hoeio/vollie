+        await _chainWrite(st);
+        await _chainLog('restart into $rt for segment $i (this process: $info)');
+        await DeviceProfile.switchRuntime(rt, screenOn: true);
+        await Future<void>.delayed(const Duration(seconds: 30)); // the process is killed meanwhile
+        return _chainEnd(st, 'restart into $rt did not happen within 30 s');
+      }
+      final attempts = st['attempts'] as Map;
+      final a = ((attempts['$i'] as int?) ?? 0) + 1;
+      if (a > Research.chainAttempts) {
+        return _chainEnd(st, 'segment $i ($seg) was cut off ${a - 1} times (crash or kill); not run again');
+      }
+      if (a > 1 && seg != 'cool') {
+        // the cut-off attempt's report, as far as it got (the kit stores it after every run)
+        final r = _prefs.getString(Assistant._researchKey);
+        if (r != null) {
+          final f = File('$dir/r30-chain-$i-$seg-$rt-attempt${a - 1}-partial.json')..writeAsStringSync(r, flush: true);
+          (st['reports'] as List).add({'segment': seg, 'runtime': rt, 'index': i, 'attempt': a - 1, 'path': f.path, 'partial': true});
+        }
+      }
+      attempts['$i'] = a;
+      await _chainWrite(st);
+      await _chainLog('segment $i $seg start (attempt $a), process runtime $info');
+      // segment-start checks: battery, power saving (record, wait, re-check up to 3 times)
+      var p = await DeviceProfile.powerState();
+      await _chainLog('segment $i start: battery ${p['level']} %, plugged ${(await DeviceProfile.battery()).plugged}, ${Research.powerLabel(p)}');
+      if (p['level'] is int && (p['level'] as int) < Research.chainBatteryMin) {
+        return _chainEnd(st, 'battery ${p['level']} % < ${Research.chainBatteryMin} % at segment $i start');
+      }
+      for (var k = 1; Research.powerLabel(p) == 'power-save on'; k++) {
+        if (k > Research.chainPowerTries) {
+          return _chainEnd(st, 'power saving on at segment $i start (read ${Research.chainPowerTries + 1} times, '
+              '${Research.chainPowerWait.inMinutes} min apart)');
+        }
+        await _chainLog('power saving ON at segment $i start: waiting ${Research.chainPowerWait.inSeconds} s (check $k of ${Research.chainPowerTries})');
+        if (!await _chainIdle(Research.chainPowerWait, 'power saving is on: waiting to re-check ($k of ${Research.chainPowerTries})')) {
+          return _chainEnd(st, Research.chainStop ?? 'stopped by the owner');
+        }
+        p = await DeviceProfile.powerState();
+      }
+      Research.chainStop = null;
+      final t0 = DateTime.now();
+      final String? path;
+      if (seg == 'cool') {
+        path = await _chainCool(i, dir);
+      } else if (Research.chainTest) {
+        path = await _chainTestSegment(i, seg, rt, dir);
+      } else {
+        path = await _chainKit(i, seg, rt);
+      }
+      if (Research.chainStop != null) return _chainEnd(st, 'segment $i ($seg): ${Research.chainStop}');
+      if (_stopTest) return _chainEnd(st, 'segment $i ($seg): stopped by the owner');
+      if (path == null) return _chainEnd(st, 'segment $i ($seg): no report (${kitNote ?? 'the kit did not start'})');
+      (st['reports'] as List).add({'segment': seg, 'runtime': rt.isEmpty ? active : rt, 'index': i, 'attempt': a, 'path': path,
+        'started': t0.toIso8601String(), 'finished': DateTime.now().toIso8601String()});
+      st['index'] = i + 1;
+      await _chainWrite(st);
+      await _chainLog('segment $i $seg done in ${DateTime.now().difference(t0).inSeconds} s: $path');
     }
   }
+
+  /// Waits [d] idle on the kit's static screen ([status] shown); false when stopped (owner, or battery below the floor).
+  Future<bool> _chainIdle(Duration d, String status, [List<List<Object?>>? samples]) async {
+    researching = true;
+    final t0 = DateTime.now();
+    try {
+      for (var m = 0; !_stopTest; m++) {
+        final left = d - DateTime.now().difference(t0);
+        if (left <= Duration.zero) return true;
+        _researchStatus('Research ${Research.kit} chain · $status · ${(left.inSeconds + 59) ~/ 60} min left');
+        if (samples != null || m % 6 == 0) {
+          final p = await DeviceProfile.powerState();
+          final h = (await DeviceProfile.thermal()).headroom;
+          final b = await DeviceProfile.battery();
+          samples?.add([DateTime.now().difference(t0).inMilliseconds, h, p['level'], b.plugged, p['powerSave'], p['status']]);
+          if (p['level'] is int && (p['level'] as int) < Research.chainBatteryMin) {
+            Research.chainStop = 'battery ${p['level']} % < ${Research.chainBatteryMin} %';
+            return false;
+          }
+        }
+        await Future<void>.delayed(left < const Duration(seconds: 10) ? left : const Duration(seconds: 10));
+      }
+      return false;
+    } finally {
+      researching = false;
+      optimizing = null;
+      _kitChanged();
+    }
+  }
+
+  Future<String?> _chainCool(int i, String dir) async {
+    final t0 = DateTime.now();
+    final samples = <List<Object?>>[];
+    await _chainLog('cool-down ${Research.chainCool.inSeconds} s start (no model run)');
+    final ok = await _chainIdle(Research.chainCool, 'cool-down', samples);
+    final f = File('$dir/r30-chain-$i-cool-${_stamp(t0)}.json');
+    f.writeAsStringSync(jsonEncode({
+      'kind': 'chain_cool', 'kit': Research.kit, 'app': Research.app, 'started': t0.toIso8601String(),
+      'finished': DateTime.now().toIso8601String(), 'planned_s': Research.chainCool.inSeconds, 'completed': ok,
+      'model_loaded': _loadedPath?.split('/').last, 'fields': ['ms', 'headroom', 'battery_pct', 'plugged', 'power_save', 'thermal_status'],
+      'samples': samples,
+    }), flush: true);
+    await _chainLog('cool-down end (${ok ? 'complete' : 'cut'}), ${samples.length} samples: ${f.path}');
+    return ok ? f.path : null;
+  }
+
+  /// One of R68's plans in this process's runtime (researchRun's run list follows it), logged per run.
+  Future<String?> _chainKit(int i, String seg, String rt) async {
+    final t0 = DateTime.now();
+    while (_loadedPath == null || status != EngineStatus.ready || isBusy || optimizing != null) {
+      if (_stopTest) return null;
+      if (DateTime.now().difference(t0) > const Duration(minutes: 20)) {
+        Research.chainStop = 'the app\'s model was not loaded within 20 min (status $status)';
+        return null;
+      }
+      await Future<void>.delayed(const Duration(seconds: 2));
+    }
+    if (!kitModelReady) {
+      Research.chainStop = 'kit models missing: ${kitModelsMissing.map((m) => m.file).join(', ')}';
+      return null;
+    }
+    return researchRun(name: 'r30-chain-$i-$seg-$rt-${_stamp(t0)}', onRow: (row) {
+      final p = row['power'] as Map?;
+      final rc = row['runtime_check'];
+      _chainLog('run ${row['run_tag']}: battery ${p?['level']} %, plugged ${row['plugged_run']}, '
+          'power-save ${p?['powerSave']}, tok/s ${row['decode_tps']}${row['error'] != null ? ', error ${row['error']}' : ''}');
+      if (rc != null) _chainLog('mapped (maps + sha256) at ${row['run_tag']}: ${jsonEncode(rc)}');
+      if (p?['level'] is int && (p!['level'] as int) < Research.chainBatteryMin) {
+        Research.chainStop = 'battery ${p['level']} % < ${Research.chainBatteryMin} % after run ${row['run_tag']}';
+        _stopTest = true;
+      }
+    });
+  }
+
+  /// Test builds only ([Research.chainTest]): one small load and 8 tokens, with the mapped-library check.
+  Future<String?> _chainTestSegment(int i, String seg, String rt, String dir) async {
+    researching = true;
+    _researchStatus('Research ${Research.kit} chain TEST · segment $i $seg');
+    final t0 = DateTime.now();
+    final keep = _loadedPath;
+    try {
+      final ext = (await const MethodChannel('vollie/downloads').invokeMethod<Map>('kitStorage'))!['external'];
+      _loadedPath = '$ext/chain-test.gguf';
+      DeviceProfile.stderrTo('$ext/chain-test-native.log');
+      await LlamaLogging.configure(level: LlamaLogLevel.none, nativeLevel: LlamaLogLevel.info);
+      _contextSize = 512;
+      _repack = false;
+      await _engine.unloadModel();
+      await _loadOn(Accel.cpu, 2, 2);
+      final c = await _kitComplete('Once upon a time', 8, false, (_) {});
+      final build = jsonDecode(await rootBundle.loadString('assets/kit_build.json')) as Map;
+      final libs = {for (final l in Research._nativeLibs()) l.split('/').last: await DeviceProfile.sha256(l)};
+      final info = await DeviceProfile.runtimeInfo();
+      final rc = Research.runtimeCheck(libs, build, (info['active'] as String?) ?? 'c2');
+      await _chainLog('mapped (maps + sha256) in test segment $i: ${jsonEncode(rc)}; text ${jsonEncode(c.text)}');
+      if (rc['ok'] != true) Research.chainStop = 'mapped-library check failed: ${jsonEncode(rc)}';
+      await Future<void>.delayed(const Duration(seconds: 15)); // time for a forced kill in the emulator test
+      final f = File('$dir/r30-chain-$i-$seg-$rt-${_stamp(t0)}.json');
+      f.writeAsStringSync(jsonEncode({
+        'kind': 'chain_test', 'kit': Research.kit, 'runtime_info': info, 'runtime_check': rc, 'libs': libs, 'text': c.text,
+        'tokens': c.usage?.completionTokens, 'started': t0.toIso8601String(), 'finished': DateTime.now().toIso8601String(),
+      }), flush: true);
+      return f.path;
+    } catch (e) {
+      Research.chainStop = 'test segment: $e';
+      return null;
+    } finally {
+      try {
+        await _engine.unloadModel();
+      } catch (_) {}
+      _repack = null;
+      _loadedPath = keep;
+      researching = false;
+      optimizing = null;
+      _kitChanged();
+    }
+  }
+
+  String _chainSummaryText(Map<String, Object?> st) {
+    final reps = (st['reports'] as List?) ?? const [];
+    return [
+      'Research ${st['kit']} unattended chain ${st['done'] == true ? 'DONE' : 'STOPPED'}${st['test_plan'] == true ? ' (TEST PLAN)' : ''}',
+      'Started ${st['started']}, ended ${st['finished']}. Label: ${st['session_label']}.',
+      'Segments done: ${st['index']} of ${Research.chainPlan.length}.',
+      if (st['stop'] != null) 'Stop reason: ${st['stop']}',
+      'Report files:',
+      for (final r in reps) '  ${(r as Map)['segment']} (${r['runtime']})${r['partial'] == true ? ' PARTIAL' : ''}: ${(r['path'] as String).split('/').last}',
+      'Chain log: r30-chain-log.txt',
+    ].join('\n');
+  }
+
+  /// The chain's files (state, log, every segment report) copied into Downloads; returns the names.
+  Future<List<String>> chainSaveToDownloads() async {
+    final st = await chainState();
+    final dir = await _chainFolder();
+    final files = [
+      '$dir/r30-chain.json', '$dir/r30-chain-log.txt',
+      for (final r in (st?['reports'] as List?) ?? const []) (r as Map)['path'] as String,
+    ];
+    final out = <String>[];
+    for (final p in files) {
+      if (!File(p).existsSync()) continue;
+      final name = 'vollie-${p.split('/').last}';
+      out.add((await const MethodChannel('vollie/downloads').invokeMethod<String>(
+          'saveToDownloads', {'path': p, 'name': name, 'mime': p.endsWith('.txt') ? 'text/plain' : 'application/json'}))!);
+    }
+    return out;
+  }
+
+  Future<void> chainAcknowledge() async {
+    final st = await chainState();
+    if (st != null) {
+      st['acknowledged'] = true;
+      await _chainWrite(st);
+    }
+    Research.chainSummary.value = null;
+  }
 }
