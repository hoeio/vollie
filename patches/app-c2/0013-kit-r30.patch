+++ b/test/runtime_check_test.dart
@@ -0,0 +1,36 @@
+// Kit r30: the mapped-library check (Research.runtimeCheck) passes only on the active runtime's two files and hashes.
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:vollie/assistant.dart';
+
+void main() {
+  final build = jsonDecode(File('assets/kit_build.json').readAsStringSync()) as Map;
+  final rts = build['runtimes'] as Map;
+  Map<String, String?> mapped(String rt) => {
+        'libggml-base.so': 'x', 'libggml.so': 'y', 'libllama-common.so': 'z', 'libllamadart.so': 'w',
+        for (final k in ['llama', 'cpu']) (rts[rt][k] as Map)['file'] as String: (rts[rt][k] as Map)['sha256'] as String,
+      };
+
+  test('each runtime passes on its own files', () {
+    for (final rt in ['c2', 'c1', 'stock']) {
+      expect(Research.runtimeCheck(mapped(rt), build, rt)['ok'], true, reason: rt);
+    }
+  });
+  test('the wrong runtime, a changed hash, an extra module or a missing entry fail', () {
+    expect(Research.runtimeCheck(mapped('c2'), build, 'c1')['ok'], false);
+    expect(Research.runtimeCheck({...mapped('c1'), 'libllama_rt_c1.so': '0' * 64}, build, 'c1')['ok'], false);
+    expect(Research.runtimeCheck({...mapped('c1'), 'libggml-cpu-android_armv8.2_2.so': 'h'}, build, 'c1')['ok'], false);
+    expect(Research.runtimeCheck({...mapped('stock'), 'libllama.so': 'h'}, build, 'stock')['ok'], false);
+    expect(Research.runtimeCheck(mapped('c2'), const {}, 'c2')['ok'], false);
+  });
+  test('the R68 hashes', () {
+    expect((rts['c2']['llama'] as Map)['sha256'], startsWith('126bfb4f'));
+    expect((rts['c2']['cpu'] as Map)['sha256'], startsWith('6f1d859a'));
+    expect((rts['c1']['llama'] as Map)['sha256'], startsWith('f2f4f88a'));
+    expect((rts['c1']['cpu'] as Map)['sha256'], startsWith('53bfee45'));
+    expect((rts['stock']['llama'] as Map)['sha256'], startsWith('de2ccec7'));
+    expect((rts['stock']['cpu'] as Map)['sha256'], startsWith('604e0f69'));
+  });
+}
