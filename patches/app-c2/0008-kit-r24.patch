+  static const plateauFrom = Duration(seconds: 30);
+  static const plateauWindow = 2;
+  static const plateauEps = 0.01, plateauFall = 0.05;
+
+  /// The plateau test on the readings of one wait so far (pure, for the unit test).
+  static bool plateau(List<double> h) {
+    const k = plateauWindow;
+    if (h.length < 2 * k) return false;
+    final last = h.sublist(h.length - k).reduce(math.min);
+    final before = h.sublist(h.length - 2 * k, h.length - k).reduce(math.min);
+    return last >= before - plateauEps && h.reduce(math.max) - last >= plateauFall;
+  }
