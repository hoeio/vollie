+  /// Kit r24: system-wide swap and fault counters from /proc/vmstat (pages; pswpin = swap-ins, pgmajfault = major faults,
+  /// pgpgin = KB read from block devices, as the kernel counts them). Null if the file cannot be read.
+  static Map<String, int>? vmstat() {
+    try {
+      const keys = {'pswpin', 'pswpout', 'pgmajfault', 'pgpgin', 'pgpgout'};
+      final m = <String, int>{};
+      for (final l in File('/proc/vmstat').readAsLinesSync()) {
+        final f = l.split(' ');
+        if (f.length == 2 && keys.contains(f[0])) m[f[0]] = int.tryParse(f[1]) ?? -1;
+      }
+      return m.isEmpty ? null : m;
+    } catch (_) {
+      return null;
+    }
+  }
+
+  /// Kit r24: every /sys/class/thermal/thermal_zone*: its type and temperature (millidegrees as the kernel gives them),
+  /// or the error (the app's SELinux domain may deny it). Never throws.
+  static List<({String zone, String? type, int? temp, String? error})> thermalZones() {
+    final out = <({String zone, String? type, int? temp, String? error})>[];
+    try {
+      final d = Directory('/sys/class/thermal').listSync().where((e) => e.path.split('/').last.startsWith('thermal_zone'));
+      for (final e in d) {
+        final z = e.path.split('/').last;
+        String? type, err;
+        int? temp;
+        try {
+          type = File('${e.path}/type').readAsStringSync().trim();
+        } catch (x) {
+          err = 'type: $x';
+        }
+        try {
+          temp = int.tryParse(File('${e.path}/temp').readAsStringSync().trim());
+        } catch (x) {
+          err = '${err == null ? '' : '$err; '}temp: $x';
+        }
+        out.add((zone: z, type: type, temp: temp, error: err));
+      }
+      if (out.isEmpty) out.add((zone: '-', type: null, temp: null, error: 'no thermal_zone entries listed'));
+    } catch (x) {
+      out.add((zone: '-', type: null, temp: null, error: 'list: $x'));
+    }
+    return out;
+  }
+
+  /// The current temperature of each zone that was readable in [zones] ({zone: temp}); empty if none was.
+  static Map<String, int?> zoneTemps(List<({String zone, String? type, int? temp, String? error})> zones) {
+    final m = <String, int?>{};
+    for (final z in zones) {
+      if (z.temp == null) continue;
+      try {
+        m[z.zone] = int.tryParse(File('/sys/class/thermal/${z.zone}/temp').readAsStringSync().trim());
+      } catch (_) {
+        m[z.zone] = null;
+      }
+    }
+    return m;
+  }
+
