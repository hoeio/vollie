+  /// Kit r23: the kernel release (uname(2), struct utsname: six 65-byte fields, release is the third). Null off Android.
+  static String? unameRelease() {
+    final libc = _libc;
+    if (libc == null) return null;
+    final uname = libc.lookupFunction<Int32 Function(Pointer<Uint8>), int Function(Pointer<Uint8>)>('uname');
+    final free = libc.lookupFunction<Void Function(Pointer<Uint8>), void Function(Pointer<Uint8>)>('free');
+    final b = _malloc!(6 * 65);
+    try {
+      if (uname(b) != 0) return null;
+      final r = b.asTypedList(6 * 65).sublist(130, 195);
+      final end = r.indexOf(0);
+      return String.fromCharCodes(end < 0 ? r : r.sublist(0, end));
+    } finally {
+      free(b);
+    }
+  }
+
+  /// Kit r23: the CPU of each of this process's "DartWorker" threads that is running now (state R in
+  /// /proc/self/task/TID/stat, field 39). llama.cpp runs on those threads, and the ggml workers it starts inherit the
+  /// name and the affinity ([pinInferenceThreads]). Null when /proc/self/task cannot be read.
+  static List<int>? runningWorkerCpus() {
+    try {
+      final out = <int>[];
+      for (final t in Directory('/proc/self/task').listSync()) {
+        try {
+          if (!File('${t.path}/comm').readAsStringSync().startsWith('DartWorker')) continue;
+          final st = File('${t.path}/stat').readAsStringSync();
+          final f = st.substring(st.lastIndexOf(')') + 2).split(' '); // f[0] = field 3 (state)
+          if (f.length > 36 && f[0] == 'R') out.add(int.parse(f[36]));
+        } on FileSystemException {
+          // the thread exited mid-scan (ggml workers live for one graph)
+        }
+      }
+      return out;
+    } on FileSystemException {
+      return null;
+    }
+  }
